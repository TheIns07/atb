---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";

import {
  formatMXN,
  getActiveProducts,
  getProductStartingPrice,
  type Product,
} from "../../data/products";

const products =
  getActiveProducts().filter(
    (product) =>
      product.category ===
        "documentary-script" ||
      product.category ===
        "documentary-prop",
  );

function getPriceLabel(
  product: Product,
): string | null {
  if (
    product.status ===
    "coming-soon"
  ) {
    return null;
  }

  const price =
    getProductStartingPrice(
      product,
    );

  return price !== null
    ? formatMXN(price)
    : null;
}

function getProductMeta(
  product: Product,
): string {
  switch (
    product.category
  ) {
    case "shirt":
      return "ropa";

    case "documentary-script":
      return "guion original";

    case "documentary-prop":
      return "objeto de producción";

    default:
      return "objeto";
  }
}

function getInitialStatus(
  product: Product,
): string {
  if (
    product.status ===
    "coming-soon"
  ) {
    return "próximamente";
  }

  if (
    product.status ===
    "sold-out"
  ) {
    return "agotado";
  }

  return "comprobando…";
}
---

<Layout>
  <main
    class="shop-page"
    data-shop-page
  >
    <div class="shop-shell">

      <!-- =========================================
           HEADER
      ========================================== -->

      <header class="shop-header">
        <h1>
          Tienda
        </h1>
      </header>

      <!-- =========================================
           FLOATING GALLERY
      ========================================== -->

      <section
        class="floating-gallery"
        aria-label="Productos"
      >
        {
          products.map(
            (
              product,
              index,
            ) => {
              const priceLabel =
                getPriceLabel(
                  product,
                );

              const productMeta =
                getProductMeta(
                  product,
                );

              const initialStatus =
                getInitialStatus(
                  product,
                );

              const skus =
                product.variants
                  .filter(
                    (
                      variant,
                    ) =>
                      variant.active,
                  )
                  .map(
                    (
                      variant,
                    ) =>
                      variant.sku,
                  )
                  .join(",");

              const composition =
                (index %
                  6) +
                1;

              return (
              <article
                class:list={[
                  "product-piece",
                  `product-piece--${composition}`,
                  {
                    "is-sold-out":
                      product.status ===
                      "sold-out",

                    "product-piece--camcorder":
                      product.id ===
                      "documentary-camcorder",
                  },
                ]}
                data-shop-product-card
                data-product-status={
                  product.status
                }
                data-product-skus={
                  skus
                }
                data-product-name={
                  product.name
                }
              >
                  <a
                    href={`/tienda/${product.slug}`}
                    class="product-link"
                    aria-label={`Abrir ${product.name}`}
                  >
                    <div class="image-shell">

                      <!-- fallback -->

                      <div class="image-placeholder">
                        ATB
                      </div>

                      <!-- image -->

                      <img
                        src={
                          product.thumbnail
                        }
                        alt={
                          product.name
                        }
                        class="product-image"
                        data-product-image
                        loading={
                          index < 4
                            ? "eager"
                            : "lazy"
                        }
                      />

                      <!-- permanent sold-out badge -->

                      <span
                        class="status-badge"
                        data-product-status-overlay
                        hidden={
                          product.status !==
                          "sold-out"
                        }
                      >
                        agotado
                      </span>

                      <!-- hover information -->

                      <div class="product-hover">
                        <div class="hover-meta">
                          <span>
                            {productMeta}
                          </span>

                          <span
                            data-product-availability
                          >
                            {initialStatus}
                          </span>
                        </div>

                        <div class="hover-main">
                          <h2>
                            {product.name}
                          </h2>
                        </div>

                        {
                          priceLabel && (
                            <div class="hover-price">
                              {priceLabel}
                            </div>
                          )
                        }
                      </div>
                    </div>
                  </a>
                </article>
              );
            },
          )
        }
      </section>

      <!-- =========================================
           INVENTORY
      ========================================== -->

      <script>
        type InventoryItem = {
          stock: number;
          active: boolean;
          available: boolean;

          updatedAt?:
            | string
            | null;
        };

        type InventoryResponse = {
          inventoryBySku?: Record<
            string,
            InventoryItem
          >;

          error?: string;
        };

        function updateCardAvailability(
          card: HTMLElement,
          label: string,
          state:
            | "available"
            | "last-unit"
            | "sold-out"
            | "coming-soon"
            | "error",
        ): void {
          const availability =
            card.querySelectorAll<HTMLElement>(
              "[data-product-availability]",
            );

          const overlays =
            card.querySelectorAll<HTMLElement>(
              "[data-product-status-overlay]",
            );

          availability.forEach(
            (
              element,
            ) => {
              element.textContent =
                label;

              element.dataset.state =
                state;
            },
          );

          overlays.forEach(
            (
              overlay,
            ) => {
              overlay.hidden =
                state !==
                "sold-out";
            },
          );

          card.dataset
            .availabilityState =
            state;

          card.classList.toggle(
            "is-sold-out",
            state ===
              "sold-out",
          );
        }

        function getCardSkus(
          card: HTMLElement,
        ): string[] {
          const raw =
            card.dataset
              .productSkus ??
            "";

          return raw
            .split(",")
            .map(
              (
                sku,
              ) =>
                sku.trim(),
            )
            .filter(Boolean);
        }

        async function loadInventory(): Promise<void> {
          const page =
            document.querySelector<HTMLElement>(
              "[data-shop-page]",
            );

          if (
            !page
          ) {
            return;
          }

          if (
            page.dataset
              .inventoryInitialized ===
            "true"
          ) {
            return;
          }

          page.dataset
            .inventoryInitialized =
            "true";

          const cards =
            Array.from(
              page.querySelectorAll<HTMLElement>(
                "[data-shop-product-card]",
              ),
            );

          cards.forEach(
            (
              card,
            ) => {
              const status =
                card.dataset
                  .productStatus;

              if (
                status ===
                "coming-soon"
              ) {
                updateCardAvailability(
                  card,
                  "próximamente",
                  "coming-soon",
                );
              }

              if (
                status ===
                "sold-out"
              ) {
                updateCardAvailability(
                  card,
                  "agotado",
                  "sold-out",
                );
              }
            },
          );

          const skus =
            new Set<string>();

          cards.forEach(
            (
              card,
            ) => {
              if (
                card.dataset
                  .productStatus !==
                "available"
              ) {
                return;
              }

              getCardSkus(
                card,
              ).forEach(
                (
                  sku,
                ) => {
                  skus.add(
                    sku,
                  );
                },
              );
            },
          );

          if (
            skus.size ===
            0
          ) {
            return;
          }

          try {
            const params =
              new URLSearchParams();

            params.set(
              "skus",
              Array.from(
                skus,
              ).join(","),
            );

            const response =
              await fetch(
                `/api/inventory?${params.toString()}`,
                {
                  method:
                    "GET",

                  headers: {
                    Accept:
                      "application/json",
                  },

                  cache:
                    "no-store",
                },
              );

            const data =
              (await response.json()) as
                InventoryResponse;

            if (
              !response.ok
            ) {
              throw new Error(
                data.error ??
                  "No fue posible consultar inventario.",
              );
            }

            const inventory =
              data.inventoryBySku ??
              {};

            cards.forEach(
              (
                card,
              ) => {
                if (
                  card.dataset
                    .productStatus !==
                  "available"
                ) {
                  return;
                }

                const productSkus =
                  getCardSkus(
                    card,
                  );

                if (
                  productSkus.length ===
                  0
                ) {
                  updateCardAvailability(
                    card,
                    "no disponible",
                    "error",
                  );

                  return;
                }

                let totalStock =
                  0;

                let activeSkuCount =
                  0;

                productSkus.forEach(
                  (
                    sku,
                  ) => {
                    const item =
                      inventory[
                        sku
                      ];

                    if (
                      !item ||
                      !item.active
                    ) {
                      return;
                    }

                    activeSkuCount +=
                      1;

                    totalStock +=
                      Math.max(
                        0,
                        item.stock,
                      );
                  },
                );

                if (
                  totalStock <=
                  0
                ) {
                  updateCardAvailability(
                    card,
                    "agotado",
                    "sold-out",
                  );

                  return;
                }

                if (
                  totalStock ===
                  1
                ) {
                  updateCardAvailability(
                    card,
                    "última unidad",
                    "last-unit",
                  );

                  return;
                }

                if (
                  activeSkuCount >
                  0
                ) {
                  updateCardAvailability(
                    card,
                    "disponible",
                    "available",
                  );

                  return;
                }

                updateCardAvailability(
                  card,
                  "no disponible",
                  "error",
                );
              },
            );
          } catch (
            error
          ) {
            console.error(
              "[ATB Shop] Catalogue inventory error:",
              error,
            );

            cards.forEach(
              (
                card,
              ) => {
                if (
                  card.dataset
                    .productStatus !==
                  "available"
                ) {
                  return;
                }

                updateCardAvailability(
                  card,
                  "no disponible",
                  "error",
                );
              },
            );
          }
        }

        function initializeImages(): void {
          const images =
            document.querySelectorAll<HTMLImageElement>(
              "[data-product-image]",
            );

          images.forEach(
            (
              image,
            ) => {
              if (
                image.dataset
                  .fallbackInitialized ===
                "true"
              ) {
                return;
              }

              image.dataset
                .fallbackInitialized =
                "true";

              const handleError =
                (): void => {
                  image.style.display =
                    "none";
                };

              image.addEventListener(
                "error",
                handleError,
              );

              if (
                image.complete &&
                image.naturalWidth ===
                  0
              ) {
                handleError();
              }
            },
          );
        }

        function initializeShop(): void {
          void loadInventory();

          initializeImages();
        }

        initializeShop();

        document.addEventListener(
          "astro:page-load",
          initializeShop,
        );
      </script>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ============================================================
     PAGE
  ============================================================ */

  .shop-page {
    min-height:
      100vh;

    padding:
      7rem
      0
      12rem;

    background:
      #ffffff;

    color:
      #111111;
  }

  :global(
    body:has(.shop-page)
  ) {
    background:
      #ffffff;

    scroll-snap-type:
      none !important;
  }

  .shop-shell {
    width:
      min(
        1500px,
        calc(
          100% - 5rem
        )
      );

    margin:
      0 auto;
  }

  /* ============================================================
     HEADER
  ============================================================ */

  .shop-header {
    display:
      flex;

    justify-content:
      space-between;

    align-items:
      flex-end;

    padding:
      2rem
      0
      9rem;
  }

  .shop-header h1 {
    margin:
      0;

    color:
      #111111;

    font-family:
      "Inter",
      sans-serif;

    font-size:
      clamp(
        5rem,
        10vw,
        11rem
      );

    font-weight:
      400;

    line-height:
      0.8;

    letter-spacing:
      -0.075em;
  }

  .shop-count {
    margin-bottom:
      0.5rem;

    color:
      #999999;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.5rem;

    letter-spacing:
      0.08em;
  }

  /* ============================================================
     FLOATING GALLERY
  ============================================================ */

  .floating-gallery {
    display:
      grid;

    grid-template-columns:
      repeat(
        12,
        minmax(
          0,
          1fr
        )
      );

    column-gap:
      1.5rem;

    row-gap:
      8rem;

    align-items:
      start;
  }

  .product-piece {
    min-width:
      0;
  }

  /* ============================================================
     ASYMMETRIC COMPOSITION
  ============================================================ */

  .product-piece--1 {
    grid-column:
      1 / 5;
  }

  .product-piece--2 {
    grid-column:
      6 / 10;

    margin-top:
      7rem;
  }

  .product-piece--3 {
    grid-column:
      10 / 13;

    margin-top:
      1.5rem;
  }

  .product-piece--4 {
    grid-column:
      2 / 6;

    margin-top:
      3rem;
  }

  .product-piece--5 {
    grid-column:
      7 / 12;

    margin-top:
      -1rem;
  }

  .product-piece--6 {
    grid-column:
      1 / 4;

    margin-top:
      5rem;
  }

  /* ============================================================
     LINK
  ============================================================ */

  .product-link {
    display:
      block;

    color:
      inherit;

    text-decoration:
      none;

    outline:
      none;
  }

  .product-link:focus-visible {
    outline:
      1px solid
      #777777;

    outline-offset:
      5px;
  }

  /* ============================================================
     IMAGE
  ============================================================ */

  .image-shell {
    position:
      relative;

    overflow:
      hidden;

    background:
      #f3f3f3;
  }

  .product-piece--1
    .image-shell {
    aspect-ratio:
      4 / 5;
  }

  .product-piece--2
    .image-shell {
    aspect-ratio:
      1 / 1.15;
  }

  .product-piece--3
    .image-shell {
    aspect-ratio:
      4 / 5.4;
  }

  .product-piece--4
    .image-shell {
    aspect-ratio:
      1 / 1.1;
  }

  .product-piece--5
    .image-shell {
    aspect-ratio:
      5 / 4;
  }

  .product-piece--6
    .image-shell {
    aspect-ratio:
      4 / 5;
  }

  /* ============================================================
   VIDEOGRABADORA
============================================================ */

.product-piece--camcorder
  .image-shell {
  aspect-ratio:
    16 / 9;
}

  .image-placeholder {
    position:
      absolute;

    inset:
      0;

    display:
      grid;

    place-items:
      center;

    color:
      #c1c1c1;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.52rem;

    letter-spacing:
      0.14em;
  }

  .product-image {
    position:
      relative;

    z-index:
      1;

    display:
      block;

    width:
      100%;

    height:
      100%;

    object-fit:
      cover;

    transition:
      transform
        700ms
        cubic-bezier(
          0.22,
          1,
          0.36,
          1
        ),
      filter
        500ms
        ease;
  }

  /* ============================================================
     SOLD OUT
  ============================================================ */

  .status-badge {
    position:
      absolute;

    z-index:
      4;

    top:
      0.8rem;

    right:
      0.8rem;

    padding:
      0.45rem
      0.55rem;

    background:
      rgba(
        255,
        255,
        255,
        0.95
      );

    color:
      #111111;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.47rem;

    letter-spacing:
      0.06em;

    text-transform:
      lowercase;
  }

  .status-badge[
    hidden
  ] {
    display:
      none;
  }

  .product-piece.is-sold-out
    .product-image {
    filter:
      grayscale(
        0.25
      );

    opacity:
      0.62;
  }

  /* ============================================================
     HOVER INFORMATION
  ============================================================ */

  .product-hover {
    position:
      absolute;

    z-index:
      3;

    right:
      0.75rem;

    bottom:
      0.75rem;

    left:
      0.75rem;

    padding:
      1rem
      1.05rem;

    background:
      rgba(
        255,
        255,
        255,
        0.96
      );

    backdrop-filter:
      blur(
        10px
      );

    opacity:
      0;

    transform:
      translateY(
        8px
      );

    transition:
      opacity
        300ms ease,
      transform
        400ms
        cubic-bezier(
          0.22,
          1,
          0.36,
          1
        );
  }

  .hover-meta {
    display:
      flex;

    justify-content:
      space-between;

    gap:
      1rem;

    margin-bottom:
      0.75rem;

    color:
      #838383;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.45rem;

    line-height:
      1.3;

    letter-spacing:
      0.05em;

    text-transform:
      lowercase;
  }

  .hover-main {
    display:
      grid;

    grid-template-columns:
      minmax(
        0,
        1fr
      )
      auto;

    gap:
      1rem;

    align-items:
      start;
  }

  .hover-main h2 {
    margin:
      0;

    color:
      #111111;

    font-family:
      "Inter",
      sans-serif;

    font-size:
      clamp(
        0.9rem,
        1.25vw,
        1.2rem
      );

    font-weight:
      500;

    line-height:
      1.2;

    letter-spacing:
      -0.025em;
  }

  .hover-arrow {
    color:
      #555555;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.65rem;
  }

  .hover-price {
    margin-top:
      1.1rem;

    padding-top:
      0.75rem;

    border-top:
      1px solid
      #dddddd;

    color:
      #333333;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.55rem;
  }

  /* ============================================================
     HOVER
  ============================================================ */

  @media (
    hover: hover
  ) and (
    pointer: fine
  ) {
    .product-link:hover
      .product-image {
      transform:
        scale(
          1.025
        );
    }

    .product-link:hover
      .product-hover,
    .product-link:focus-visible
      .product-hover {
      opacity:
        1;

      transform:
        translateY(
          0
        );
    }
  }

  /* ============================================================
     STATES
  ============================================================ */

  [data-product-availability][
    data-state="available"
  ] {
    color:
      #444444;
  }

  [data-product-availability][
    data-state="last-unit"
  ] {
    color:
      #222222;
  }

  [data-product-availability][
    data-state="sold-out"
  ],
  [data-product-availability][
    data-state="error"
  ] {
    color:
      #999999;
  }

  /* ============================================================
     TABLET
  ============================================================ */

  @media (
    max-width:
      1050px
  ) {
    .shop-shell {
      width:
        calc(
          100% - 2.5rem
        );
    }

    .floating-gallery {
      grid-template-columns:
        repeat(
          8,
          minmax(
            0,
            1fr
          )
        );

      row-gap:
        5rem;
    }

    .product-piece--1 {
      grid-column:
        1 / 5;
    }

    .product-piece--2 {
      grid-column:
        5 / 9;

      margin-top:
        4rem;
    }

    .product-piece--3 {
      grid-column:
        2 / 5;

      margin-top:
        0;
    }

    .product-piece--4 {
      grid-column:
        5 / 9;

      margin-top:
        3rem;
    }

    .product-piece--5 {
      grid-column:
        1 / 6;

      margin-top:
        0;
    }

    .product-piece--6 {
      grid-column:
        6 / 9;

      margin-top:
        4rem;
    }
  }

  /* ============================================================
     MOBILE
  ============================================================ */

  @media (
    max-width:
      700px
  ) {
    .shop-page {
      padding:
        5rem
        0
        7rem;
    }

    .shop-shell {
      width:
        calc(
          100% - 1.5rem
        );
    }

    .shop-header {
      padding:
        2rem
        0
        5rem;
    }

    .shop-header h1 {
      font-size:
        22vw;
    }

    .floating-gallery {
      grid-template-columns:
        repeat(
          2,
          minmax(
            0,
            1fr
          )
        );

      gap:
        3.5rem
        0.85rem;
    }

    .product-piece,
    .product-piece--1,
    .product-piece--2,
    .product-piece--3,
    .product-piece--4,
    .product-piece--5,
    .product-piece--6 {
      grid-column:
        auto;

      margin-top:
        0;
    }

    .product-piece--camcorder
      .image-shell {
      aspect-ratio: 
        16 / 9;
    }

    .product-piece:nth-child(
      3n + 2
    ) {
      transform:
        translateY(
          2.5rem
        );
    }

    .product-piece--1
      .image-shell,
    .product-piece--2
      .image-shell,
    .product-piece--3
      .image-shell,
    .product-piece--4
      .image-shell,
    .product-piece--5
      .image-shell,
    .product-piece--6
      .image-shell {
      aspect-ratio:
        4 / 5;
    }

    /*
      En móvil la información deja de
      ser hover y forma parte de la pieza.
    */

    .image-shell {
      overflow:
        visible;
    }

    .product-hover {
      position:
        relative;

      right:
        auto;

      bottom:
        auto;

      left:
        auto;

      margin-top:
        0.8rem;

      padding:
        0;

      background:
        transparent;

      backdrop-filter:
        none;

      opacity:
        1;

      transform:
        none;
    }

    .hover-meta {
      margin-bottom:
        0.5rem;

      font-size:
        0.42rem;
    }

    .hover-main h2 {
      font-size:
        0.82rem;

      line-height:
        1.3;
    }

    .hover-arrow {
      font-size:
        0.55rem;
    }

    .hover-price {
      margin-top:
        0.7rem;

      padding-top:
        0;

      border-top:
        0;

      font-size:
