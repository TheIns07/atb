---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";

import {
  formatMXN,
  getActiveProducts,
  getProductStartingPrice,
  type Product,
} from "../../data/products";

// ============================================================
// STATIC PATHS
// ============================================================

export function getStaticPaths() {
  return getActiveProducts().map((product) => ({
    params: {
      slug: product.slug,
    },

    props: {
      product,
    },
  }));
}

// ============================================================
// PROPS
// ============================================================

interface Props {
  product: Product;
}

const {
  product,
} = Astro.props;

// ============================================================
// PRODUCT TYPE
// ============================================================

const isShirt =
  product.category ===
  "shirt";

const isScript =
  product.category ===
  "documentary-script";

const isProp =
  product.category ===
  "documentary-prop";

const isCamcorder =
  product.slug ===
  "videograbadora-documental";

const isUnique =
  product.inventoryMode ===
    "single-item" ||
  product.documentaryInfo
    ?.uniquePiece ===
    true;

// ============================================================
// INITIAL VARIANT
// ============================================================

const initialVariant =
  product.variants.find(
    (variant) =>
      variant.active,
  ) ??
  product.variants[0];

// ============================================================
// PRICE
// ============================================================

const startingPrice =
  getProductStartingPrice(
    product,
  );

const initialPriceLabel =
  startingPrice !== null
    ? formatMXN(
        startingPrice,
      )
    : "Próximamente";

// ============================================================
// CATEGORY
// ============================================================

function getCategoryLabel(): string {
  if (isShirt) {
    return "Ropa";
  }

  if (isScript) {
    return "Guión original";
  }

  if (isProp) {
    return "Objeto de producción";
  }

  return "";
}

const categoryLabel =
  getCategoryLabel();

// ============================================================
// IMAGES
// ============================================================

const productImages =
  Array.from(
    new Set([
      product.thumbnail,
      ...product.images,
    ]),
  ).filter(Boolean);

const firstImage =
  productImages[0] ??
  product.thumbnail;

// ============================================================
// INITIAL SELECTION
// ============================================================

const initialColorId =
  initialVariant
    ?.colorId ??
  product.colors?.[0]?.id ??
  "";

const initialSize =
  initialVariant
    ?.size ??
  product.sizes?.[0] ??
  "";
---

<Layout>
  <main
    class:list={[
      "product-page",
      {
        "product-page--camcorder":
          isCamcorder,
      },
    ]}
    data-product-page
    data-product-status={product.status}
    data-product-name={product.name}
  >
    <!-- ======================================================
         BACK
    ======================================================= -->

    <div class="product-topbar">
      <a
        href="/tienda"
        class="back-link"
      >
        ← Tienda
      </a>
    </div>

    <!-- ======================================================
         PRODUCT
    ======================================================= -->

    <div class="product-layout">

      <!-- ====================================================
           GALLERY
      ===================================================== -->

      <section
        class="product-gallery"
        aria-label={`Imágenes de ${product.name}`}
      >
        <div class="main-image-wrapper">
          <div class="image-placeholder">
            ATB
          </div>

          <img
            id="product-main-image"
            class="main-image"
            src={firstImage}
            alt={product.name}
            data-product-main-image
          />
        </div>

        {
          productImages.length > 1 && (
            <div
              class="thumbnail-grid"
              aria-label="Seleccionar imagen"
            >
              {
                productImages.map(
                  (
                    image,
                    index,
                  ) => (
                    <button
                      type="button"
                      class:list={[
                        "thumbnail-button",
                        {
                          "is-active":
                            index === 0,
                        },
                      ]}
                      data-product-thumbnail
                      data-image-src={image}
                      aria-label={`Ver imagen ${index + 1}`}
                    >
                      <span class="thumbnail-placeholder">
                        ATB
                      </span>

                      <img
                        src={image}
                        alt=""
                        loading="lazy"
                        data-product-image
                      />
                    </button>
                  ),
                )
              }
            </div>
          )
        }
      </section>

      <!-- ====================================================
           INFORMATION
      ===================================================== -->

      <section class="product-information">

        <div class="product-information-inner">

          <!-- ================================================
               META
          ================================================= -->

          <div class="product-meta">
            <span>
              {categoryLabel}
            </span>

            {
              product.collection && (
                <span>
                  {product.collection}
                </span>
              )
            }
          </div>

          <!-- ================================================
               TITLE
          ================================================= -->

          <h1>
            {product.name}
          </h1>

          {
            product.subtitle && (
              <p class="product-subtitle">
                {product.subtitle}
              </p>
            )
          }

          <!-- ================================================
               PRICE + AVAILABILITY
          ================================================= -->

          <div class="product-commerce-header">
            <p
              id="product-price"
              class="product-price"
            >
              {initialPriceLabel}
            </p>

            <p
              id="product-availability"
              class="product-availability"
              aria-live="polite"
            >
              {
                product.status ===
                "coming-soon"
                  ? "Próximamente"
                  : product.status ===
                      "sold-out"
                    ? "Agotado"
                    : "Comprobando disponibilidad…"
              }
            </p>
          </div>

          <!-- ================================================
               DESCRIPTION
          ================================================= -->

          <p class="product-description">
            {product.description}
          </p>

          <!-- ================================================
               COLORS
          ================================================= -->

          {
            isShirt &&
            product.colors &&
            product.colors.length >
              0 && (
              <div class="option-section">
                <div class="option-heading">
                  <span>
                    Color
                  </span>

                  <span
                    id="selected-color-label"
                    class="selected-option"
                  >
                    {
                      product.colors.find(
                        (color) =>
                          color.id ===
                          initialColorId,
                      )?.name
                    }
                  </span>
                </div>

                <div
                  class="color-options"
                  role="group"
                  aria-label="Color"
                >
                  {
                    product.colors.map(
                      (color) => (
                        <button
                          type="button"
                          class:list={[
                            "color-option",
                            {
                              "is-selected":
                                color.id ===
                                initialColorId,
                            },
                          ]}
                          data-color-option
                          data-color-id={color.id}
                          data-color-name={color.name}
                          aria-pressed={
                            color.id ===
                            initialColorId
                          }
                          aria-label={color.name}
                        >
                          <span
                            class="color-swatch"
                            style={`background:${color.hex}`}
                          />

                          <span>
                            {color.name}
                          </span>
                        </button>
                      ),
                    )
                  }
                </div>
              </div>
            )
          }

          <!-- ================================================
               SIZES
          ================================================= -->

          {
            isShirt &&
            product.sizes &&
            product.sizes.length >
              0 && (
              <div class="option-section">
                <div class="option-heading">
                  <span>
                    Talla
                  </span>

                  <span
                    id="selected-size-label"
                    class="selected-option"
                  >
                    {initialSize}
                  </span>
                </div>

                <div
                  class="size-options"
                  role="group"
                  aria-label="Talla"
                >
                  {
                    product.sizes.map(
                      (size) => (
                        <button
                          type="button"
                          class:list={[
                            "size-option",
                            {
                              "is-selected":
                                size ===
                                initialSize,
                            },
                          ]}
                          data-size-option
                          data-size={size}
                          aria-pressed={
                            size ===
                            initialSize
                          }
                        >
                          {size}
                        </button>
                      ),
                    )
                  }
                </div>
              </div>
            )
          }

          <!-- ================================================
               PURCHASE
          ================================================= -->

          <div class="purchase-area">
            <button
              id="product-add-button"
              class="add-button"
              type="button"
              disabled
            >
              {
                product.status ===
                  "coming-soon"
                  ? "Próximamente"
                  : product.status ===
                      "sold-out"
                    ? "Agotado"
                    : "Comprobando disponibilidad…"
              }
            </button>

            <p
              id="product-message"
              class="product-message"
              aria-live="polite"
            ></p>
          </div>

          <!-- ================================================
               DETAILS
          ================================================= -->

          <div class="product-details">
            {
              product.documentaryInfo
                ?.usedInProduction && (
                <div class="detail-row">
                  <span>
                    Procedencia
                  </span>

                  <span>
                    Utilizado en producción
                  </span>
                </div>
              )
            }

            {
              product.documentaryInfo
                ?.uniquePiece && (
                <div class="detail-row">
                  <span>
                    Edición
                  </span>

                  <span>
                    Pieza única
                  </span>
                </div>
              )
            }

            <div class="detail-row">
              <span>
                Disponibilidad
              </span>

              <span
                id="product-detail-availability"
              >
                Comprobando…
              </span>
            </div>
          </div>

          <!-- ================================================
               STORY
          ================================================= -->

          {
            product.story && (
              <div class="product-story">
                <p class="story-label">
                  Sobre la pieza
                </p>

                <p>
                  {product.story}
                </p>
              </div>
            )
          }
        </div>
      </section>
    </div>

    <!-- ======================================================
         VARIANT DATA
    ======================================================= -->

    <script
      is:inline
      id="product-variant-data"
      type="application/json"
      set:html={JSON.stringify(product.variants)}
    ></script>

    <!-- ======================================================
         CLIENT
    ======================================================= -->

    <script>
      import {
        addToCart,
        getCart,
      } from "../../lib/shop/cart";

      import {
        formatMXN,
      } from "../../data/products";

      // ======================================================
      // TYPES
      // ======================================================

      type ClientVariant = {
        sku: string;

        colorId?: string;

        size?: string;

        price:
          | number
          | null;

        stock: number;

        active: boolean;
      };

      type InventoryItem = {
        stock: number;

        active: boolean;

        available: boolean;

        updatedAt?:
          | string
          | null;
      };

      type InventoryResponse = {
        inventoryBySku?: Record<
          string,
          InventoryItem
        >;

        missingSkus?: string[];

        error?: string;
      };

      // ======================================================
      // INITIALIZE
      // ======================================================

      function initializeProductPage(): void {
        const page =
          document.querySelector<HTMLElement>(
            "[data-product-page]",
          );

        if (!page) {
          return;
        }

        if (
          page.dataset
            .productInitialized ===
          "true"
        ) {
          return;
        }

        page.dataset
          .productInitialized =
          "true";

        // ====================================================
        // ELEMENTS
        // ====================================================

        const variantData =
          document.querySelector<HTMLScriptElement>(
            "#product-variant-data",
          );

        const purchaseButton =
          document.querySelector<HTMLButtonElement>(
            "#product-add-button",
          );

        const priceElement =
          document.querySelector<HTMLElement>(
            "#product-price",
          );

        const availabilityElement =
          document.querySelector<HTMLElement>(
            "#product-availability",
          );

        const detailAvailability =
          document.querySelector<HTMLElement>(
            "#product-detail-availability",
          );

        const messageElement =
          document.querySelector<HTMLElement>(
            "#product-message",
          );

        const mainImage =
          document.querySelector<HTMLImageElement>(
            "#product-main-image",
          );

        const selectedColorLabel =
          document.querySelector<HTMLElement>(
            "#selected-color-label",
          );

        const selectedSizeLabel =
          document.querySelector<HTMLElement>(
            "#selected-size-label",
          );

        if (
          !variantData ||
          !purchaseButton ||
          !priceElement ||
          !availabilityElement ||
          !detailAvailability ||
          !messageElement
        ) {
          return;
        }

        // ====================================================
        // PRODUCT DATA
        // ====================================================

        const productStatus =
          page.dataset.productStatus ??
          "";

        const productName =
          page.dataset.productName ??
          "Producto";

        let variants:
          ClientVariant[];

        try {
          variants =
            JSON.parse(
              variantData.textContent ??
                "[]",
            ) as
              ClientVariant[];
        } catch {
          variants =
            [];
        }

        if (
          variants.length ===
          0
        ) {
          purchaseButton.disabled =
            true;

          purchaseButton.textContent =
            "No disponible";

          availabilityElement.textContent =
            "No disponible";

          detailAvailability.textContent =
            "No disponible";

          return;
        }

        // ====================================================
        // STATE
        // ====================================================

        let inventory:
          Record<
            string,
            InventoryItem
          > = {};

        let inventoryLoaded =
          false;

        let selectedColorId =
          document
            .querySelector<HTMLButtonElement>(
              "[data-color-option].is-selected",
            )
            ?.dataset
            .colorId ??
          variants.find(
            (variant) =>
              variant.colorId,
          )?.colorId ??
          "";

        let selectedSize =
          document
            .querySelector<HTMLButtonElement>(
              "[data-size-option].is-selected",
            )
            ?.dataset
            .size ??
          variants.find(
            (variant) =>
              variant.size,
          )?.size ??
          "";

        // ====================================================
        // HELPERS
        // ====================================================

        function setMessage(
          message: string,
          error = false,
        ): void {
          messageElement.textContent =
            message;

          messageElement.classList.toggle(
            "is-error",
            error,
          );
        }

        function getVariantInventory(
          variant:
            ClientVariant,
        ):
          | InventoryItem
          | undefined {
          return inventory[
            variant.sku
          ];
        }

        function isVariantAvailable(
          variant:
            ClientVariant,
        ): boolean {
          if (
            !inventoryLoaded
          ) {
            return false;
          }

          const item =
            getVariantInventory(
              variant,
            );

          return Boolean(
            variant.active &&
            item &&
            item.active &&
            item.stock >
              0,
          );
        }

        function getSelectedVariant():
          | ClientVariant
          | undefined {
          return variants.find(
            (variant) => {
              if (
                !variant.active
              ) {
                return false;
              }

              if (
                variant.colorId &&
                variant.colorId !==
                  selectedColorId
              ) {
                return false;
              }

              if (
                variant.size &&
                variant.size !==
                  selectedSize
              ) {
                return false;
              }

              return true;
            },
          );
        }

        function getFirstAvailableVariant():
          | ClientVariant
          | undefined {
          return variants.find(
            (
              variant,
            ) =>
              isVariantAvailable(
                variant,
              ),
          );
        }

        function colorHasStock(
          colorId:
            string,
        ): boolean {
          return variants.some(
            (variant) =>
              variant.colorId ===
                colorId &&
              isVariantAvailable(
                variant,
              ),
          );
        }

        function sizeHasStock(
          size:
            string,
        ): boolean {
          return variants.some(
            (variant) =>
              (!variant.colorId ||
                variant.colorId ===
                  selectedColorId) &&
              variant.size ===
                size &&
              isVariantAvailable(
                variant,
              ),
          );
        }

        function getTotalAvailableStock():
          number {
          return variants.reduce(
            (
              total,
              variant,
            ) => {
              const item =
                getVariantInventory(
                  variant,
                );

              if (
                !item ||
                !item.active
              ) {
                return total;
              }

              return (
                total +
                Math.max(
                  0,
                  item.stock,
                )
              );
            },
            0,
          );
        }

        // ====================================================
        // SET SELECTION
        // ====================================================

        function setColor(
          colorId:
            string,
        ): void {
          selectedColorId =
            colorId;

          document
            .querySelectorAll<HTMLButtonElement>(
              "[data-color-option]",
            )
            .forEach(
              (
                button,
              ) => {
                const selected =
                  button.dataset
                    .colorId ===
                  colorId;

                button.classList.toggle(
                  "is-selected",
                  selected,
                );

                button.setAttribute(
                  "aria-pressed",
                  String(
                    selected,
                  ),
                );

                if (
                  selected &&
                  selectedColorLabel
                ) {
                  selectedColorLabel.textContent =
                    button.dataset
                      .colorName ??
                    "";
                }
              },
            );
        }

        function setSize(
          size:
            string,
        ): void {
          selectedSize =
            size;

          document
            .querySelectorAll<HTMLButtonElement>(
              "[data-size-option]",
            )
            .forEach(
              (
                button,
              ) => {
                const selected =
                  button.dataset
                    .size ===
                  size;

                button.classList.toggle(
                  "is-selected",
                  selected,
                );

                button.setAttribute(
                  "aria-pressed",
                  String(
                    selected,
                  ),
                );
              },
            );

          if (
            selectedSizeLabel
          ) {
            selectedSizeLabel.textContent =
              size;
          }
        }

        function selectVariant(
          variant:
            ClientVariant,
        ): void {
          if (
            variant.colorId
          ) {
            setColor(
              variant.colorId,
            );
          }

          if (
            variant.size
          ) {
            setSize(
              variant.size,
            );
          }
        }

        // ====================================================
        // OPTIONS
        // ====================================================

        function updateOptionStates(): void {
          // COLOR

          document
            .querySelectorAll<HTMLButtonElement>(
              "[data-color-option]",
            )
            .forEach(
              (
                button,
              ) => {
                const colorId =
                  button.dataset
                    .colorId;

                if (
                  !colorId
                ) {
                  return;
                }

                const hasStock =
                  colorHasStock(
                    colorId,
                  );

                button.disabled =
                  inventoryLoaded &&
                  !hasStock;

                button.classList.toggle(
                  "is-unavailable",
                  inventoryLoaded &&
                    !hasStock,
                );
              },
            );

          // SIZE

          document
            .querySelectorAll<HTMLButtonElement>(
              "[data-size-option]",
            )
            .forEach(
              (
                button,
              ) => {
                const size =
                  button.dataset
                    .size;

                if (!size) {
                  return;
                }

                const hasStock =
                  sizeHasStock(
                    size,
                  );

                button.disabled =
                  inventoryLoaded &&
                  !hasStock;

                button.classList.toggle(
                  "is-unavailable",
                  inventoryLoaded &&
                    !hasStock,
                );
              },
            );
        }

        // ====================================================
        // ENSURE VALID SELECTION
        // ====================================================

        function ensureAvailableSelection(): void {
          if (
            !inventoryLoaded
          ) {
            return;
          }

          const current =
            getSelectedVariant();

          if (
            current &&
            isVariantAvailable(
              current,
            )
          ) {
            return;
          }

          /*
            Primero intentamos conservar
            el color seleccionado.
          */

          const sameColorVariant =
            variants.find(
              (
                variant,
              ) =>
                (
                  !variant.colorId ||
                  variant.colorId ===
                    selectedColorId
                ) &&
                isVariantAvailable(
                  variant,
                ),
            );

          if (
            sameColorVariant
          ) {
            selectVariant(
              sameColorVariant,
            );

            return;
          }

          /*
            Si ese color ya no tiene ninguna
            talla disponible, elegimos la
            primera variante disponible.
          */

          const firstAvailable =
            getFirstAvailableVariant();

          if (
            firstAvailable
          ) {
            selectVariant(
              firstAvailable,
            );
          }
        }

        // ====================================================
        // UI
        // ====================================================

        function updateProductUI(): void {
          setMessage(
            "",
          );

          // ==================================================
          // PRODUCT STATUS
          // ==================================================

          if (
            productStatus ===
            "coming-soon"
          ) {
            purchaseButton.disabled =
              true;

            purchaseButton.textContent =
              "Próximamente";

            availabilityElement.textContent =
              "Próximamente";

            detailAvailability.textContent =
              "Próximamente";

            return;
          }

          if (
            productStatus ===
            "sold-out"
          ) {
            purchaseButton.disabled =
              true;

            purchaseButton.textContent =
              "Agotado";

            availabilityElement.textContent =
              "Agotado";

            detailAvailability.textContent =
              "Agotado";

            return;
          }

          // ==================================================
          // INVENTORY LOADING
          // ==================================================

          if (
            !inventoryLoaded
          ) {
            purchaseButton.disabled =
              true;

            purchaseButton.textContent =
              "Comprobando disponibilidad…";

            availabilityElement.textContent =
              "Comprobando disponibilidad…";

            detailAvailability.textContent =
              "Comprobando…";

            return;
          }

          // ==================================================
          // PRODUCT SOLD OUT
          // ==================================================

          const totalAvailable =
            getTotalAvailableStock();

          if (
            totalAvailable <=
            0
          ) {
            purchaseButton.disabled =
              true;

            purchaseButton.textContent =
              "Agotado";

            availabilityElement.textContent =
              "Agotado";

            detailAvailability.textContent =
              "Agotado";

            return;
          }

          // ==================================================
          // SELECTED VARIANT
          // ==================================================

          const variant =
            getSelectedVariant();

          if (!variant) {
            purchaseButton.disabled =
              true;

            purchaseButton.textContent =
              "Selecciona una variante";

            availabilityElement.textContent =
              "Selecciona una variante";

            detailAvailability.textContent =
              "Disponible";

            return;
          }

          // ==================================================
          // PRICE
          // ==================================================

          if (
            variant.price !==
            null
          ) {
            priceElement.textContent =
              formatMXN(
                variant.price,
              );
          } else {
            priceElement.textContent =
              "Próximamente";

            purchaseButton.disabled =
              true;

            purchaseButton.textContent =
              "Próximamente";

            return;
          }

          // ==================================================
          // VARIANT INVENTORY
          // ==================================================

          const variantInventory =
            getVariantInventory(
              variant,
            );

          if (
            !variantInventory ||
            !variantInventory.active ||
            variantInventory.stock <=
              0
          ) {
            purchaseButton.disabled =
              true;

            purchaseButton.textContent =
              "Agotado";

            availabilityElement.textContent =
              "Agotado en esta variante";

            detailAvailability.textContent =
              "Agotado";

            return;
          }

          // ==================================================
          // AVAILABLE
          // ==================================================

          purchaseButton.disabled =
            false;

          purchaseButton.textContent =
            "Agregar a la bolsa";

          purchaseButton.dataset.sku =
            variant.sku;

          if (
            variantInventory.stock ===
            1
          ) {
            availabilityElement.textContent =
              "Última unidad";

            detailAvailability.textContent =
              "1 disponible";
          } else {
            availabilityElement.textContent =
              `${variantInventory.stock} disponibles`;

            detailAvailability.textContent =
              `${variantInventory.stock} disponibles`;
          }
        }

        function refreshUI(): void {
          updateOptionStates();

          ensureAvailableSelection();

          updateOptionStates();

          updateProductUI();
        }

        // ====================================================
        // INVENTORY
        // ====================================================

        async function loadInventory(): Promise<void> {
          /*
            Si todavía no está a la venta
            no necesitamos consultar inventario.
          */

          if (
            productStatus !==
            "available"
          ) {
            inventoryLoaded =
              true;

            refreshUI();

            return;
          }

          const skus =
            variants
              .filter(
                (
                  variant,
                ) =>
                  variant.active,
              )
              .map(
                (
                  variant,
                ) =>
                  variant.sku,
              );

          if (
            skus.length ===
            0
          ) {
            inventoryLoaded =
              true;

            refreshUI();

            return;
          }

          const params =
            new URLSearchParams();

          params.set(
            "skus",
            skus.join(
              ",",
            ),
          );

          try {
            const response =
              await fetch(
                `/api/inventory?${params.toString()}`,
                {
                  method:
                    "GET",

                  headers: {
                    Accept:
                      "application/json",
                  },

                  cache:
                    "no-store",
                },
              );

            const data =
              (await response.json()) as
                InventoryResponse;

            if (
              !response.ok
            ) {
              throw new Error(
                data.error ??
                  "No fue posible consultar el inventario.",
              );
            }

            inventory =
              data.inventoryBySku ??
              {};

            /*
              Cualquier SKU faltante se considera
              no disponible deliberadamente.
            */

            for (
              const sku
              of data.missingSkus ??
              []
            ) {
              inventory[
                sku
              ] = {
                stock:
                  0,

                active:
                  false,

                available:
                  false,
              };
            }

            inventoryLoaded =
              true;

            refreshUI();
          } catch (
            error
          ) {
            console.error(
              "[ATB Shop] Inventory error:",
              error,
            );

            inventoryLoaded =
              false;

            purchaseButton.disabled =
              true;

            purchaseButton.textContent =
              "No disponible";

            availabilityElement.textContent =
              "No pudimos verificar existencias";

            detailAvailability.textContent =
              "No disponible";

            setMessage(
              "No pudimos verificar el inventario. Recarga la página e intenta de nuevo.",
              true,
            );
          }
        }

        // ====================================================
        // COLOR EVENTS
        // ====================================================

        document
          .querySelectorAll<HTMLButtonElement>(
            "[data-color-option]",
          )
          .forEach(
            (
              button,
            ) => {
              button.addEventListener(
                "click",
                () => {
                  if (
                    button.disabled
                  ) {
                    return;
                  }

                  const colorId =
                    button.dataset
                      .colorId;

                  if (!colorId) {
                    return;
                  }

                  setColor(
                    colorId,
                  );

                  /*
                    Si la talla actual no existe
                    para el nuevo color, elegimos
                    una disponible.
                  */

                  const current =
                    getSelectedVariant();

                  if (
                    !current ||
                    !isVariantAvailable(
                      current,
                    )
                  ) {
                    const replacement =
                      variants.find(
                        (
                          variant,
                        ) =>
                          variant.colorId ===
                            colorId &&
                          isVariantAvailable(
                            variant,
                          ),
                      );

                    if (
                      replacement?.size
                    ) {
                      setSize(
                        replacement.size,
                      );
                    }
                  }

                  refreshUI();
                },
              );
            },
          );

        // ====================================================
        // SIZE EVENTS
        // ====================================================

        document
          .querySelectorAll<HTMLButtonElement>(
            "[data-size-option]",
          )
          .forEach(
            (
              button,
            ) => {
              button.addEventListener(
                "click",
                () => {
                  if (
                    button.disabled
                  ) {
                    return;
                  }

                  const size =
                    button.dataset
                      .size;

                  if (!size) {
                    return;
                  }

                  setSize(
                    size,
                  );

                  refreshUI();
                },
              );
            },
          );

        // ====================================================
        // ADD TO CART
        // ====================================================

        purchaseButton.addEventListener(
          "click",
          () => {
            if (
              purchaseButton.disabled
            ) {
              return;
            }

            const variant =
              getSelectedVariant();

            if (!variant) {
              return;
            }

            const variantInventory =
              getVariantInventory(
                variant,
              );

            if (
              !variantInventory ||
              !variantInventory.active ||
              variantInventory.stock <=
                0
            ) {
              refreshUI();

              return;
            }

            /*
              Evitamos agregar al carrito local
              más unidades de las que Supabase
              reporta actualmente.
            */

            const cart =
              getCart();

            const existingItem =
              cart.items.find(
                (
                  item,
                ) =>
                  item.sku ===
                  variant.sku,
              );

            const existingQuantity =
              existingItem
                ?.quantity ??
              0;

            if (
              existingQuantity >=
              variantInventory.stock
            ) {
              setMessage(
                variantInventory.stock ===
                  1
                  ? `Sólo queda 1 unidad disponible de ${productName}.`
                  : `Sólo quedan ${variantInventory.stock} unidades disponibles de ${productName}.`,
                true,
              );

              return;
            }

            const added =
              addToCart(
                variant.sku,
                1,
              );

            if (!added) {
              setMessage(
                "No fue posible agregar este producto a la bolsa.",
                true,
              );

              return;
            }

            setMessage(
              "Agregado a la bolsa.",
            );

            window.dispatchEvent(
              new CustomEvent(
                "atb:cart-open",
              ),
            );
          },
        );

        // ====================================================
        // GALLERY
        // ====================================================

        document
          .querySelectorAll<HTMLButtonElement>(
            "[data-product-thumbnail]",
          )
          .forEach(
            (
              button,
            ) => {
              button.addEventListener(
                "click",
                () => {
                  const source =
                    button.dataset
                      .imageSrc;

                  if (
                    !source ||
                    !mainImage
                  ) {
                    return;
                  }

                  mainImage.src =
                    source;

                  document
                    .querySelectorAll<HTMLButtonElement>(
                      "[data-product-thumbnail]",
                    )
                    .forEach(
                      (
                        candidate,
                      ) => {
                        candidate.classList.toggle(
                          "is-active",
                          candidate ===
                            button,
                        );
                      },
                    );
                },
              );
            },
          );

        // ====================================================
        // IMAGE FALLBACK
        // ====================================================

        const images =
          document.querySelectorAll<HTMLImageElement>(
            "[data-product-main-image], [data-product-image]",
          );

        images.forEach(
          (
            image,
          ) => {
            const handleError =
              () => {
                image.style.display =
                  "none";
              };

            image.addEventListener(
              "error",
              handleError,
            );

            if (
              image.complete &&
              image.naturalWidth ===
                0
            ) {
              handleError();
            }
          },
        );

        // ====================================================
        // START
        // ====================================================

        updateProductUI();

        void loadInventory();
      }

      initializeProductPage();

      document.addEventListener(
        "astro:page-load",
        initializeProductPage,
      );
    </script>
  </main>

  <Footer />
</Layout>

