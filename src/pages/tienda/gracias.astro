---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
---

<Layout>
  <main
    class="success-page"
    data-success-page
  >
    <div class="success-container">
      <div class="success-content">

        <p class="success-label">
          ATB SHOP
        </p>

        <h1 data-success-title>
          Confirmando tu compra.
        </h1>

        <p
          class="success-description"
          data-success-description
        >
          Estamos verificando que tu pedido haya quedado
          registrado correctamente.
        </p>

        <!-- ==================================================
             STATUS
        =================================================== -->

        <div
          class="success-status"
          data-success-status
          data-state="loading"
          aria-live="polite"
        >
          <span
            class="status-indicator is-loading"
            data-status-indicator
            aria-hidden="true"
          ></span>

          <p data-status-message>
            Confirmando pedido…
          </p>
        </div>

        <!-- ==================================================
             ORDER SUMMARY
        =================================================== -->

        <section
          class="order-summary"
          data-order-summary
          hidden
        >
          <!-- ================================================
               PRIMARY DATA
          ================================================= -->

          <div class="order-meta">
            <div class="order-meta-item">
              <span class="order-meta-label">
                Pedido
              </span>

              <strong data-order-reference>
                —
              </strong>
            </div>

            <div class="order-meta-item">
              <span class="order-meta-label">
                Estado
              </span>

              <strong data-order-status>
                —
              </strong>
            </div>

            <div
              class="order-meta-item"
              data-email-container
              hidden
            >
              <span class="order-meta-label">
                Confirmación
              </span>

              <strong data-order-email>
                —
              </strong>
            </div>
          </div>

          <!-- ================================================
               ITEMS
          ================================================= -->

          <div
            class="order-items"
            data-order-items
          ></div>

          <!-- ================================================
               TOTALS
          ================================================= -->

          <div class="order-totals">
            <div class="order-total-row">
              <span>
                Subtotal
              </span>

              <strong data-order-subtotal>
                —
              </strong>
            </div>

            <div class="order-total-row">
              <span data-shipping-label>
                Envío
              </span>

              <strong data-order-shipping>
                —
              </strong>
            </div>

            <div class="order-total-row total">
              <span>
                Total
              </span>

              <strong data-order-total>
                —
              </strong>
            </div>
          </div>

          <!-- ================================================
               SHIPPING
          ================================================= -->

          <div class="shipping-summary">
            <div>
              <span class="shipping-label">
                Método de envío
              </span>

              <strong data-shipping-method>
                —
              </strong>
            </div>

            <div>
              <span class="shipping-label">
                Estado
              </span>

              <strong data-shipping-status>
                —
              </strong>
            </div>
          </div>
        </section>

        <!-- ==================================================
             FALLBACK STRIPE REFERENCE
        =================================================== -->

        <div
          class="success-reference"
          data-success-reference
          hidden
        >
          <span>
            Referencia
          </span>

          <code data-session-reference></code>
        </div>

        <!-- ==================================================
             ACTIONS
        =================================================== -->

        <div class="success-actions">
          <a
            href="/tienda"
            class="primary-link"
          >
            Volver a la tienda
          </a>

          <a
            href="/"
            class="secondary-link"
          >
            Ir a ATB
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    import {
      clearCart,
    } from "../../lib/shop/cart";

    // ============================================================
    // TYPES
    // ============================================================

    type OrderItem = {
      sku:
        | string
        | null;

      productName:
        string;

      variantDescription:
        | string
        | null;

      quantity:
        number;

      unitAmount:
        | number
        | null;

      lineTotal:
        | number
        | null;

      currency:
        string;
    };

    type PublicOrder = {
      id:
        string;

      reference:
        | string
        | null;

      status:
        string;

      currency:
        string;

      amountSubtotal:
        | number
        | null;

      amountShipping:
        number;

      amountTotal:
        | number
        | null;

      customerEmail:
        | string
        | null;

      shippingMethod:
        | string
        | null;

      shippingMethodName:
        | string
        | null;

      shippingStatus:
        string;

      createdAt:
        | string
        | null;

      items:
        OrderItem[];
    };

    type OrderStatusResponse = {
      confirmed?:
        boolean;

      processing?:
        boolean;

      order?:
        PublicOrder;

      error?:
        string;
    };

    type StatusState =
      | "loading"
      | "success"
      | "warning"
      | "error";

    // ============================================================
    // CONFIG
    // ============================================================

    const MAX_ATTEMPTS =
      10;

    const RETRY_DELAY_MS =
      1000;

    // ============================================================
    // REQUIRE ELEMENT
    //
    // querySelector normalmente devuelve T | null.
    //
    // Este helper hace que todos los elementos utilizados
    // después sean T, no T | null.
    //
    // Así eliminamos errores como:
    //
    // 'orderTotal' is possibly 'null'.ts(18047)
    // ============================================================

    function requireElement<
      T extends Element
    >(
      root:
        ParentNode,

      selector:
        string,
    ): T {
      const element =
        root.querySelector<T>(
          selector,
        );

      if (!element) {
        throw new Error(
          `[ATB Shop] Elemento requerido no encontrado: ${selector}`,
        );
      }

      return element;
    }

    // ============================================================
    // WAIT
    // ============================================================

    function wait(
      milliseconds:
        number,
    ): Promise<void> {
      return new Promise(
        (
          resolve,
        ) => {
          window.setTimeout(
            resolve,
            milliseconds,
          );
        },
      );
    }

    // ============================================================
    // MONEY
    // ============================================================

    function formatMoney(
      amount:
        | number
        | null,

      currency:
        | string
        | null,
    ): string {
      if (
        amount ===
        null
      ) {
        return "—";
      }

      const normalizedCurrency =
        (
          currency ??
          "MXN"
        ).toUpperCase();

      try {
        return new Intl.NumberFormat(
          "es-MX",
          {
            style:
              "currency",

            currency:
              normalizedCurrency,

            minimumFractionDigits:
              2,

            maximumFractionDigits:
              2,
          },
        ).format(
          amount /
            100,
        );
      } catch {
        return `$${(
          amount /
          100
        ).toFixed(
          2,
        )}`;
      }
    }

    // ============================================================
    // SESSION REFERENCE
    // ============================================================

    function getShortSessionReference(
      sessionId:
        string,
    ): string {
      if (
        sessionId.length <=
        18
      ) {
        return sessionId;
      }

      return `${sessionId.slice(
        0,
        10,
      )}…${sessionId.slice(
        -6,
      )}`;
    }

    // ============================================================
    // SHIPPING STATUS
    // ============================================================

    function getShippingStatusLabel(
      status:
        string,
    ): string {
      switch (
        status
      ) {
        case "pending":
          return "Pedido recibido";

        case "ready":
          return "Preparando envío";

        case "shipped":
          return "Enviado";

        case "delivered":
          return "Entregado";

        case "cancelled":
          return "Cancelado";

        default:
          return status;
      }
    }

    // ============================================================
    // ORDER STATUS
    // ============================================================

    function getOrderStatusLabel(
      status:
        string,
    ): string {
      switch (
        status
      ) {
        case "paid":
          return "Pago confirmado";

        case "completed":
          return "Pago confirmado";

        case "confirmed":
          return "Pago confirmado";

        case "pending":
          return "Pendiente";

        case "cancelled":
          return "Cancelado";

        default:
          return status;
      }
    }

    // ============================================================
    // INITIALIZE
    // ============================================================

    function initializeSuccessPage(): void {
      const page =
        document.querySelector<HTMLElement>(
          "[data-success-page]",
        );

      if (!page) {
        return;
      }

      // ========================================================
      // PREVENT DUPLICATE INITIALIZATION
      // ========================================================

      if (
        page.dataset
          .initialized ===
        "true"
      ) {
        return;
      }

      page.dataset
        .initialized =
        "true";

      // ========================================================
      // ELEMENTS
      //
      // Todos quedan tipados como elementos no-null.
      // ========================================================

      let title:
        HTMLElement;

      let description:
        HTMLElement;

      let statusContainer:
        HTMLElement;

      let statusIndicator:
        HTMLElement;

      let statusMessage:
        HTMLElement;

      let orderSummary:
        HTMLElement;

      let orderReference:
        HTMLElement;

      let orderStatus:
        HTMLElement;

      let emailContainer:
        HTMLElement;

      let orderEmail:
        HTMLElement;

      let orderItems:
        HTMLElement;

      let orderSubtotal:
        HTMLElement;

      let orderShipping:
        HTMLElement;

      let orderTotal:
        HTMLElement;

      let shippingLabel:
        HTMLElement;

      let shippingMethod:
        HTMLElement;

      let shippingStatus:
        HTMLElement;

      let successReference:
        HTMLElement;

      let sessionReference:
        HTMLElement;

      try {
        title =
          requireElement<HTMLElement>(
            page,
            "[data-success-title]",
          );

        description =
          requireElement<HTMLElement>(
            page,
            "[data-success-description]",
          );

        statusContainer =
          requireElement<HTMLElement>(
            page,
            "[data-success-status]",
          );

        statusIndicator =
          requireElement<HTMLElement>(
            page,
            "[data-status-indicator]",
          );

        statusMessage =
          requireElement<HTMLElement>(
            page,
            "[data-status-message]",
          );

        orderSummary =
          requireElement<HTMLElement>(
            page,
            "[data-order-summary]",
          );

        orderReference =
          requireElement<HTMLElement>(
            page,
            "[data-order-reference]",
          );

        orderStatus =
          requireElement<HTMLElement>(
            page,
            "[data-order-status]",
          );

        emailContainer =
          requireElement<HTMLElement>(
            page,
            "[data-email-container]",
          );

        orderEmail =
          requireElement<HTMLElement>(
            page,
            "[data-order-email]",
          );

        orderItems =
          requireElement<HTMLElement>(
            page,
            "[data-order-items]",
          );

        orderSubtotal =
          requireElement<HTMLElement>(
            page,
            "[data-order-subtotal]",
          );

        orderShipping =
          requireElement<HTMLElement>(
            page,
            "[data-order-shipping]",
          );

        orderTotal =
          requireElement<HTMLElement>(
            page,
            "[data-order-total]",
          );

        shippingLabel =
          requireElement<HTMLElement>(
            page,
            "[data-shipping-label]",
          );

        shippingMethod =
          requireElement<HTMLElement>(
            page,
            "[data-shipping-method]",
          );

        shippingStatus =
          requireElement<HTMLElement>(
            page,
            "[data-shipping-status]",
          );

        successReference =
          requireElement<HTMLElement>(
            page,
            "[data-success-reference]",
          );

        sessionReference =
          requireElement<HTMLElement>(
            page,
            "[data-session-reference]",
          );
      } catch (
        error
      ) {
        console.error(
          "[ATB Shop] No fue posible inicializar la página de confirmación:",
          error,
        );

        return;
      }

      // ========================================================
      // STATUS HELPER
      // ========================================================

      function setStatus(
        state:
          StatusState,

        message:
          string,
      ): void {
        statusContainer.dataset.state =
          state;

        statusMessage.textContent =
          message;

        statusIndicator.classList.remove(
          "is-loading",
          "is-success",
          "is-warning",
          "is-error",
        );

        statusIndicator.classList.add(
          `is-${state}`,
        );
      }

      // ========================================================
      // SESSION ID
      // ========================================================

      const params =
        new URLSearchParams(
          window.location.search,
        );

      const rawSessionId =
        params.get(
          "session_id",
        );

      if (
        !rawSessionId
      ) {
        title.textContent =
          "No pudimos verificar la compra.";

        description.textContent =
          "No encontramos una referencia de pago válida para consultar este pedido.";

        setStatus(
          "error",
          "Falta la referencia de Stripe.",
        );

        return;
      }

      /*
        Creamos otra constante explícitamente string.

        De esta manera TypeScript no vuelve a considerar
        que sessionId pueda ser null dentro de funciones
        asíncronas internas.
      */

      const sessionId:
        string =
        rawSessionId;

      // ========================================================
      // FALLBACK STRIPE REFERENCE
      // ========================================================

      sessionReference.textContent =
        getShortSessionReference(
          sessionId,
        );

      successReference.hidden =
        false;

      // ========================================================
      // RENDER ITEMS
      // ========================================================

      function renderItems(
        order:
          PublicOrder,
      ): void {
        orderItems.replaceChildren();

        if (
          order.items.length ===
          0
        ) {
          const empty =
            document.createElement(
              "p",
            );

          empty.className =
            "order-items-empty";

          empty.textContent =
            "No fue posible mostrar el detalle de los artículos.";

          orderItems.appendChild(
            empty,
          );

          return;
        }

        for (
          const item
          of order.items
        ) {
          const row =
            document.createElement(
              "div",
            );

          row.className =
            "order-item";

          // ====================================================
          // INFORMATION
          // ====================================================

          const information =
            document.createElement(
              "div",
            );

          information.className =
            "order-item-info";

          const name =
            document.createElement(
              "strong",
            );

          name.textContent =
            item.productName;

          information.appendChild(
            name,
          );

          if (
            item.variantDescription
          ) {
            const variant =
              document.createElement(
                "span",
              );

            variant.textContent =
              item.variantDescription;

            information.appendChild(
              variant,
            );
          }

          const quantity =
            document.createElement(
              "span",
            );

          quantity.textContent =
            item.quantity ===
              1
              ? "1 unidad"
              : `${item.quantity} unidades`;

          information.appendChild(
            quantity,
          );

          // ====================================================
          // PRICE
          // ====================================================

          const price =
            document.createElement(
              "div",
            );

          price.className =
            "order-item-price";

          price.textContent =
            formatMoney(
              item.lineTotal,
              order.currency,
            );

          row.appendChild(
            information,
          );

          row.appendChild(
            price,
          );

          orderItems.appendChild(
            row,
          );
        }
      }

      // ========================================================
      // RENDER CONFIRMED ORDER
      // ========================================================

      function renderConfirmedOrder(
        order:
          PublicOrder,
      ): void {
        /*
          Sólo limpiamos la bolsa después de haber recibido
          confirmación real desde shop_orders.
        */

        clearCart();

        // ======================================================
        // HEADER
        // ======================================================

        title.textContent =
          "Gracias por tu compra.";

        description.textContent =
          "Tu pago fue confirmado y tu pedido quedó registrado correctamente.";

        setStatus(
          "success",
          "Pago confirmado.",
        );

        // ======================================================
        // REFERENCE
        // ======================================================

        orderReference.textContent =
          order.reference ??
          "ATB";

        // ======================================================
        // ORDER STATUS
        // ======================================================

        orderStatus.textContent =
          getOrderStatusLabel(
            order.status,
          );

        // ======================================================
        // EMAIL
        // ======================================================

        if (
          order.customerEmail
        ) {
          orderEmail.textContent =
            order.customerEmail;

          emailContainer.hidden =
            false;
        } else {
          orderEmail.textContent =
            "—";

          emailContainer.hidden =
            true;
        }

        // ======================================================
        // MONEY
        // ======================================================

        orderSubtotal.textContent =
          formatMoney(
            order.amountSubtotal,
            order.currency,
          );

        orderShipping.textContent =
          order.amountShipping ===
            0
            ? "Gratis"
            : formatMoney(
                order.amountShipping,
                order.currency,
              );

        orderTotal.textContent =
          formatMoney(
            order.amountTotal,
            order.currency,
          );

        // ======================================================
        // SHIPPING LABEL
        // ======================================================

        shippingLabel.textContent =
          order.shippingMethodName ??
          "Envío";

        // ======================================================
        // SHIPPING METHOD
        // ======================================================

        shippingMethod.textContent =
          order.shippingMethodName ??
          "Envío estándar";

        // ======================================================
        // SHIPPING STATUS
        // ======================================================

        shippingStatus.textContent =
          getShippingStatusLabel(
            order.shippingStatus,
          );

        // ======================================================
        // ITEMS
        // ======================================================

        renderItems(
          order,
        );

        // ======================================================
        // SHOW SUMMARY
        // ======================================================

        orderSummary.hidden =
          false;

        /*
          Ya tenemos una referencia propia de pedido.

          No necesitamos enseñar el identificador técnico
          de Stripe al comprador.
        */

        successReference.hidden =
          true;
      }

      // ========================================================
      // VERIFY ORDER
      // ========================================================

      async function verifyOrder(): Promise<void> {
        setStatus(
          "loading",
          "Confirmando pedido…",
        );

        for (
          let attempt = 1;
          attempt <=
            MAX_ATTEMPTS;
          attempt += 1
        ) {
          try {
            const response =
              await fetch(
                `/api/order-status?session_id=${encodeURIComponent(
                  sessionId,
                )}`,
                {
                  method:
                    "GET",

                  headers: {
                    Accept:
                      "application/json",
                  },

                  cache:
                    "no-store",
                },
              );

            let data:
              OrderStatusResponse;

            try {
              data =
                (await response.json()) as
                  OrderStatusResponse;
            } catch {
              throw new Error(
                "El servidor devolvió una respuesta no válida.",
              );
            }

            // ==================================================
            // CONFIRMED
            // ==================================================

            const confirmedOrder =
              data.order;

            if (
              response.ok &&
              data.confirmed ===
                true &&
              confirmedOrder
            ) {
              renderConfirmedOrder(
                confirmedOrder,
              );

              return;
            }

            // ==================================================
            // WEBHOOK STILL PROCESSING
            // ==================================================

            if (
              response.status ===
                202 ||
              data.processing ===
                true
            ) {
              if (
                attempt <
                MAX_ATTEMPTS
              ) {
                setStatus(
                  "loading",
                  "Terminando de registrar tu pedido…",
                );

                await wait(
                  RETRY_DELAY_MS,
                );

                continue;
              }

              title.textContent =
                "Estamos terminando tu pedido.";

              description.textContent =
                "Tu pago fue recibido, pero el servidor todavía está terminando de registrar la compra.";

              setStatus(
                "warning",
                "La confirmación está tardando más de lo habitual.",
              );

              return;
            }

            // ==================================================
            // API ERROR
            // ==================================================

            throw new Error(
              data.error ??
                "No fue posible verificar el pedido.",
            );
          } catch (
            error
          ) {
            console.error(
              "[ATB Shop] Error verificando pedido:",
              {
                attempt,

                error,
              },
            );

            if (
              attempt <
              MAX_ATTEMPTS
            ) {
              setStatus(
                "loading",
                "Reintentando confirmación…",
              );

              await wait(
                RETRY_DELAY_MS,
              );

              continue;
            }

            // ==================================================
            // FINAL ERROR
            // ==================================================

            title.textContent =
              "No pudimos verificar el pedido.";

            description.textContent =
              "Stripe nos devolvió a ATB, pero no pudimos consultar el estado del pedido en este momento.";

            setStatus(
              "error",
              "Intenta volver a cargar esta página en unos momentos.",
            );
          }
        }
      }

      void verifyOrder();
    }

    // ============================================================
    // START
    // ============================================================

    initializeSuccessPage();

    document.addEventListener(
      "astro:page-load",
      initializeSuccessPage,
    );
  </script>
</Layout>

<style>
  /* ============================================================
     PAGE
  ============================================================ */

  .success-page {
    min-height:
      100vh;

    background:
      #ffffff;

    color:
      #111111;
  }

  .success-container {
    display:
      flex;

    align-items:
      center;

    width:
      min(
        1440px,
        calc(
          100% - 5rem
        )
      );

    min-height:
      100vh;

    margin:
      0 auto;

    padding:
      8rem
      0;
  }

  .success-content {
    width:
      min(
        100%,
        680px
      );
  }

  /* ============================================================
     LABEL
  ============================================================ */

  .success-label {
    margin:
      0
      0
      1.5rem;

    color:
      #888888;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.6rem;

    letter-spacing:
      0.14em;
  }

  /* ============================================================
     TITLE
  ============================================================ */

  .success-content h1 {
    margin:
      0;

    color:
      #111111;

    font-family:
      "Inter",
      sans-serif;

    font-size:
      clamp(
        3rem,
        7vw,
        6.5rem
      );

    font-weight:
      400;

    line-height:
      0.95;

    letter-spacing:
      -0.055em;
  }

  /* ============================================================
     DESCRIPTION
  ============================================================ */

  .success-description {
    max-width:
      500px;

    margin:
      2rem
      0
      0;

    color:
      #666666;

    font-family:
      "Inter",
      sans-serif;

    font-size:
      0.82rem;

    line-height:
      1.65;
  }

  /* ============================================================
     STATUS
  ============================================================ */

  .success-status {
    display:
      flex;

    align-items:
      center;

    gap:
      0.7rem;

    max-width:
      520px;

    margin-top:
      1.5rem;

    padding:
      0.9rem
      0;

    border-top:
      1px solid
      #e5e5e5;

    border-bottom:
      1px solid
      #e5e5e5;
  }

  .success-status p {
    margin:
      0;

    color:
      #777777;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.56rem;

    line-height:
      1.5;
  }

  .status-indicator {
    flex:
      0
      0
      auto;

    width:
      7px;

    height:
      7px;

    border-radius:
      50%;

    background:
      #999999;
  }

  .status-indicator.is-loading {
    animation:
      successPulse
      1.2s
      ease-in-out
      infinite;
  }

  .status-indicator.is-success {
    background:
      #111111;
  }

  .status-indicator.is-warning {
    background:
      #888888;
  }

