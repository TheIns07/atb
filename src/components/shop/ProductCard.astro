---
import type { Product } from "../../data/products";

import {
  formatMXN,
  getProductStartingPrice,
} from "../../data/products";

// ============================================================
// PROPS
// ============================================================

interface Props {
  product: Product;

  /**
   * "default"
   * Tarjeta normal utilizada en /tienda.
   *
   * "compact"
   * Versión ligeramente más contenida para
   * la sección SHOP de la página principal.
   */
  variant?: "default" | "compact";
}

const {
  product,
  variant = "default",
} = Astro.props;

// ============================================================
// PRODUCT INFORMATION
// ============================================================

const startingPrice =
  getProductStartingPrice(product);

const isUnique =
  product.documentaryInfo?.uniquePiece === true;

const isProductionObject =
  product.category === "documentary-prop";

const isScript =
  product.category === "documentary-script";

const isShirt =
  product.category === "shirt";

// ============================================================
// EDITORIAL LABEL
// ============================================================

let categoryLabel =
  "objeto";

if (isShirt) {
  categoryLabel =
    "prenda";
}

if (isProductionObject) {
  categoryLabel =
    "objeto de producción";
}

if (isScript) {
  categoryLabel =
    "guion de producción";
}

const productNumber =
  String(
    product.order,
  ).padStart(
    3,
    "0",
  );

// ============================================================
// PRICE / STATUS
// ============================================================

let priceLabel =
  "próximamente";

if (
  product.status ===
    "available" &&
  startingPrice !== null
) {
  priceLabel =
    formatMXN(
      startingPrice,
    );
}

if (
  product.status ===
  "sold-out"
) {
  priceLabel =
    "agotado";
}

// ============================================================
// ACCESSIBILITY
// ============================================================

const imageAlt =
  `${product.name}${
    product.subtitle
      ? ` — ${product.subtitle}`
      : ""
  }`;
---

<article
  class:list={[
    "product-card",
    `product-card--${variant}`,
    {
      "product-card--unique":
        isUnique,

      "product-card--shirt":
        isShirt,

      "product-card--archive":
        isProductionObject ||
        isScript,
    },
  ]}
>
  <a
    href={`/tienda/${product.slug}`}
    class="product-card-link"
    aria-label={`Abrir ${product.name}`}
  >
    <!-- ======================================================
         IMAGE
    ======================================================= -->

    <div class="product-image-shell">
      <img
        src={product.thumbnail}
        alt={imageAlt}
        class="product-image"
        loading="lazy"
        decoding="async"
      />

      <div
        class="product-image-shade"
        aria-hidden="true"
      ></div>

      <span
        class="product-index"
        aria-hidden="true"
      >
        {productNumber}
      </span>

      {
        isUnique && (
          <span class="unique-badge">
            1 de 1
          </span>
        )
      }
    </div>

    <!-- ======================================================
         INFORMATION
    ======================================================= -->

    <div class="product-information">
      <div class="product-meta">
        <span class="product-category">
          {categoryLabel}
        </span>

        <span
          class="product-meta-index"
          aria-hidden="true"
        >
          / {productNumber}
        </span>
      </div>

      <div class="product-heading">
        <div class="product-heading-copy">
          <h3 class="product-name">
            {product.name}
          </h3>
        </div>

        <p
          class:list={[
            "product-price",
            {
              "product-price--pending":
                product.status ===
                "coming-soon",

              "product-price--sold":
                product.status ===
                "sold-out",
            },
          ]}
        >
          {priceLabel}
        </p>
      </div>

      <!-- ====================================================
           SHIRT COLORS
      ===================================================== -->

      {
        isShirt &&
          product.colors &&
          product.colors.length >
            0 && (
            <div
              class="product-colors"
              aria-label="Colores disponibles"
            >
              {
                product.colors.map(
                  (
                    color,
                  ) => (
                    <span
                      class="color-dot"
                      style={`--product-color: ${color.hex};`}
                      title={
                        color.name
                      }
                    />
                  ),
                )
              }
            </div>
          )
      }
    </div>
  </a>
</article>

<style>
  /* ============================================================
     ROOT
  ============================================================ */

  .product-card {
    position: relative;

    width: 100%;
    min-width: 0;

    color: #181818;
  }

  .product-card-link {
    display: block;

    width: 100%;

    color: inherit;
    text-decoration: none;

    outline: none;
  }

  /* ============================================================
     IMAGE
  ============================================================ */

  .product-image-shell {
    position: relative;

    width: 100%;

    aspect-ratio: 4 / 5;

    overflow: hidden;

    background: #e8e6e1;
  }

  .product-image {
    position: absolute;

    inset: 0;

    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    transform:
      scale(
        1.001
      );

    transition:
      transform
        800ms
        cubic-bezier(
          0.22,
          1,
          0.36,
          1
        ),
      filter
        700ms
        ease;
  }

  .product-image-shade {
    position: absolute;

    inset: 0;

    z-index: 1;

    background:
      linear-gradient(
        180deg,
        rgba(
            0,
            0,
            0,
            0.02
          )
          50%,
        rgba(
            0,
            0,
            0,
            0.12
          )
          100%
      );

    opacity: 0;

    transition:
      opacity
        500ms
        ease;
  }

  /* ============================================================
     INDEX
  ============================================================ */

  .product-index {
    position: absolute;

    z-index: 3;

    top: 1rem;
    left: 1rem;

    color:
      rgba(
        255,
        255,
        255,
        0.86
      );

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.61rem;

    letter-spacing:
      0.12em;

    mix-blend-mode:
      difference;
  }

  /* ============================================================
     UNIQUE
  ============================================================ */

  .unique-badge {
    position: absolute;

    z-index: 3;

    top: 1rem;
    right: 1rem;

    padding:
      0.36rem
      0.48rem;

    border:
      1px
      solid
      rgba(
        255,
        255,
        255,
        0.42
      );

    color: #fff;

    background:
      rgba(
        12,
        12,
        12,
        0.16
      );

    backdrop-filter:
      blur(
        8px
      );

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.54rem;

    letter-spacing:
      0.08em;

    line-height: 1;
  }

  /* ============================================================
     INFORMATION
  ============================================================ */

  .product-information {
    padding:
      1.45rem
      0
      0;
  }

  .product-meta {
    display: flex;

    align-items:
      center;

    gap:
      0.32rem;

    margin-bottom:
      0.95rem;

    color:
      rgba(
        24,
        24,
        24,
        0.44
      );

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.56rem;

    line-height:
      1.35;

    letter-spacing:
      0.08em;
  }

  .product-category {
    text-transform:
      lowercase;
  }

  .product-meta-index {
    opacity:
      0.65;
  }

  /* ============================================================
     HEADING
  ============================================================ */

  .product-heading {
    display: grid;

    grid-template-columns:
      minmax(
        0,
        1fr
      )
      auto;

    align-items:
      start;

    gap:
      1.4rem;
  }

  .product-heading-copy {
    min-width: 0;
  }

  .product-name {
    margin: 0;

    color:
      #171717;

    font-family:
      "Inter",
      sans-serif;

    font-size:
      clamp(
        1rem,
        1.25vw,
        1.18rem
      );

    font-weight:
      500;

    line-height:
      1.18;

    letter-spacing:
      -0.025em;
  }

  /* ============================================================
     PRICE / STATUS
  ============================================================ */

  .product-price {
    margin: 0;

    padding-top:
      0.08rem;

    color:
      #171717;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.66rem;

    font-weight:
      500;

    line-height:
      1.2;

    letter-spacing:
      0.02em;

    white-space:
      nowrap;
  }

  .product-price--pending {
    color:
      rgba(
        24,
        24,
        24,
        0.42
      );

    font-size:
      0.56rem;

    font-weight:
      400;

    letter-spacing:
      0.06em;
  }

  .product-price--sold {
    color:
      rgba(
        24,
        24,
        24,
        0.42
      );

    font-size:
      0.56rem;

    font-weight:
      400;

    letter-spacing:
      0.06em;
  }

  /* ============================================================
     COLORS
  ============================================================ */

  .product-colors {
    display: flex;

    align-items:
      center;

    gap:
      0.38rem;

    margin-top:
      1rem;
  }

  .color-dot {
    display: block;

    width:
      0.65rem;

    height:
      0.65rem;

    border-radius:
      50%;

    background:
      var(
        --product-color
      );

    box-shadow:
      0
      0
      0
      1px
      rgba(
        0,
        0,
        0,
        0.13
      );
  }

  /* ============================================================
     ARCHIVE DIFFERENTIATION
  ============================================================ */

  .product-card--archive
    .product-image-shell {
    background:
      #dcd9d2;
  }

  .product-card--archive
    .product-name {
    font-family:
      "Inter",
      sans-serif;

    font-size:
      clamp(
        1rem,
        1.25vw,
        1.18rem
      );

    font-weight:
      500;

    line-height:
      1.18;

    letter-spacing:
      -0.025em;

    text-transform:
      none;
  }

  /* ============================================================
     HOVER
  ============================================================ */

  @media (
    hover: hover
  ) and (
    pointer: fine
  ) {
    .product-card-link:hover
      .product-image {
      transform:
        scale(
          1.025
        );
    }

    .product-card-link:hover
      .product-image-shade {
      opacity:
        1;
    }

    .product-card-link:focus-visible
      .product-image {
      transform:
        scale(
          1.025
        );
    }

    .product-card-link:focus-visible
      .product-image-shade {
      opacity:
        1;
    }
  }

  .product-card-link:focus-visible {
    outline:
      1px
      solid
      rgba(
        0,
        0,
        0,
        0.45
      );

    outline-offset:
      4px;
  }

  /* ============================================================
     COMPACT VERSION
  ============================================================ */

  .product-card--compact
    .product-information {
    padding-top:
      1.1rem;
  }

  .product-card--compact
    .product-meta {
    margin-bottom:
      0.65rem;
  }

  .product-card--compact
    .product-image-shell {
    aspect-ratio:
      4 /
      5.15;
  }

  /* ============================================================
     MOBILE
  ============================================================ */

  @media (
    max-width: 700px
  ) {
    .product-information {
      padding-top:
        1.05rem;
    }

    .product-meta {
      margin-bottom:
        0.7rem;
    }

    .product-heading {
      gap:
        0.7rem;
    }

    .product-name {
      font-size:
        0.94rem;
    }

    .product-card--archive
      .product-name {
      font-size:
        0.94rem;
    }

    .product-price {
      font-size:
        0.6rem;
    }

    .product-price--pending,
    .product-price--sold {
      font-size:
        0.52rem;
    }

    .product-index {
      top:
        0.75rem;

      left:
        0.75rem;
    }

    .unique-badge {
      top:
        0.7rem;

      right:
        0.7rem;
    }
  }

  /* ============================================================
     REDUCED MOTION
  ============================================================ */

  @media (
    prefers-reduced-motion:
      reduce
  ) {
    .product-image,
    .product-image-shade {
      transition-duration:
        0.01ms !important;
    }
  }
</style>