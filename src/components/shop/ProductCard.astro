---
import type { Product } from "../../data/products";
import {
  formatMXN,
  getProductStartingPrice,
} from "../../data/products";

// ============================================================
// PROPS
// ============================================================

interface Props {
  product: Product;

  /**
   * "default"
   * Tarjeta normal utilizada en /tienda.
   *
   * "compact"
   * Versión ligeramente más contenida para
   * la sección SHOP de la página principal.
   */
  variant?: "default" | "compact";
}

const {
  product,
  variant = "default",
} = Astro.props;

// ============================================================
// PRODUCT INFORMATION
// ============================================================

const startingPrice =
  getProductStartingPrice(product);

const isUnique =
  product.documentaryInfo?.uniquePiece === true;

const isProductionObject =
  product.category === "documentary-prop";

const isScript =
  product.category === "documentary-script";

const isShirt =
  product.category === "shirt";

// ============================================================
// EDITORIAL LABEL
// ============================================================

let categoryLabel = "ATB OBJECT";

if (isShirt) {
  categoryLabel = "ATB APPAREL";
}

if (isProductionObject) {
  categoryLabel = "ARCHIVE OBJECT";
}

if (isScript) {
  categoryLabel = "PRODUCTION SCRIPT";
}

const productNumber =
  String(product.order).padStart(3, "0");

// ============================================================
// PRICE / STATUS
// ============================================================

let priceLabel = "PRÓXIMAMENTE";

if (
  product.status === "available" &&
  startingPrice !== null
) {
  priceLabel = formatMXN(startingPrice);
}

if (
  product.status === "sold-out"
) {
  priceLabel = "AGOTADO";
}

// ============================================================
// ACCESSIBILITY
// ============================================================

const imageAlt =
  `${product.name}${product.subtitle
    ? ` — ${product.subtitle}`
    : ""
  }`;
---

<article
  class:list={[
    "product-card",
    `product-card--${variant}`,
    {
      "product-card--unique": isUnique,
      "product-card--shirt": isShirt,
      "product-card--archive":
        isProductionObject || isScript,
    },
  ]}
>
  <a
    href={`/tienda/${product.slug}`}
    class="product-card-link"
    aria-label={`Ver ${product.name}`}
  >
    <!-- ======================================================
         IMAGE
    ======================================================= -->

    <div class="product-image-shell">
      <img
        src={product.thumbnail}
        alt={imageAlt}
        class="product-image"
        loading="lazy"
        decoding="async"
      />

      <div
        class="product-image-shade"
        aria-hidden="true"
      ></div>

      <!-- Número editorial -->

      <span class="product-index">
        {productNumber}
      </span>

      <!-- Pieza única -->

      {
        isUnique && (
          <span class="unique-badge">
            1 OF 1
          </span>
        )
      }

      <!-- Hover -->

      <div
        class="product-view"
        aria-hidden="true"
      >
        <span>
          VER OBJETO
        </span>

        <span class="product-view-arrow">
          ↗
        </span>
      </div>
    </div>

    <!-- ======================================================
         INFORMATION
    ======================================================= -->

    <div class="product-information">
      <div class="product-meta">
        <span class="product-category">
          {categoryLabel}
        </span>

        <span class="product-meta-index">
          / {productNumber}
        </span>
      </div>

      <div class="product-heading">
        <div class="product-heading-copy">
          <h3 class="product-name">
            {product.name}
          </h3>

          {
            product.subtitle && (
              <p class="product-subtitle">
                {product.subtitle}
              </p>
            )
          }
        </div>

        <p
          class:list={[
            "product-price",
            {
              "product-price--pending":
                product.status ===
                "coming-soon",

              "product-price--sold":
                product.status ===
                "sold-out",
            },
          ]}
        >
          {priceLabel}
        </p>
      </div>

      <!-- ====================================================
           ARCHIVE DETAILS
      ===================================================== -->

      {
        (isProductionObject ||
          isScript) && (
          <div class="archive-information">
            {
              product.documentaryInfo
                ?.usedInProduction && (
                <span>
                  UTILIZADO EN PRODUCCIÓN
                </span>
              )
            }

            {
              isUnique && (
                <>
                  <span
                    class="archive-divider"
                    aria-hidden="true"
                  >
                    /
                  </span>

                  <span>
                    PIEZA ÚNICA
                  </span>
                </>
              )
            }
          </div>
        )
      }

      <!-- ====================================================
           SHIRT COLORS
      ===================================================== -->

      {
        isShirt &&
          product.colors &&
          product.colors.length > 0 && (
            <div
              class="product-colors"
              aria-label="Colores disponibles"
            >
              {product.colors.map(
                (color) => (
                  <span
                    class="color-dot"
                    style={`--product-color: ${color.hex};`}
                    title={color.name}
                  />
                ),
              )}
            </div>
          )
      }
    </div>
  </a>
</article>

<style>
  /* ============================================================
     PRODUCT CARD
  ============================================================ */

  .product-card {
    position: relative;

    width: 100%;

    min-width: 0;

    color: #181818;
  }

  .product-card-link {
    display: block;

    width: 100%;

    color: inherit;

    text-decoration: none;

    outline: none;
  }

  /* ============================================================
     IMAGE
  ============================================================ */

  .product-image-shell {
    position: relative;

    width: 100%;

    aspect-ratio: 4 / 5;

    overflow: hidden;

    background: #e8e6e1;
  }

  .product-image {
    position: absolute;

    inset: 0;

    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    object-position: center;

    transform: scale(1.001);

    transition:
      transform 800ms
        cubic-bezier(
          0.22,
          1,
          0.36,
          1
        ),
      filter 700ms ease;
  }

  .product-image-shade {
    position: absolute;

    inset: 0;

    z-index: 1;

    background:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.02)
          50%,
        rgba(0, 0, 0, 0.18)
          100%
      );

    opacity: 0;

    transition:
      opacity 500ms ease;
  }

  /* ============================================================
     INDEX
  ============================================================ */

  .product-index {
    position: absolute;

    z-index: 3;

    top: 1rem;
    left: 1rem;

    color:
      rgba(
        255,
        255,
        255,
        0.86
      );

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size: 0.61rem;

    letter-spacing: 0.12em;

    mix-blend-mode: difference;
  }

  /* ============================================================
     UNIQUE
  ============================================================ */

  .unique-badge {
    position: absolute;

    z-index: 3;

    top: 1rem;
    right: 1rem;

    padding:
      0.36rem
      0.48rem;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.42
      );

    color: #fff;

    background:
      rgba(
        12,
        12,
        12,
        0.16
      );

    backdrop-filter:
      blur(8px);

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size: 0.54rem;

    letter-spacing: 0.14em;

    line-height: 1;
  }

  /* ============================================================
     VIEW HOVER
  ============================================================ */

  .product-view {
    position: absolute;

    z-index: 4;

    right: 1rem;
    bottom: 1rem;
    left: 1rem;

    display: flex;

    justify-content:
      space-between;

    align-items: center;

    color: #fff;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size: 0.59rem;

    letter-spacing: 0.13em;

    opacity: 0;

    transform:
      translateY(6px);

    transition:
      opacity 350ms ease,
      transform 450ms
        cubic-bezier(
          0.22,
          1,
          0.36,
          1
        );
  }

  .product-view-arrow {
    font-size: 0.9rem;

    line-height: 1;
  }

  /* ============================================================
     INFORMATION
  ============================================================ */

  .product-information {
    padding:
      1rem
      0
      0;
  }

  .product-meta {
    display: flex;

    align-items: center;

    gap: 0.25rem;

    margin-bottom:
      0.75rem;

    color:
      rgba(
        24,
        24,
        24,
        0.44
      );

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size: 0.56rem;

    letter-spacing: 0.14em;
  }

  .product-category {
    text-transform:
      uppercase;
  }

  .product-heading {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    align-items:
      start;

    gap: 1rem;
  }

  .product-heading-copy {
    min-width: 0;
  }

  .product-name {
    margin: 0;

    color: #171717;

    font-family:
      "Inter",
      sans-serif;

    font-size:
      clamp(
        1rem,
        1.25vw,
        1.18rem
      );

    font-weight: 500;

    line-height: 1.15;

    letter-spacing:
      -0.025em;
  }

  .product-subtitle {
    margin:
      0.35rem
      0
      0;

    color:
      rgba(
        24,
        24,
        24,
        0.53
      );

    font-family:
      "Inter",
      sans-serif;

    font-size: 0.72rem;

    font-weight: 400;

    line-height: 1.4;
  }

  /* ============================================================
     PRICE
  ============================================================ */

  .product-price {
    margin: 0;

    padding-top:
      0.08rem;

    color: #171717;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size: 0.66rem;

    font-weight: 500;

    line-height: 1.2;

    letter-spacing: 0.04em;

    white-space: nowrap;
  }

  .product-price--pending {
    color:
      rgba(
        24,
        24,
        24,
        0.42
      );

    font-size: 0.56rem;

    letter-spacing:
      0.11em;
  }

  .product-price--sold {
    color:
      rgba(
        24,
        24,
        24,
        0.36
      );

    text-decoration:
      line-through;
  }

  /* ============================================================
     ARCHIVE
  ============================================================ */

  .archive-information {
    display: flex;

    flex-wrap: wrap;

    align-items: center;

    gap: 0.4rem;

    margin-top: 0.85rem;

    color:
      rgba(
        24,
        24,
        24,
        0.38
      );

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size: 0.5rem;

    line-height: 1.4;

    letter-spacing: 0.1em;
  }

  .archive-divider {
    opacity: 0.45;
  }

  /* ============================================================
     COLORS
  ============================================================ */

  .product-colors {
    display: flex;

    align-items: center;

    gap: 0.38rem;

    margin-top:
      0.85rem;
  }

  .color-dot {
    display: block;

    width: 0.65rem;
    height: 0.65rem;

    border-radius: 50%;

    background:
      var(
        --product-color
      );

    box-shadow:
      0 0 0 1px
      rgba(
        0,
        0,
        0,
        0.13
      );
  }

  /* ============================================================
     ARCHIVE DIFFERENTIATION
  ============================================================ */

  .product-card--archive
    .product-image-shell {
    background: #dcd9d2;
  }

  .product-card--archive
    .product-name {
    font-family:
      "IBM Plex Mono",
      monospace;

    font-size: 0.88rem;

    font-weight: 500;

    letter-spacing:
      -0.015em;

    text-transform:
      uppercase;
  }

  /* ============================================================
     HOVER
  ============================================================ */

  @media (
    hover: hover
  ) and (
    pointer: fine
  ) {
    .product-card-link:hover
      .product-image {
      transform:
        scale(1.035);
    }

    .product-card-link:hover
      .product-image-shade {
      opacity: 1;
    }

    .product-card-link:hover
      .product-view {
      opacity: 1;

      transform:
        translateY(0);
    }

    .product-card-link:focus-visible
      .product-image {
      transform:
        scale(1.035);
    }

    .product-card-link:focus-visible
      .product-view {
      opacity: 1;

      transform:
        translateY(0);
    }
  }

  /* ============================================================
     COMPACT VERSION
  ============================================================ */

  .product-card--compact
    .product-information {
    padding-top:
      0.8rem;
  }

  .product-card--compact
    .product-meta {
    margin-bottom:
      0.55rem;
  }

  .product-card--compact
    .product-image-shell {
    aspect-ratio: 4 / 5.15;
  }

  /* ============================================================
     MOBILE
  ============================================================ */

  @media (
    max-width: 700px
  ) {
    .product-information {
      padding-top:
        0.75rem;
    }

    .product-heading {
      gap: 0.65rem;
    }

    .product-name {
      font-size:
        0.94rem;
    }

    .product-subtitle {
      font-size:
        0.67rem;
    }

    .product-price {
      font-size:
        0.6rem;
    }

    .product-price--pending {
      font-size:
        0.5rem;
    }

    .product-index {
      top: 0.75rem;
      left: 0.75rem;
    }

    .unique-badge {
      top: 0.7rem;
      right: 0.7rem;
    }

    .product-view {
      display: none;
    }
  }

  /* ============================================================
     REDUCED MOTION
  ============================================================ */

  @media (
    prefers-reduced-motion:
    reduce
  ) {
    .product-image,
    .product-image-shade,
    .product-view {
      transition-duration:
        0.01ms !important;
    }
  }
</style>