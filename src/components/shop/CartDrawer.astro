<aside
  id="cart-drawer"
  class="cart-drawer"
  aria-hidden="true"
  aria-label="Bolsa de compra"
>
  <!-- =====================================================
       BACKDROP
  ====================================================== -->

  <button
    id="cart-backdrop"
    class="cart-backdrop"
    type="button"
    aria-label="Cerrar bolsa"
    tabindex="-1"
  ></button>

  <!-- =====================================================
       PANEL
  ====================================================== -->

  <div
    class="cart-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cart-title"
  >
    <!-- ===================================================
         HEADER
    ==================================================== -->

    <header class="cart-header">
      <h2 id="cart-title">
        Bolsa
      </h2>

      <button
        id="cart-close"
        class="cart-close"
        type="button"
        aria-label="Cerrar bolsa"
      >
        ×
      </button>
    </header>

    <!-- ===================================================
         CONTENT
    ==================================================== -->

    <div
      id="cart-content"
      class="cart-content"
    >
      <div class="cart-empty">
        <p>
          Tu bolsa está vacía.
        </p>

        <a href="/tienda">
          Ver tienda
        </a>
      </div>
    </div>

    <!-- ===================================================
         FOOTER
    ==================================================== -->

    <footer
      id="cart-footer"
      class="cart-footer"
      hidden
    >
      <div class="cart-total">
        <span>
          Total
        </span>

        <strong
          id="cart-total-value"
        >
          $0
        </strong>
      </div>

      <p class="cart-shipping-note">
        Envío calculado al finalizar la compra.
      </p>

      <p
        id="cart-checkout-message"
        class="checkout-message"
        aria-live="polite"
      ></p>

      <button
        id="cart-checkout"
        class="checkout-button"
        type="button"
        disabled
      >
        Finalizar compra
      </button>
    </footer>
  </div>
</aside>

<script>
  import {
    CART_CHANGE_EVENT,
    getCart,
    getCartTotal,
    removeFromCart,
    resolveCartItems,
    updateCartQuantity,
  } from "../../lib/shop/cart";

  import {
    formatMXN,
  } from "../../data/products";

  // ============================================================
  // TYPES
  // ============================================================

  type CheckoutResponse = {
    url?: string;
    sessionId?: string;
    error?: string;
  };

  type InventoryItem = {
    stock: number;
    active: boolean;
    available: boolean;

    updatedAt?:
      | string
      | null;
  };

  type InventoryResponse = {
    inventoryBySku?: Record<
      string,
      InventoryItem
    >;

    missingSkus?: string[];

    error?: string;
  };

  // ============================================================
  // INIT
  // ============================================================

  function initializeCartDrawer(): void {
    const drawer =
      document.querySelector<HTMLElement>(
        "#cart-drawer",
      );

    if (!drawer) {
      return;
    }

    if (
      drawer.dataset.initialized ===
      "true"
    ) {
      return;
    }

    drawer.dataset.initialized =
      "true";

    // ========================================================
    // ELEMENTS
    // ========================================================

    const panel =
      drawer.querySelector<HTMLElement>(
        ".cart-panel",
      );

    const backdrop =
      drawer.querySelector<HTMLButtonElement>(
        "#cart-backdrop",
      );

    const closeButton =
      drawer.querySelector<HTMLButtonElement>(
        "#cart-close",
      );

    const content =
      drawer.querySelector<HTMLElement>(
        "#cart-content",
      );

    const footer =
      drawer.querySelector<HTMLElement>(
        "#cart-footer",
      );

    const totalValue =
      drawer.querySelector<HTMLElement>(
        "#cart-total-value",
      );

    const checkoutButton =
      drawer.querySelector<HTMLButtonElement>(
        "#cart-checkout",
      );

    const checkoutMessage =
      drawer.querySelector<HTMLElement>(
        "#cart-checkout-message",
      );

    if (
      !panel ||
      !backdrop ||
      !closeButton ||
      !content ||
      !footer ||
      !totalValue ||
      !checkoutButton ||
      !checkoutMessage
    ) {
      return;
    }

    // ========================================================
    // STATE
    // ========================================================

    let checkoutInProgress =
      false;

    let inventoryLoading =
      false;

    let inventoryVerified =
      false;

    let cartValidForCheckout =
      false;

    let inventoryBySku:
      Record<
        string,
        InventoryItem
      > = {};

    let inventoryRequestId =
      0;

    // ========================================================
    // DRAWER
    // ========================================================

    function openCart(): void {
      drawer.classList.add(
        "is-open",
      );

      drawer.setAttribute(
        "aria-hidden",
        "false",
      );

      document.documentElement.classList.add(
        "cart-open",
      );

      void refreshCart();

      window.setTimeout(
        () => {
          closeButton.focus();
        },
        100,
      );
    }

    function closeCart(): void {
      if (
        checkoutInProgress
      ) {
        return;
      }

      drawer.classList.remove(
        "is-open",
      );

      drawer.setAttribute(
        "aria-hidden",
        "true",
      );

      document.documentElement.classList.remove(
        "cart-open",
      );
    }

    backdrop.addEventListener(
      "click",
      closeCart,
    );

    closeButton.addEventListener(
      "click",
      closeCart,
    );

    window.addEventListener(
      "atb:cart-open",
      openCart,
    );

    window.addEventListener(
      "atb:cart-close",
      closeCart,
    );

    window.addEventListener(
      "keydown",
      (
        event: KeyboardEvent,
      ) => {
        if (
          event.key ===
            "Escape" &&
          drawer.classList.contains(
            "is-open",
          ) &&
          !checkoutInProgress
        ) {
          closeCart();
        }
      },
    );

    // ========================================================
    // HELPERS
    // ========================================================

    function escapeHTML(
      value: string,
    ): string {
      return value
        .replaceAll(
          "&",
          "&amp;",
        )
        .replaceAll(
          "<",
          "&lt;",
        )
        .replaceAll(
          ">",
          "&gt;",
        )
        .replaceAll(
          '"',
          "&quot;",
        )
        .replaceAll(
          "'",
          "&#039;",
        );
    }

    function getVariantDescription(
      colorName:
        | string
        | null,

      size:
        | string
        | null,
    ): string {
      return [
        colorName,
        size,
      ]
        .filter(Boolean)
        .join(" / ");
    }

    function setCheckoutMessage(
      message: string,

      type:
        | "default"
        | "error" =
        "default",
    ): void {
      checkoutMessage.textContent =
        message;

      checkoutMessage.classList.toggle(
        "is-error",
        type === "error",
      );
    }

    function getInventory(
      sku: string,
    ):
      | InventoryItem
      | undefined {
      return inventoryBySku[
        sku
      ];
    }

    // ========================================================
    // INVENTORY
    // ========================================================

    async function loadInventory(
      skus: string[],
    ): Promise<boolean> {
      inventoryLoading =
        true;

      inventoryVerified =
        false;

      const requestId =
        ++inventoryRequestId;

      if (
        skus.length ===
        0
      ) {
        inventoryBySku =
          {};

        inventoryLoading =
          false;

        inventoryVerified =
          true;

        return true;
      }

      const params =
        new URLSearchParams();

      params.set(
        "skus",
        skus.join(
          ",",
        ),
      );

      try {
        const response =
          await fetch(
            `/api/inventory?${params.toString()}`,
            {
              method:
                "GET",

              headers: {
                Accept:
                  "application/json",
              },

              cache:
                "no-store",
            },
          );

        const data =
          (await response.json()) as
            InventoryResponse;

        /*
          Si otra petición empezó mientras
          ésta estaba cargando, ignoramos
          esta respuesta antigua.
        */

        if (
          requestId !==
          inventoryRequestId
        ) {
          return false;
        }

        if (
          !response.ok
        ) {
          throw new Error(
            data.error ??
              "No fue posible verificar el inventario.",
          );
        }

        const result =
          data.inventoryBySku ??
          {};

        /*
          SKU faltante = no disponible.
        */

        for (
          const sku
          of data.missingSkus ??
          []
        ) {
          result[
            sku
          ] = {
            stock:
              0,

            active:
              false,

            available:
              false,
          };
        }

        inventoryBySku =
          result;

        inventoryLoading =
          false;

        inventoryVerified =
          true;

        return true;
      } catch (
        error
      ) {
        if (
          requestId !==
          inventoryRequestId
        ) {
          return false;
        }

        console.error(
          "[ATB Shop] Cart inventory error:",
          error,
        );

        inventoryBySku =
          {};

        inventoryLoading =
          false;

        inventoryVerified =
          false;

        return false;
      }
    }

    // ========================================================
    // RENDER LOADING
    // ========================================================

    function renderLoading(): void {
      content.innerHTML = `
        <div class="cart-loading">
          <p>
            Comprobando inventario…
          </p>
        </div>
      `;

      checkoutButton.disabled =
        true;

      footer.hidden =
        false;

      totalValue.textContent =
        "—";

      setCheckoutMessage(
        "",
      );
    }

    // ========================================================
    // RENDER EMPTY
    // ========================================================

    function renderEmpty(): void {
      content.innerHTML = `
        <div class="cart-empty">
          <p>
            Tu bolsa está vacía.
          </p>

          <a href="/tienda">
            Ver tienda
          </a>
        </div>
      `;

      footer.hidden =
        true;

      checkoutButton.disabled =
        true;

      cartValidForCheckout =
        false;

      setCheckoutMessage(
        "",
      );
    }

    // ========================================================
    // RENDER CART
    // ========================================================

    function renderCart(): void {
      const items =
        resolveCartItems();

      if (
        items.length ===
        0
      ) {
        renderEmpty();

        return;
      }

      let hasInventoryProblem =
        false;

      const markup =
        items
          .map(
            ({
              product,
              variant,
              quantity,
              sku,
              lineTotal,
            }) => {
              const color =
                product.colors?.find(
                  (
                    candidate,
                  ) =>
                    candidate.id ===
                    variant.colorId,
                );

              const variantDescription =
                getVariantDescription(
                  color?.name ??
                    null,

                  variant.size ??
                    null,
                );

              const price =
                lineTotal ===
                null
                  ? "Precio pendiente"
                  : formatMXN(
                      lineTotal,
                    );

              const inventory =
                getInventory(
                  sku,
                );

              let stockLabel =
                "";

              let itemUnavailable =
                false;

              let quantityProblem =
                false;

              let maximum =
                0;

              if (
                !inventoryVerified
              ) {
                itemUnavailable =
                  true;

                stockLabel =
                  "Inventario no verificado";

                hasInventoryProblem =
                  true;
              } else if (
                !inventory ||
                !inventory.active
              ) {
                itemUnavailable =
                  true;

                stockLabel =
                  "No disponible";

                hasInventoryProblem =
                  true;
              } else if (
                inventory.stock <=
                0
              ) {
                itemUnavailable =
                  true;

                stockLabel =
                  "Agotado";

                hasInventoryProblem =
                  true;
              } else {
                maximum =
                  inventory.stock;

                if (
                  quantity >
                  inventory.stock
                ) {
                  quantityProblem =
                    true;

                  hasInventoryProblem =
                    true;

                  stockLabel =
                    inventory.stock ===
                    1
                      ? "Sólo queda 1 unidad"
                      : `Sólo quedan ${inventory.stock} unidades`;
                } else if (
                  inventory.stock ===
                  1
                ) {
                  stockLabel =
                    "Última unidad";
                } else {
                  stockLabel =
                    `${inventory.stock} disponibles`;
                }
              }

              const decreaseDisabled =
                checkoutInProgress;

              const increaseDisabled =
                checkoutInProgress ||
                itemUnavailable ||
                quantityProblem ||
                quantity >=
                  maximum;

              return `
                <article
                  class="cart-item ${
                    itemUnavailable
                      ? "is-unavailable"
                      : ""
                  } ${
                    quantityProblem
                      ? "has-stock-problem"
                      : ""
                  }"
                  data-cart-item
                  data-sku="${escapeHTML(
                    sku,
                  )}"
                >
                  <a
                    class="cart-item-image"
                    href="/tienda/${escapeHTML(
                      product.slug,
                    )}"
                    aria-label="${escapeHTML(
                      product.name,
                    )}"
                  >
                    <span
                      class="cart-image-placeholder"
                    >
                      ATB
                    </span>

                    <img
                      src="${escapeHTML(
                        product.thumbnail,
                      )}"
                      alt="${escapeHTML(
                        product.name,
                      )}"
                      loading="lazy"
                      data-cart-image
                    />
                  </a>

                  <div
                    class="cart-item-information"
                  >
                    <div
                      class="cart-item-heading"
                    >
                      <div>
                        <a
                          href="/tienda/${escapeHTML(
                            product.slug,
                          )}"
                          class="cart-item-name"
                        >
                          ${escapeHTML(
                            product.name,
                          )}
                        </a>

                        ${
                          variantDescription
                            ? `
                              <p
                                class="cart-item-variant"
                              >
                                ${escapeHTML(
                                  variantDescription,
                                )}
                              </p>
                            `
                            : ""
                        }

                        <p
                          class="cart-item-stock ${
                            itemUnavailable ||
                            quantityProblem
                              ? "is-warning"
                              : ""
                          }"
                        >
                          ${escapeHTML(
                            stockLabel,
                          )}
                        </p>
                      </div>

                      <span
                        class="cart-item-price"
                      >
                        ${escapeHTML(
                          price,
                        )}
                      </span>
                    </div>

                    <div
                      class="cart-item-actions"
                    >
                      <div
                        class="quantity-control"
                        aria-label="Cantidad"
                      >
                        <button
                          type="button"
                          data-cart-decrease
                          aria-label="Disminuir cantidad"
                          ${
                            decreaseDisabled
                              ? "disabled"
                              : ""
                          }
                        >
                          −
                        </button>

                        <span>
                          ${quantity}
                        </span>

                        <button
                          type="button"
                          data-cart-increase
                          aria-label="Aumentar cantidad"
                          ${
                            increaseDisabled
                              ? "disabled"
                              : ""
                          }
                        >
                          +
                        </button>
                      </div>

                      <button
                        type="button"
                        class="remove-button"
                        data-cart-remove
                        ${
                          checkoutInProgress
                            ? "disabled"
                            : ""
                        }
                      >
                        Eliminar
                      </button>
                    </div>
                  </div>
                </article>
              `;
            },
          )
          .join("");

      content.innerHTML = `
        <div class="cart-items">
          ${markup}
        </div>
      `;

      footer.hidden =
        false;

      const total =
        getCartTotal();

      totalValue.textContent =
        total === null
          ? "—"
          : formatMXN(
              total,
            );

      cartValidForCheckout =
        inventoryVerified &&
        !hasInventoryProblem &&
        total !== null &&
        total >
          0;

      if (
        !checkoutInProgress
      ) {
        checkoutButton.disabled =
          !cartValidForCheckout;

        checkoutButton.textContent =
          "Finalizar compra";
      }

      if (
        !inventoryVerified
      ) {
        setCheckoutMessage(
          "No pudimos verificar el inventario.",
          "error",
        );
      } else if (
        hasInventoryProblem
      ) {
        setCheckoutMessage(
          "Revisa los artículos marcados antes de continuar.",
          "error",
        );
      } else {
        setCheckoutMessage(
          "",
        );
      }

      initializeCartItemEvents();

      initializeCartImages();
    }

    // ========================================================
    // REFRESH CART
    // ========================================================

    async function refreshCart(): Promise<boolean> {
      const items =
        resolveCartItems();

      if (
        items.length ===
        0
      ) {
        renderEmpty();

        return true;
      }

      renderLoading();

      const skus =
        Array.from(
          new Set(
            items.map(
              (
                item,
              ) =>
                item.sku,
            ),
          ),
        );

      const success =
        await loadInventory(
          skus,
        );

      renderCart();

      return success;
    }

    // ========================================================
    // ITEM EVENTS
    // ========================================================

    function initializeCartItemEvents(): void {
      const itemElements =
        content.querySelectorAll<HTMLElement>(
          "[data-cart-item]",
        );

      itemElements.forEach(
        (
          itemElement,
        ) => {
          const sku =
            itemElement.dataset
              .sku;

          if (!sku) {
            return;
          }

          const decreaseButton =
            itemElement.querySelector<HTMLButtonElement>(
              "[data-cart-decrease]",
            );

          const increaseButton =
            itemElement.querySelector<HTMLButtonElement>(
              "[data-cart-increase]",
            );

          const removeButton =
            itemElement.querySelector<HTMLButtonElement>(
              "[data-cart-remove]",
            );

          // ==================================================
          // DECREASE
          // ==================================================

          decreaseButton?.addEventListener(
            "click",
            () => {
              if (
                checkoutInProgress
              ) {
                return;
              }

              const cart =
                getCart();

              const item =
                cart.items.find(
                  (
                    candidate,
                  ) =>
                    candidate.sku ===
                    sku,
                );

              if (!item) {
                return;
              }

              if (
                item.quantity <=
                1
              ) {
                removeFromCart(
                  sku,
                );

                return;
              }

              updateCartQuantity(
                sku,
                item.quantity -
                  1,
              );
            },
          );

          // ==================================================
          // INCREASE
          // ==================================================

          increaseButton?.addEventListener(
            "click",
            () => {
              if (
                checkoutInProgress
              ) {
                return;
              }

              const inventory =
                getInventory(
                  sku,
                );

              if (
                !inventory ||
                !inventory.active ||
                inventory.stock <=
                  0
              ) {
                setCheckoutMessage(
                  "Este artículo ya no está disponible.",
                  "error",
                );

                return;
              }

              const cart =
                getCart();

              const item =
                cart.items.find(
                  (
                    candidate,
                  ) =>
                    candidate.sku ===
                    sku,
                );

              if (!item) {
                return;
              }

              if (
                item.quantity >=
                inventory.stock
              ) {
                setCheckoutMessage(
                  inventory.stock ===
                    1
                    ? "Sólo queda 1 unidad disponible."
                    : `Sólo quedan ${inventory.stock} unidades disponibles.`,
                  "error",
                );

                return;
              }

              updateCartQuantity(
                sku,
                item.quantity +
                  1,
              );
            },
          );

          // ==================================================
          // REMOVE
          // ==================================================

          removeButton?.addEventListener(
            "click",
            () => {
              if (
                checkoutInProgress
              ) {
                return;
              }

              removeFromCart(
                sku,
              );
            },
          );
        },
      );
    }

    // ========================================================
    // IMAGE FALLBACK
    // ========================================================

    function initializeCartImages(): void {
      const images =
        content.querySelectorAll<HTMLImageElement>(
          "[data-cart-image]",
        );

      images.forEach(
        (
          image,
        ) => {
          function handleError(): void {
            image.style.display =
              "none";
          }

          image.addEventListener(
            "error",
            handleError,
          );

          if (
            image.complete &&
            image.naturalWidth ===
              0
          ) {
            handleError();
          }
        },
      );
    }

    // ========================================================
    // CART CHANGE
    // ========================================================

    window.addEventListener(
      CART_CHANGE_EVENT,
      () => {
        void refreshCart();
      },
    );

    // ========================================================
    // CHECKOUT
    // ========================================================

    checkoutButton.addEventListener(
      "click",
      async () => {
        if (
          checkoutButton.disabled ||
          checkoutInProgress
        ) {
          return;
        }

        const cart =
          getCart();

        if (
          cart.items.length ===
          0
        ) {
          setCheckoutMessage(
            "Tu bolsa está vacía.",
            "error",
          );

          return;
        }

        // ====================================================
        // FRESH INVENTORY CHECK
        // ====================================================

        checkoutButton.disabled =
          true;

        checkoutButton.textContent =
          "Verificando…";

        setCheckoutMessage(
          "",
        );

        const inventoryOk =
          await refreshCart();

        if (
          !inventoryOk ||
          !cartValidForCheckout
        ) {
          checkoutButton.disabled =
            true;

          checkoutButton.textContent =
            "Finalizar compra";

          if (
            !inventoryVerified
          ) {
            setCheckoutMessage(
              "No pudimos verificar el inventario. Intenta nuevamente.",
              "error",
            );
          }

          return;
        }

        // ====================================================
        // LOCK UI
        // ====================================================

        checkoutInProgress =
          true;

        checkoutButton.disabled =
          true;

        checkoutButton.textContent =
          "Abriendo pago…";

        setCheckoutMessage(
          "",
        );

        try {
          // ==================================================
          // SERVER CHECKOUT
          //
          // /api/checkout vuelve a comprobar Supabase.
          //
          // El navegador nunca es la fuente final.
          // ==================================================

          const latestCart =
            getCart();

          const response =
            await fetch(
              "/api/checkout",
              {
                method:
                  "POST",

                headers: {
                  "Content-Type":
                    "application/json",

                  Accept:
                    "application/json",
                },

                body:
                  JSON.stringify({
                    items:
                      latestCart.items.map(
                        (
                          item,
                        ) => ({
                          sku:
                            item.sku,

                          quantity:
                            item.quantity,
                        }),
                      ),
                  }),
              },
            );

          let data:
            CheckoutResponse;

          try {
            data =
              (await response.json()) as
                CheckoutResponse;
          } catch {
            throw new Error(
              "El servidor devolvió una respuesta no válida.",
            );
          }

          // ==================================================
          // SERVER ERROR
          // ==================================================

          if (
            !response.ok
          ) {
            throw new Error(
              data.error ??
                "No fue posible iniciar el pago.",
            );
          }

          // ==================================================
          // STRIPE URL
          // ==================================================

          if (
            !data.url ||
            typeof data.url !==
              "string"
          ) {
            throw new Error(
              "No fue posible obtener la página de pago.",
            );
          }

          checkoutButton.textContent =
            "Redirigiendo…";

          window.location.assign(
            data.url,
          );
        } catch (
          error
        ) {
          console.error(
            "[ATB Shop] Checkout error:",
            error,
          );

          checkoutInProgress =
            false;

          const message =
            error instanceof
            Error
              ? error.message
              : "No fue posible iniciar el pago.";

          setCheckoutMessage(
            message,
            "error",
          );

          /*
            Volvemos a consultar inventario porque
            el error pudo deberse a que otra persona
            compró una unidad justo antes.
          */

          await refreshCart();

          checkoutButton.textContent =
            "Finalizar compra";
        }
      },
    );

    // ========================================================
    // INITIAL
    // ========================================================

    void refreshCart();
  }

  initializeCartDrawer();

  document.addEventListener(
    "astro:page-load",
    initializeCartDrawer,
