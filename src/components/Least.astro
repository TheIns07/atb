      0;
  }

  .stat-label {
    color:
      #999999;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.46rem;

    letter-spacing:
      0.05em;

    text-transform:
      lowercase;
  }

  .stat-value {
    color:
      #333333;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.58rem;
  }

  /* ============================================================
     WATCH
  ============================================================ */

  .watch-link {
    display:
      inline-block;

    margin-top:
      2.5rem;

    color:
      #111111;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.54rem;

    letter-spacing:
      0.04em;

    text-decoration:
      none;

    text-transform:
      lowercase;
  }

  .watch-link::after {
    content:
      "";

    display:
      block;

    width:
      100%;

    height:
      1px;

    margin-top:
      0.28rem;

    background:
      #111111;

    transform:
      scaleX(
        0
      );

    transform-origin:
      right;

    transition:
      transform
        250ms ease;
  }

  .watch-link:hover::after {
    transform:
      scaleX(
        1
      );

    transform-origin:
      left;
  }

  /* ============================================================
     FUTURE
  ============================================================ */

  .future-section {
    border-top:
      1px solid
      #dcdcdc;
  }

  .future-heading {
    display:
      grid;

    grid-template-columns:
      minmax(
        0,
        1fr
      )
      320px;

    align-items:
      end;

    gap:
      4rem;

    padding:
      4.5rem
      0
      3rem;
  }

  .future-heading h2 {
    margin:
      0.65rem
      0
      0;

    color:
      #111111;

    font-family:
      "Inter",
      sans-serif;

    font-size:
      clamp(
        3.5rem,
        6vw,
        6.5rem
      );

    font-weight:
      400;

    line-height:
      0.88;

    letter-spacing:
      -0.065em;
  }

