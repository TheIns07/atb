---
const works = [
  {
    title: "Signalwave: La Idolatría Nostálgica del Siglo XXI",
    description:
      "Documental acerca del estilo de estética degradada inspirada en el vaporwave",
    image: "/images/Signalwave.jpg",
    link: "https://youtu.be/lH1kehduaes",
    stats: {
      views: "1.7k",
      likes: "133",
      duration: "33 min",
    },
  },
  {
    title: "Kraftwerk | Inicios de la Electrónica Moderna",
    description:
      "Película donde se comenta la carrera de Kraftwerk canción por canción",
    image: "/images/kraftwerk.jpg",
    link: "https://youtu.be/mJOw439YJNI",
    stats: {
      views: "337k",
      likes: "9.7k",
      duration: "92 min",
    },
  },
  {
    title: "Una Breve Historia del Álbum Conceptual",
    description:
      "Entendimiento del concepto en la música a lo largo de la historia",
    image: "/images/concept.png",
    link: "https://youtu.be/4i0i8vqY6RQ",
    stats: {
      views: "1.3k",
      likes: "77",
      duration: "18 min",
    },
  },
  {
    title:
      "El Peligro de la Estética Liminal: Hauntología y la Lenta Cancelación del Futuro",
    description:
      "Entendimiento de cómo los espacios liminales definen nuestro sentir actual",
    image: "/images/liminal.jpg",
    link: "https://youtu.be/KI3dAr2Yc_k",
    stats: {
      views: "2.9k",
      likes: "297",
      duration: "16 min",
    },
  },
  {
    title: "Nipper: El Perro Icónico",
    description:
      "Historia de Nipper, la mascota de RCA presente en numerosos dispositivos",
    image: "/images/nipper.png",
    link: "https://youtu.be/jhZn5LIUj4k",
    stats: {
      views: "8k",
      likes: "275",
      duration: "5 min",
    },
  },
  {
    title: "La Música de Huesos (URSS)",
    description:
      "Historia de los vinilos de radiografías con música occidental, producidos en la Unión Soviética",
    image: "/images/bones.png",
    link: "https://youtu.be/4i0i8vqY6RQ",
    stats: {
      views: "1.1k",
      likes: "48",
      duration: "7 min",
    },
  },
];

const futureWorks = [
  {
    title: "Vaporwave: La historia no contada",
    description:
      "Reboot del documental del 2016",
    progress: 70,
  },
];
---

<section
  class="portfolio"
  data-portfolio
>
  <div class="portfolio-shell">

    <!-- ======================================================
         TOP BAR
    ======================================================= -->

    <div class="topbar">
      <div class="topbar-group">
        <span class="leader"></span>

        <span>
          archivo audiovisual
        </span>
      </div>

      <div class="topbar-group topbar-right">

        <span class="leader"></span>
      </div>
    </div>

    <!-- ======================================================
         HEADER
    ======================================================= -->

    <header class="portfolio-header">
      <div class="header-main">
        <h2>
          Portafolio
          <br />
          audiovisual.
        </h2>
      </div>

      <div class="header-copy">
        <p>
          Documentales, piezas y ensayos audiovisuales que
          forman parte del archivo de ATB.
        </p>
      </div>
    </header>

    <!-- ======================================================
         ARCHIVE
    ======================================================= -->

    <section class="archive-section">
      <div class="section-line">
      </div>

      <div class="archive-list">
        {
          works.map(
            (
              work,
              index,
            ) => {
              const number =
                String(
                  index + 1,
                ).padStart(
                  2,
                  "0",
                );

              const panelId =
                `work-panel-${index}`;

              return (
                <article
                  class:list={[
                    "archive-item",
                    {
                      "is-open":
                        index === 0,
                    },
                  ]}
                  data-work-item
                >
                  <!-- =========================================
                       ROW
                  ========================================== -->

                  <button
                    type="button"
                    class="archive-row"
                    data-work-toggle
                    aria-expanded={
                      index === 0
                        ? "true"
                        : "false"
                    }
                    aria-controls={
                      panelId
                    }
                  >
                    <span class="archive-number">
                      {number}
                    </span>

                    <span class="archive-title">
                      {work.title}
                    </span>

                    <span class="archive-type">
                      documental
                    </span>

                    <span class="archive-duration">
                      {work.stats.duration}
                    </span>

                    <span
                      class="archive-toggle"
                      aria-hidden="true"
                    >
                      <span class="toggle-closed">
                        +
                      </span>

                      <span class="toggle-open">
                        −
                      </span>
                    </span>
                  </button>

                  <!-- =========================================
                       EXPANDED INFORMATION
                  ========================================== -->

                  <div
                    id={panelId}
                    class="archive-detail"
                    data-work-detail
                    hidden={
                      index !== 0
                    }
                  >
                    <div class="detail-inner">

                      <!-- IMAGE -->

                      <a
                        href={work.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="detail-image-link"
                        aria-label={`Ver ${work.title} en YouTube`}
                      >
                        <div class="detail-image-shell">
                          <img
                            src={work.image}
                            alt={work.title}
                            class="detail-image"
                            loading={
                              index === 0
                                ? "eager"
                                : "lazy"
                            }
                          />

                          <span class="detail-image-number">
                            {number}
                          </span>

                          <span class="detail-image-open">
                            ↗
                          </span>
                        </div>
                      </a>

                      <!-- INFORMATION -->

                      <div class="detail-copy">
                        <div class="detail-meta">
                          <span>
                            documental
                          </span>

                          <span>
                            youtube
                          </span>
                        </div>

                        <h3>
                          {work.title}
                        </h3>

                        <p class="detail-description">
                          {work.description}
                        </p>

                        <div class="detail-stats">
                          <div>
                            <span class="stat-label">
                              vistas
                            </span>

                            <span class="stat-value">
                              {work.stats.views}
                            </span>
                          </div>

                          <div>
                            <span class="stat-label">
                              me gusta
                            </span>

                            <span class="stat-value">
                              {work.stats.likes}
                            </span>
                          </div>

                          <div>
                            <span class="stat-label">
                              duración
                            </span>

                            <span class="stat-value">
                              {work.stats.duration}
                            </span>
                          </div>
                        </div>

                        <a
                          href={work.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="watch-link"
                        >
                          ver documental ↗
                        </a>
                      </div>

                    </div>
                  </div>
                </article>
              );
            },
          )
        }
      </div>
    </section>

    <!-- ======================================================
         IN PROGRESS
    ======================================================= -->

    <section class="future-section">
      <div class="future-heading">
        <div>
          <span class="micro-label">
            producción actual
          </span>

          <h2>
            En progreso.
          </h2>
        </div>

        <p>
          Proyectos actualmente en desarrollo dentro
          del archivo de ATB.
        </p>
      </div>

      <div class="future-list">
        {
          futureWorks.map(
            (
              work,
              index,
            ) => (
              <article class="future-row">
                <span class="future-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <div class="future-project">
                  <span class="micro-label">
                    documental
                  </span>

                  <h3>
                    {work.title}
                  </h3>

                  <p>
                    {work.description}
                  </p>
                </div>

                <div class="future-progress">
                  <div class="progress-meta">
                    <span>
                      avance
                    </span>

                    <span>
                      {work.progress}%
                    </span>
                  </div>

                  <div class="progress-track">
                    <div
                      class="progress-fill"
                      style={`width: ${work.progress}%`}
                    ></div>
                  </div>
                </div>
              </article>
            ),
          )
        }
      </div>
    </section>

  </div>

  <!-- ========================================================
       INTERACTION
  ========================================================= -->

  <script>
    function initializePortfolio(): void {
      const portfolio =
        document.querySelector<HTMLElement>(
          "[data-portfolio]",
        );

      if (!portfolio) {
        return;
      }

      if (
        portfolio.dataset
          .initialized ===
        "true"
      ) {
        return;
      }

      portfolio.dataset
        .initialized =
        "true";

      const items =
        Array.from(
          portfolio.querySelectorAll<HTMLElement>(
            "[data-work-item]",
          ),
        );

      items.forEach(
        (
          item,
        ) => {
          const button =
            item.querySelector<HTMLButtonElement>(
              "[data-work-toggle]",
            );

          const detail =
            item.querySelector<HTMLElement>(
              "[data-work-detail]",
            );

          if (
            !button ||
            !detail
          ) {
            return;
          }

          button.addEventListener(
            "click",
            () => {
              const isOpen =
                item.classList.contains(
                  "is-open",
                );

              /*
                Close every item first.
                This keeps the archive concise.
              */

              items.forEach(
                (
                  otherItem,
                ) => {
                  const otherButton =
                    otherItem.querySelector<HTMLButtonElement>(
                      "[data-work-toggle]",
                    );

                  const otherDetail =
                    otherItem.querySelector<HTMLElement>(
                      "[data-work-detail]",
                    );

                  otherItem.classList.remove(
                    "is-open",
                  );

                  if (
                    otherButton
                  ) {
                    otherButton.setAttribute(
                      "aria-expanded",
                      "false",
                    );
                  }

                  if (
                    otherDetail
                  ) {
                    otherDetail.hidden =
                      true;
                  }
                },
              );

              /*
                Clicking the already-open
                item closes it.
              */

              if (
                isOpen
              ) {
                return;
              }

              item.classList.add(
                "is-open",
              );

              button.setAttribute(
                "aria-expanded",
                "true",
              );

              detail.hidden =
                false;
            },
          );
        },
      );
    }

    initializePortfolio();

    document.addEventListener(
      "astro:page-load",
      initializePortfolio,
    );
  </script>
</section>

<style>
  /* ============================================================
     ROOT
  ============================================================ */

  .portfolio {
    width:
      100%;

    padding:
      2rem
      0
      9rem;

    background:
      #ffffff;

    color:
      #111111;
  }

  .portfolio-shell {
    width:
      min(
        1440px,
        calc(
          100% - 5rem
        )
      );

    margin:
      0 auto;
  }

  /* ============================================================
     TOP BAR
  ============================================================ */

  .topbar {
    display:
      grid;

    grid-template-columns:
      1fr
      1fr;

    gap:
      4rem;

    padding-bottom:
      1rem;

    border-bottom:
      1px solid
      #dddddd;

    color:
      #858585;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.5rem;

    line-height:
      1;

    letter-spacing:
      0.07em;

    text-transform:
      lowercase;
  }

  .topbar-group {
    display:
      flex;

    align-items:
      center;

    min-width:
      0;
  }

  .topbar-right {
    text-align:
      right;
  }

  .leader {
    flex:
      1;

    min-width:
      2rem;

    margin:
      0
      0.7rem;

    border-bottom:
      1px dotted
      #bebebe;

    transform:
      translateY(
        -1px
      );
  }

  /* ============================================================
     HEADER
  ============================================================ */

  .portfolio-header {
    display:
      grid;

    grid-template-columns:
      minmax(
        0,
        1.25fr
      )
      minmax(
        280px,
        0.55fr
      );

    align-items:
      end;

    gap:
      clamp(
        3rem,
        8vw,
        9rem
      );

    padding:
      8rem
      0
      7rem;
  }

  .micro-label {
    color:
      #8e8e8e;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.5rem;

    line-height:
      1.3;

    letter-spacing:
      0.07em;

    text-transform:
      lowercase;
  }

  .header-main h2 {
    margin:
      1rem
      0
      0;

    color:
      #111111;

    font-family:
      "Inter",
      sans-serif;

    font-size:
      clamp(
        4.5rem,
        8vw,
        9rem
      );

    font-weight:
      400;

    line-height:
      0.84;

    letter-spacing:
      -0.07em;
  }

  .header-copy {
    padding-bottom:
      0.4rem;
  }

  .header-copy > p {
    max-width:
      390px;

    margin:
      0;

    color:
      #6e6e6e;

    font-family:
      "Inter",
      sans-serif;

    font-size:
      0.74rem;

    line-height:
      1.7;
  }

  .header-meta {
    display:
      flex;

    justify-content:
      space-between;

    gap:
      2rem;

    margin-top:
      2rem;

    padding-top:
      0.8rem;

    border-top:
      1px solid
      #e3e3e3;

    color:
      #8a8a8a;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.48rem;

    letter-spacing:
      0.05em;

    text-transform:
      lowercase;
  }

  /* ============================================================
     SECTION LINE
  ============================================================ */

  .section-line {
    display:
      flex;

    justify-content:
      space-between;

    align-items:
      center;

    padding:
      0.9rem
      0;

    border-top:
      1px solid
      #dcdcdc;

    border-bottom:
      1px solid
      #dcdcdc;

    color:
      #888888;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.5rem;

    letter-spacing:
      0.06em;

    text-transform:
      lowercase;
  }

  /* ============================================================
     ARCHIVE
  ============================================================ */

  .archive-section {
    margin-bottom:
      9rem;
  }

  .archive-item {
    border-bottom:
      1px solid
      #e2e2e2;
  }

  /* ============================================================
     ROW
  ============================================================ */

  .archive-row {
    display:
      grid;

    grid-template-columns:
      55px
      minmax(
        0,
        1fr
      )
      140px
      80px
      30px;

    align-items:
      center;

    width:
      100%;

    min-height:
      3.5rem;

    padding:
      0;

    border:
      0;

    background:
      transparent;

    color:
      #454545;

    cursor:
      pointer;

    text-align:
      left;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.54rem;

    line-height:
      1.25;

    transition:
      background
        180ms ease,
      color
        180ms ease;
  }

  .archive-row:hover {
    background:
      #fafafa;

    color:
      #111111;
  }

  .archive-row:focus-visible {
    outline:
      1px solid
      #888888;

    outline-offset:
      -1px;
  }

  .archive-number {
    color:
      #a0a0a0;
  }

  .archive-title {
    overflow:
      hidden;

    padding-right:
      2rem;

    text-overflow:
      ellipsis;

    white-space:
      nowrap;
  }

  .archive-type,
  .archive-duration {
    color:
      #868686;

    text-align:
      right;

    text-transform:
      lowercase;
  }

  .archive-toggle {
    text-align:
      right;

    color:
      #888888;

    font-size:
      0.72rem;
  }

  .toggle-open {
    display:
      none;
  }

  .archive-item.is-open
    .toggle-closed {
    display:
      none;
  }

  .archive-item.is-open
    .toggle-open {
    display:
      inline;
  }

  /* ============================================================
     DETAIL
  ============================================================ */

  .archive-detail {
    overflow:
      hidden;
  }

  .archive-detail[hidden] {
    display:
      none;
  }

  .detail-inner {
    display:
      grid;

    grid-template-columns:
      minmax(
        0,
        0.9fr
      )
      minmax(
        300px,
        1.1fr
      );

    gap:
      clamp(
        3rem,
        7vw,
        8rem
      );

    padding:
      2.5rem
      55px
      4rem;
  }

  /* ============================================================
     DETAIL IMAGE
  ============================================================ */

  .detail-image-link {
    display:
      block;

    align-self:
      start;

    color:
      inherit;

    text-decoration:
      none;
  }

  .detail-image-shell {
    position:
      relative;

    width:
      100%;

    aspect-ratio:
      16 / 10;

    overflow:
      hidden;

    background:
      #f3f3f3;
  }

  .detail-image {
    display:
      block;

    width:
      100%;

    height:
      100%;

    object-fit:
      cover;

    transition:
      transform
        650ms
        cubic-bezier(
          0.22,
          1,
          0.36,
          1
        );
  }

  .detail-image-link:hover
    .detail-image {
    transform:
      scale(
        1.018
      );
  }

  .detail-image-number,
  .detail-image-open {
    position:
      absolute;

    z-index:
      2;

    top:
      0.8rem;

    color:
      #ffffff;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.48rem;

    letter-spacing:
      0.06em;

    mix-blend-mode:
      difference;
  }

  .detail-image-number {
    left:
      0.8rem;
  }

  .detail-image-open {
    right:
      0.8rem;
  }

  /* ============================================================
     DETAIL COPY
  ============================================================ */

  .detail-copy {
    display:
      flex;

    flex-direction:
      column;

    align-items:
      flex-start;

    padding:
      0.2rem
      0;
  }

  .detail-meta {
    display:
      flex;

    gap:
      0.65rem;

    color:
      #919191;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size:
      0.48rem;

    letter-spacing:
      0.06em;

    text-transform:
      lowercase;
  }

  .detail-meta
    span + span::before {
    content:
      "/";

    margin-right:
      0.65rem;

    color:
      #c0c0c0;
  }

  .detail-copy h3 {
    max-width:
      640px;

    margin:
      1.2rem
      0
      0;

    color:
      #111111;

    font-family:
      "Inter",
      sans-serif;

    font-size:
      clamp(
        1.7rem,
        2.8vw,
        3rem
      );

    font-weight:
      400;

    line-height:
      1;

    letter-spacing:
      -0.045em;
  }

  .detail-description {
    max-width:
      510px;

    margin:
      1.6rem
      0
      0;

    color:
      #666666;

    font-family:
      "Inter",
      sans-serif;

    font-size:
      0.75rem;

    line-height:
      1.7;
  }

  /* ============================================================
     STATS
  ============================================================ */

  .detail-stats {
    display:
      grid;

    grid-template-columns:
      repeat(
        3,
        minmax(
          0,
          1fr
        )
      );

    width:
      100%;

    max-width:
      510px;

    margin-top:
      2.7rem;

    border-top:
      1px solid
      #dddddd;

    border-bottom:
      1px solid
      #dddddd;
  }

  .detail-stats > div {
    display:
      flex;

    flex-direction:
      column;

    gap:
      0.5rem;

    padding:
      0.85rem
      0;

    border-right:
      1px solid
      #e3e3e3;
  }

  .detail-stats > div:not(
    :first-child
