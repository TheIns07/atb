  function createModel(
    source:
      THREE.Group,

    targetHeight:
      number,
  ): THREE.Group {
    /*
     * clone(true) mantiene geometrías y materiales
     * compartidos.
     *
     * Esto consume bastante menos RAM que clonar
     * todos los materiales para cada CRT/palmera.
     */
    const model =
      source.clone(
        true,
      );

    const wrapper =
      new THREE.Group();

    model.traverse(
      (
        object:
          THREE.Object3D,
      ) => {
        if (
          !(
            object instanceof
            THREE.Mesh
          )
        ) {
          return;
        }

        object.castShadow =
          false;

        object.receiveShadow =
          false;
      },
    );

    const box =
      new THREE.Box3()
        .setFromObject(
          model,
        );

    const size =
      new THREE.Vector3();

    box.getSize(
      size,
    );

    if (
      size.y >
      0
    ) {
      model.scale.setScalar(
        targetHeight /
          size.y,
      );
    }

    const normalized =
      new THREE.Box3()
        .setFromObject(
          model,
        );

    const center =
      new THREE.Vector3();

    normalized.getCenter(
      center,
    );

    model.position.x -=
      center.x;

    model.position.z -=
      center.z;

    model.position.y -=
      normalized.min.y;

    wrapper.add(
      model,
    );

    return wrapper;
  }

  function cleanBuilding(
    root:
      THREE.Object3D,
  ): void {
    let materialIndex =
      0;

    root.traverse(
      (
        object:
          THREE.Object3D,
      ) => {
        if (
          !(
            object instanceof
            THREE.Mesh
          )
        ) {
          return;
        }

        object.geometry
          .computeVertexNormals();

        const tone =
          materialIndex %
            3 ===
          0
            ? 0xe2e4e4
            : materialIndex %
                3 ===
              1
              ? 0xeff0ee
              : 0xd7dadb;

        object.material =
          new THREE.MeshStandardMaterial({
            color:
              tone,

            roughness:
              0.82,

            metalness:
              0.01,

            depthTest:
              true,

            depthWrite:
              true,

            dithering:
              true,

            polygonOffset:
              true,

            polygonOffsetFactor:
              1 +
              materialIndex *
                0.012,

            polygonOffsetUnits:
              1 +
              materialIndex *
                0.025,
          });

        materialIndex +=
          1;
      },
    );
  }

  function improveAssetMaterials(
    root:
      THREE.Object3D,
  ): void {
    root.traverse(
      (
        object:
          THREE.Object3D,
      ) => {
        if (
          !(
            object instanceof
            THREE.Mesh
          )
        ) {
          return;
        }

        const materials:
          THREE.Material[] =
          Array.isArray(
            object.material,
          )
            ? object.material
            : [
                object.material,
              ];

        materials.forEach(
          (
            material,
          ) => {
            material.depthTest =
              true;

            material.depthWrite =
              true;

            if (
              material instanceof
              THREE.MeshStandardMaterial
            ) {
              material.dithering =
                true;

              if (
                material.map !==
                null
              ) {
                material.map.colorSpace =
                  THREE.SRGBColorSpace;

                material.map.anisotropy =
                  Math.min(
                    renderer
                      .capabilities
                      .getMaxAnisotropy(),

                    isMobile
                      ? 2
                      : 8,
                  );

                material.map.minFilter =
                  THREE.LinearMipmapLinearFilter;

                material.map.magFilter =
                  THREE.LinearFilter;
              }
            }
          },
        );
      },
    );
  }

  function applyMarble(
    root:
      THREE.Object3D,
  ): void {
    root.traverse(
      (
        object:
          THREE.Object3D,
      ) => {
        if (
          object instanceof
          THREE.Mesh
        ) {
          object.material =
            marbleMaterial.clone();
        }
      },
    );
  }

  /* ========================================================
     DISPOSAL
  ======================================================== */

  function disposeTexture(
    texture:
      THREE.Texture,
  ): void {
    texture.dispose();

    const image:
      unknown =
      texture.image;

    if (
      typeof ImageBitmap !==
        "undefined" &&
      image instanceof
        ImageBitmap
    ) {
      image.close();
    }
  }

  function disposeObjectResources(
    root:
      THREE.Object3D,
  ): void {
    const geometries =
      new Set<
        THREE.BufferGeometry
      >();

    const materials =
      new Set<
        THREE.Material
      >();

    const textures =
      new Set<
        THREE.Texture
      >();

    root.traverse(
      (
        object:
          THREE.Object3D,
      ) => {
        if (
          !(
            object instanceof
            THREE.Mesh
          )
        ) {
          return;
        }

        if (
          !geometries.has(
            object.geometry,
          )
        ) {
          object.geometry.dispose();

          geometries.add(
            object.geometry,
          );
        }

        const meshMaterials:
          THREE.Material[] =
          Array.isArray(
            object.material,
          )
            ? object.material
            : [
                object.material,
              ];

        meshMaterials.forEach(
          (
            material,
          ) => {
            if (
              materials.has(
                material,
              )
            ) {
              return;
            }

            Object.values(
              material,
            ).forEach(
              (
                value:
                  unknown,
              ) => {
                if (
                  value instanceof
                    THREE.Texture &&
                  !textures.has(
                    value,
                  )
                ) {
                  disposeTexture(
                    value,
                  );

                  textures.add(
                    value,
                  );
                }
              },
            );

            material.dispose();

            materials.add(
              material,
            );
          },
        );
      },
    );
  }

  function disposeExperienceWorld():
    void {
    worldAnimations.forEach(
      (
        animation,
      ) => {
        animation.kill();
      },
    );

    worldAnimations.length =
      0;

    albumHitboxes.length =
      0;

    archiveDolphin =
      null;

    if (
      worldGroup !==
      null
    ) {
      disposeObjectResources(
        worldGroup,
      );

      scene.remove(
        worldGroup,
      );

      worldGroup.clear();

      worldGroup =
        null;
    }

    resolvedModelSources.forEach(
      (
        source,
      ) => {
        disposeObjectResources(
          source,
        );
      },
    );

    resolvedModelSources.clear();

    placementFlags.clear();

    renderer.renderLists.dispose();

    THREE.Cache.clear();
  }

  /* ========================================================
     ALBUM EXHIBITS
  ======================================================== */

  function createExhibit(
    index:
      number,

    texture:
      THREE.Texture |
      null,

    x:
      number,

    y:
      number,

    z:
      number,
  ): void {
    if (
      worldGroup ===
      null
    ) {
      return;
    }

    const work =
      works[
        index
      ];

    if (
      work ===
      undefined
    ) {
      return;
    }

    const xPosition =
      worldX(
        x,
      );

    const yPosition =
      isMobile
        ? y + 0.35
        : y;

    const group =
      new THREE.Group();

    const direction =
      index %
        2 ===
      0
        ? 1
        : -1;

    const baseRotation =
      xPosition <
      0
        ? 0.07
        : -0.07;

    group.position.set(
      xPosition,
      yPosition,
      z,
    );

    group.rotation.y =
      baseRotation;

    if (
      isMobile
    ) {
      group.scale.setScalar(
        0.78,
      );
    }

    const backing =
      new THREE.Mesh(
        new THREE.BoxGeometry(
          6.45,
          6.45,
          0.14,
        ),

        new THREE.MeshStandardMaterial({
          color:
            0x101113,

          roughness:
            0.58,
        }),
      );

    group.add(
      backing,
    );

    const cover =
      new THREE.Mesh(
        new THREE.PlaneGeometry(
          6.12,
          6.12,
        ),

        new THREE.MeshBasicMaterial({
          color:
            0xffffff,

          map:
            texture,
        }),
      );

    cover.position.z =
      0.08;

    group.add(
      cover,
    );

    const hitbox =
      new THREE.Mesh(
        new THREE.PlaneGeometry(
          8.5,
          8.5,
        ),

        new THREE.MeshBasicMaterial({
          transparent:
            true,

          opacity:
            0,

          depthWrite:
            false,
        }),
      );

    hitbox.position.z =
      0.55;

    hitbox.userData.workIndex =
      index;

    group.add(
      hitbox,
    );

    albumHitboxes.push(
      hitbox,
    );

    worldGroup.add(
      group,
    );

    const movementScale =
      isMobile
        ? 0.55
        : 1;

    const movement =
      gsap.timeline({
        repeat:
          -1,

        delay:
          index *
          0.085,
      });

    movement
      .to(
        group.position,
        {
          x:
            xPosition +
            0.82 *
              direction *
              movementScale,

          y:
            yPosition +
            0.56,

          z:
            z +
            0.26,

          duration:
            0.92,

          ease:
            "sine.inOut",
        },
      )

      .to(
        group.position,
        {
          x:
            xPosition -
            0.4 *
              direction *
              movementScale,

          y:
            yPosition -
            0.24,

          z:
            z -
            0.2,

          duration:
            0.64,

          ease:
            "sine.inOut",
        },
      )

      .to(
        group.position,
        {
          x:
            xPosition,

          y:
            yPosition,

          z,

          duration:
            0.96,

          ease:
            "sine.inOut",
        },
      );

    const rotation =
      gsap.timeline({
        repeat:
          -1,

        delay:
          index *
          0.06,
      });

    rotation
      .to(
        group.rotation,
        {
          x:
            0.06,

          y:
            baseRotation +
            0.09 *
              direction,

          z:
            0.045 *
            direction,

          duration:
            0.9,

          ease:
            "sine.inOut",
        },
      )

      .to(
        group.rotation,
        {
          x:
            -0.035,

          y:
            baseRotation -
            0.054 *
              direction,

          z:
            -0.03 *
            direction,

          duration:
            0.66,

          ease:
            "sine.inOut",
        },
      )

      .to(
        group.rotation,
        {
          x:
            0,

          y:
            baseRotation,

          z:
            0,

          duration:
