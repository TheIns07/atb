---
const documentaryUrl = "https://www.youtube.com/";
---

<section id="vaporwave-hero" class="vaporwave-root">
    <canvas
        id="vaporwave-webgl"
        class="vaporwave-canvas"
        aria-hidden="true"
    ></canvas>

    <!-- Luz ambiental de la portada -->
    <div
        id="sky-light-layer"
        class="sky-light-layer"
        aria-hidden="true"
    >
        <div class="sky-glow sky-glow-a"></div>
        <div class="sky-glow sky-glow-b"></div>
        <div class="sky-glow sky-glow-c"></div>
    </div>

    <div class="screen-vignette"></div>
    <div class="screen-lines"></div>
    <div class="screen-noise"></div>

    <!-- =====================================================
         LANDING
    ====================================================== -->

    <div
        id="vaporwave-content"
        class="vaporwave-landing"
    >
        <div class="landing-inner">
            <h1 class="landing-title">
                VAPORWAVE
            </h1>

            <p class="landing-subtitle">
                LA HISTORIA NO CONTADA
            </p>

            <div class="landing-actions">
                <button
                    id="vaporwave-enter"
                    type="button"
                    class="landing-button"
                >
                    ENTRAR A LA EXPERIENCIA
                </button>
            </div>
        </div>
    </div>

    <!-- =====================================================
         LOADING
    ====================================================== -->

    <div
        id="experience-loader"
        class="experience-loader hidden"
        aria-hidden="true"
    >
        <div class="loader-white"></div>

        <div class="loader-copy">
            <div
                id="experience-word"
                class="experience-word"
            >
                読み込み中
            </div>

            <div
                id="experience-load-progress"
                class="experience-load-progress"
            >
                000
            </div>
        </div>
    </div>

    <!-- =====================================================
         HUD
    ====================================================== -->

    <div
        id="experience-ui"
        class="experience-ui"
        aria-hidden="true"
    >
        <button
            id="experience-exit"
            type="button"
            class="experience-exit"
            aria-label="Salir"
        >
            ×
        </button>

        <div
            id="experience-year"
            class="experience-year"
        >
            2009
        </div>

        <!-- MINI PLAYER -->

        <aside
            id="youtube-player-dock"
            class="youtube-player-dock hidden"
            aria-hidden="true"
        >
            <img
                id="youtube-player-cover"
                class="player-cover"
                src=""
                alt=""
            />

            <div class="player-information">
                <h3
                    id="youtube-player-title"
                    class="player-title"
                >
                    —
                </h3>

                <p
                    id="youtube-player-artist"
                    class="player-artist"
                >
                    —
                </p>
            </div>

            <button
                id="youtube-player-toggle"
                class="player-toggle"
                type="button"
                aria-label="Pausar"
            >
                <span class="player-icon-play"></span>

                <span class="player-icon-pause">
                    <i></i>
                    <i></i>
                </span>
            </button>

            <button
                id="youtube-player-close"
                class="player-close"
                type="button"
                aria-label="Cerrar reproductor"
            >
                ×
            </button>

            <div
                id="youtube-api-host"
                class="youtube-api-host"
                aria-hidden="true"
            >
                <div id="youtube-player-mount"></div>
            </div>
        </aside>
    </div>

    <!-- =====================================================
         ALBUM MODAL
    ====================================================== -->

    <div
        id="album-modal"
        class="album-modal hidden"
        aria-hidden="true"
        role="dialog"
        aria-modal="true"
    >
        <div
            id="album-modal-backdrop"
            class="album-modal-backdrop"
        ></div>

        <article
            id="album-card"
            class="album-card"
        >
            <button
                id="album-modal-close"
                type="button"
                class="album-close"
                aria-label="Cerrar"
            >
                ×
            </button>

            <div class="album-cover-area">
                <img
                    id="album-modal-image"
                    class="album-cover-image"
                    src=""
                    alt=""
                />

                <div class="album-cover-lines"></div>
            </div>

            <div class="album-information">
                <span
                    id="album-modal-year"
                    class="album-year"
                ></span>

                <h2
                    id="album-modal-title"
                    class="album-title"
                ></h2>

                <p
                    id="album-modal-artist"
                    class="album-artist"
                ></p>

                <div class="album-rule"></div>

                <p
                    id="album-modal-summary"
                    class="album-summary"
                ></p>

                <div class="album-review">
                    <p
                        id="album-modal-press"
                        class="album-review-text"
                    ></p>

                    <p
                        id="album-modal-source"
                        class="album-review-source"
                    ></p>
                </div>

                <button
                    id="album-modal-play"
                    class="album-play"
                    type="button"
                    aria-label="Reproducir álbum"
                >
                    <span class="play-symbol"></span>
                </button>
            </div>
        </article>
    </div>

    <!-- =====================================================
         TV ENDING
    ====================================================== -->

    <div
        id="no-signal"
        class="no-signal hidden"
        aria-hidden="true"
    >
        <div class="tv-bars">
            <span class="bar-white"></span>
            <span class="bar-yellow"></span>
            <span class="bar-cyan"></span>
            <span class="bar-green"></span>
            <span class="bar-magenta"></span>
            <span class="bar-red"></span>
            <span class="bar-blue"></span>
        </div>

        <div class="tv-middle">
            <span class="small-blue"></span>
            <span class="small-black"></span>
            <span class="small-magenta"></span>
            <span class="small-black"></span>
            <span class="small-cyan"></span>
            <span class="small-black"></span>
            <span class="small-gray"></span>
        </div>

        <div class="tv-bottom">
            <span class="bottom-cyan"></span>
            <span class="bottom-white"></span>
            <span class="bottom-blue"></span>
            <span class="bottom-black"></span>
        </div>

        <div class="tv-static"></div>
        <div class="tv-scanlines"></div>
    </div>
</section>

