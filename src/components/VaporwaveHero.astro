  /* ========================================================
     YEAR
  ======================================================== */

  function animateYear(
    value:
      string,
  ): void {
    if (
      value ===
      displayedYear
    ) {
      return;
    }

    displayedYear =
      value;

    gsap.killTweensOf(
      yearLabel,
    );

    gsap.timeline()

      .to(
        yearLabel,
        {
          opacity:
            0,

          y:
            7,

          filter:
            "blur(3px)",

          duration:
            0.13,

          ease:
            "power2.in",
        },
      )

      .add(
        () => {
          yearLabel.textContent =
            value;
        },
      )

      .fromTo(
        yearLabel,

        {
          opacity:
            0,

          y:
            -7,

          filter:
            "blur(4px)",
        },

        {
          opacity:
            1,

          y:
            0,

          filter:
            "blur(0px)",

          duration:
            0.3,

          ease:
            "power3.out",
        },
      );
  }

  function updateHud(
    index:
      number,
  ): void {
    const work =
      works[
        index
      ];

    if (
      work ===
      undefined
    ) {
      return;
    }

    currentIndex =
      index;

    animateYear(
      work.year,
    );
  }

  function resetHud():
    void {
    displayedYear =
      "2009";

    currentIndex =
      0;

    yearLabel.textContent =
      "2009";

    gsap.set(
      yearLabel,
      {
        opacity:
          1,

        y:
          0,

        filter:
          "blur(0px)",
      },
