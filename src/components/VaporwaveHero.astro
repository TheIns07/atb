    function loadModel(
        url:
            string,
    ): Promise<
        THREE.Group |
        null
    > {

        return new Promise<
            THREE.Group |
            null
        >(
            (
                resolve,
            ) => {

                gltfLoader.load(
                    url,

                    (
                        gltf,
                    ) => {

                        resolve(
                            gltf.scene,
                        );
                    },

                    undefined,

                    (
                        error:
                            unknown,
                    ) => {

                        console.warn(
                            `[Vaporwave] Could not load ${url}`,
                            error,
                        );

                        resolve(
                            null,
                        );
                    },
                );
            },
        );
    }

    function loadTexture(
        url:
            string,
    ): Promise<
        THREE.Texture |
        null
    > {

        return new Promise<
            THREE.Texture |
            null
        >(
            (
                resolve,
            ) => {

                textureLoader.load(
                    url,

                    (
                        texture:
                            THREE.Texture,
                    ) => {

                        texture.colorSpace =
                            THREE.SRGBColorSpace;

                        texture.anisotropy =
                            Math.min(
                                renderer.capabilities
                                    .getMaxAnisotropy(),

                                isMobile
                                    ? 4
                                    : 16,
                            );

                        resolve(
                            texture,
                        );
                    },

                    undefined,

                    () => {

                        resolve(
                            null,
                        );
                    },
                );
            },
        );
    }

