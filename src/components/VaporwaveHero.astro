    /* ============================================================
       BUILD ONE SKYLINE MODEL
    ============================================================ */

    function addPreparedBuilding(
      source: THREE.Group,

      placement: BuildingPlacement,
    ): void {
      const model = createModel(source, worldHeight(placement.height));

      prepareBuilding(model);

      model.position.set(
        worldX(placement.x),

        -3 - placement.bury,

        placement.z,
      );

      model.rotation.y = placement.rotation;

      /*
       * Empieza ligeramente hundido.
       * Durante reveal sube suavemente.
       */
      model.userData.finalY = model.position.y;

      model.position.y -= 1.35;

      skylineGroup.add(model);
    }

    /* ============================================================
       BUILDING WARMUP + REVEAL

       Importante:

       NO aparece build1 y después build2...

       Esperamos las 8 fuentes.
       Construimos todo.
       Compilamos.
       Mostramos todo junto.
    ============================================================ */

    async function loadEntireSkyline(): Promise<void> {
      if (buildingsReady || revealStarted) {
        return;
      }

      const generation = worldGeneration;

      const keys = [
        "build1",
        "build2",
        "build3",
        "build4",
        "build5",
        "build6",
        "build7",
        "build8",
      ] as const;

      /*
       * Todos entran a la cola,
       * pero el scheduler sólo procesa 1/2 simultáneos.
       */
      const requests = keys.map((key, index) => requestModel(key, 150 - index));

      const results = await Promise.all(requests);

      if (generation !== worldGeneration) {
        return;
      }

      const loaded = new Map<(typeof keys)[number], THREE.Group>();

      keys.forEach((key, index) => {
        const result = results[index];

        if (result !== null && result !== undefined) {
          loaded.set(key, result);
        }
      });

      /*
       * Incluso si algún modelo falla,
       * revelamos el resto juntos.
       */
      buildingPlacements.forEach((placement) => {
        const source = loaded.get(placement.key);

        if (source === undefined) {
          return;
        }

        addPreparedBuilding(source, placement);
      });

      /*
       * Sigue invisible durante compilación.
       */
      skylineGroup.visible = false;

      setBuildingOpacity(0);

      await waitFrame();

      if (generation !== worldGeneration) {
        return;
      }

      /*
       * Forzamos shaders/programas antes
       * de que el usuario vea el skyline.
       */
      renderer.compile(scene, camera);

      renderer.render(scene, camera);

      await waitFrame();

      buildingWarmupDone = true;

      buildingsReady = true;

      revealSkyline();
    }

    /* ============================================================
       SKYLINE HEATWAVE REVEAL
    ============================================================ */

    function activateHeatwave(): void {
      heatwaveOverlay.classList.remove("is-active");

      /*
       * fuerza reflow para reiniciar animación
       */
      void heatwaveOverlay.offsetWidth;

      heatwaveOverlay.classList.add("is-active");

      window.setTimeout(() => {
        heatwaveOverlay.classList.remove("is-active");
      }, 1700);
    }

    function revealSkyline(): void {
      if (revealStarted || skylineGroup.children.length === 0) {
        return;
      }

      revealStarted = true;

      skylineRevealStart = performance.now();

      skylineGroup.visible = true;

      activateHeatwave();

      const reveal = (now: number): void => {
        if (sceneDisposed) {
          return;
        }

        const rawProgress = (now - skylineRevealStart) / skylineRevealDuration;

        const progress = clamp01(rawProgress);

        const eased = easeOutCubic(progress);

        /*
         * Fade simultáneo.
         */
        setBuildingOpacity(eased);

        /*
         * Los edificios emergen suavemente
         * como si la distancia estuviese vibrando.
         */
        skylineGroup.children.forEach((child, index) => {
          const finalY =
            typeof child.userData.finalY === "number"
              ? child.userData.finalY
              : child.position.y;

          const phase = index * 0.35;

          const ripple =
            Math.sin(progress * Math.PI * 2.4 + phase) * (1 - progress) * 0.18;

          child.position.y = finalY - (1 - eased) * 1.35 + ripple;
        });

        if (progress < 1) {
          requestAnimationFrame(reveal);

          return;
        }

        skylineGroup.children.forEach((child) => {
          const finalY = child.userData.finalY;

          if (typeof finalY === "number") {
            child.position.y = finalY;
          }
        });

        setBuildingOpacity(1);
      };

      requestAnimationFrame(reveal);
    }

