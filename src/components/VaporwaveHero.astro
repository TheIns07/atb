        /* =====================================================
           MODEL LOADER
        ====================================================== */

        function loadModel(
            url:
                string,
        ): Promise<THREE.Group | null> {

            return new Promise(
                (
                    resolve,
                ) => {

                    loader.load(

                        url,

                        (
                            gltf,
                        ) => {

                            resolve(
                                gltf.scene,
                            );

                        },

                        undefined,

                        (
                            error,
                        ) => {

                            console.warn(
                                `[Vaporwave] Could not load ${url}`,
                                error,
                            );

                            resolve(
                                null,
                            );

                        },

                    );

                },
            );

        }

        function createModel(
            source:
                THREE.Group,

            targetHeight:
                number,
        ) {

            const wrapper =
                new THREE.Group();

            const model =
                source.clone(
                    true,
                );

            model.traverse(
                (
                    object,
                ) => {

                    if (
                        !(
                            object instanceof
                            THREE.Mesh
                        )
                    ) {
                        return;
                    }

                    if (
                        Array.isArray(
                            object.material,
                        )
                    ) {

                        object.material =
                            object.material.map(
                                (
                                    material,
                                ) =>
                                    material.clone(),
                            );

                    } else {

                        object.material =
                            object.material.clone();

                    }

                    object.castShadow =
                        false;

                    object.receiveShadow =
                        false;

                },
            );

            const box =
                new THREE.Box3().setFromObject(
                    model,
                );

            const size =
                new THREE.Vector3();

            box.getSize(
                size,
            );

            if (
                size.y >
                0
            ) {

                model.scale.setScalar(
                    targetHeight /
                        size.y,
                );

            }

            const normalizedBox =
                new THREE.Box3().setFromObject(
                    model,
                );

            const center =
                new THREE.Vector3();

            normalizedBox.getCenter(
                center,
            );

            model.position.x -=
                center.x;

            model.position.z -=
                center.z;

            model.position.y -=
                normalizedBox.min.y;

            wrapper.add(
                model,
            );

            return wrapper;

        }

        /* =====================================================
           BUILDING MATERIAL FIX
        ====================================================== */

        function cleanBuilding(
            root:
                THREE.Object3D,

            tint:
                number,
        ) {

            let surfaceIndex =
                0;

            const baseColor =
                new THREE.Color(
                    tint,
                );

            root.traverse(
                (
                    object,
                ) => {

                    if (
                        !(
                            object instanceof
                            THREE.Mesh
                        )
                    ) {
                        return;
                    }

                    /*
                     * Recompute normals after OBJ -> GLB
                     * conversions.
                     */

                    object.geometry
                        ?.computeVertexNormals();

                    /*
                     * Replace problematic source materials.
                     *
                     * Many downloaded architecture models
                     * use low-resolution facade textures,
                     * alpha planes or overlapping materials.
                     *
                     * In this environment we only need the
                     * geometry itself.
                     */

                    const material =
                        new THREE.MeshStandardMaterial({

                            color:
                                baseColor.clone(),

                            roughness:
                                0.78,

                            metalness:
                                0.015,

                            side:
                                THREE.FrontSide,

                            depthTest:
                                true,

                            depthWrite:
                                true,

                            dithering:
                                true,

                            polygonOffset:
                                true,

                            polygonOffsetFactor:
                                1 +
                                surfaceIndex *
                                    0.015,

                            polygonOffsetUnits:
                                1 +
                                surfaceIndex *
                                    0.05,

                        });

                    object.material =
                        material;

                    surfaceIndex +=
                        1;

                },
            );

        }

        function improveAssetMaterials(
            root:
                THREE.Object3D,
        ) {

            root.traverse(
                (
                    object,
                ) => {

                    if (
                        !(
                            object instanceof
                            THREE.Mesh
                        )
                    ) {
                        return;
                    }

                    const materials =
                        Array.isArray(
                            object.material,
                        )
                            ? object.material
                            : [
                                  object.material,
                              ];

                    materials.forEach(
                        (
                            material,
                        ) => {

                            if (
                                !(
                                    material instanceof
                                    THREE.MeshStandardMaterial
                                )
                            ) {
                                return;
                            }

                            material.depthTest =
                                true;

                            material.depthWrite =
                                true;

                            material.side =
                                THREE.FrontSide;

                            material.dithering =
                                true;

                            if (
                                material.map
                            ) {

                                material.map.anisotropy =
                                    renderer.capabilities
                                        .getMaxAnisotropy();

                                material.map.minFilter =
                                    THREE.LinearMipmapLinearFilter;

                                material.map.magFilter =
                                    THREE.LinearFilter;

                                material.map.generateMipmaps =
                                    true;

                                material.map.needsUpdate =
                                    true;

                            }

                        },
                    );

                },
            );

        }

