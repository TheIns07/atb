        }

        canvas.style.cursor =
            "default";

        camera.position.set(
            0,

            isMobile
                ? 3.8
                : 3.3,

            -900,
        );

        cameraTarget.set(
            0,

            isMobile
                ? 1.65
                : 2.05,

            -948,
        );

        endlessFloorMode =
            true;

        animateYear(
            "∞",
        );

        if (
            !playbackIsActive() ||
            playingAlbumIndex ===
                null
        ) {

            runNoSignal();

            return;
        }

        promoteSkyLightsToEndless();
    }

    /* ========================================================
       EXIT
    ======================================================== */

    async function leaveExperience():
        Promise<void> {

        if (
            transitioning
        ) {
            return;
        }

        transitioning =
            true;

        reachedEnd =
            false;

        endlessFloorMode =
            false;

        travelling =
            false;

        experienceActive =
            false;

        modalOpen =
            false;

        resetSkyLights();

        canvas.style.pointerEvents =
            "none";

        modal.classList.add(
            "hidden",
        );

        experienceUI.setAttribute(
            "aria-hidden",
            "true",
        );

        gsap.to(
            experienceUI,
            {
                opacity:
                    0,

                duration:
                    0.2,
            },
        );

        await new Promise<void>(
            (
                resolve,
            ) => {

                gsap.to(
                    canvas,
                    {
                        opacity:
                            0,

                        duration:
                            0.5,

                        ease:
                            "power2.inOut",

                        onComplete:
                            resolve,
                    },
                );
            },
        );

        destroyYoutubePlayer();

        disposeExperienceWorld();

        resetPalette();

        camera.position.copy(
            experienceStart,
        );

        cameraTarget.set(
            0,

            isMobile
                ? 1.65
                : 2.1,

            -45,
        );

        floorTexture.offset.set(
            0,
            0,
        );

        resetHud();

        content.style.pointerEvents =
            "auto";

        gsap.to(
            content,
            {
                opacity:
                    1,

                duration:
                    0.6,

                ease:
                    "power2.out",

                onComplete:
                    () => {

                        transitioning =
                            false;
                    },
            },
        );
    }

    exitButton.addEventListener(
        "click",
        () => {

            void leaveExperience();
        },
    );

    /* ========================================================
       NO SIGNAL
    ======================================================== */

    function runNoSignal():
        void {

        if (
            ending
        ) {
            return;
        }

        ending =
            true;

        travelling =
            false;

        endlessFloorMode =
            false;

        experienceActive =
            false;

        resetSkyLights();

        if (
            youtubePlayer !==
            null
        ) {

            try {

                youtubePlayer.pauseVideo();

            } catch (
                error:
                    unknown
            ) {

                console.warn(
                    error,
                );
            }
        }

        playerDock.classList.add(
            "hidden",
        );

        experienceUI.style.opacity =
            "0";

        canvas.style.pointerEvents =
            "none";

        noSignal.style.opacity =
            "1";

        noSignal.classList.remove(
            "hidden",
        );

        noSignal.setAttribute(
            "aria-hidden",
            "false",
        );

        window.setTimeout(
            () => {

                void transitionFromSignalToLanding();

            },
            1450,
        );
    }

    async function transitionFromSignalToLanding():
        Promise<void> {

        destroyYoutubePlayer();

        disposeExperienceWorld();

        resetPalette();

        camera.position.copy(
            experienceStart,
        );

        cameraTarget.set(
            0,

            isMobile
                ? 1.65
                : 2.1,

            -45,
        );

        floorTexture.offset.set(
            0,
            0,
        );

        resetHud();

        canvas.style.opacity =
            "0";

        experienceUI.style.opacity =
            "0";

        experienceUI.setAttribute(
            "aria-hidden",
            "true",
        );

        content.style.opacity =
            "1";

        content.style.pointerEvents =
            "auto";

        await nextFrame();

        gsap.to(
            noSignal,
            {
                opacity:
                    0,

                duration:
                    0.95,

                ease:
                    "power2.inOut",

                onComplete:
                    () => {

                        noSignal.classList.add(
                            "hidden",
                        );

                        noSignal.setAttribute(
                            "aria-hidden",
                            "true",
                        );

                        noSignal.style.opacity =
                            "1";

                        ending =
                            false;

                        travelling =
                            false;

                        experienceActive =
                            false;

                        endlessFloorMode =
                            false;

                        reachedEnd =
                            false;

                        modalOpen =
                            false;
                    },
            },
        );
    }

    /* ========================================================
       KEYBOARD
    ======================================================== */

    const handleKeyDown =
        (
            event:
                KeyboardEvent,
        ): void => {

            if (
                event.key !==
                "Escape"
            ) {
                return;
            }

            if (
                modalOpen
            ) {

                closeAlbum();

                return;
            }

            if (
                experienceActive
            ) {

                void leaveExperience();
            }
        };

    window.addEventListener(
        "keydown",
        handleKeyDown,
    );

    /* ========================================================
       LOOP
    ======================================================== */

    const clock =
        new THREE.Clock();

    let raf =
        0;

    function animate():
        void {

        raf =
            requestAnimationFrame(
                animate,
            );

        const delta =
            Math.min(
                clock.getDelta(),
                0.05,
            );

        const elapsed =
            clock.elapsedTime;

        if (
            archiveDolphin !==
                null &&
            worldGroup !==
                null &&
            worldGroup.visible
        ) {

            const baseY =
                isMobile
                    ? 5
                    : 6;

            archiveDolphin.position.y =
                baseY +
                Math.sin(
                    elapsed *
                        0.45,
                ) *
                    0.3;

            archiveDolphin.rotation.y =
                -0.7 +
                Math.sin(
                    elapsed *
                        0.25,
                ) *
                    0.22;
        }

        if (
            experienceActive &&
            travelling &&
            !modalOpen &&
            !ending
        ) {

            if (
                !endlessFloorMode
            ) {

                camera.position.z -=
                    travelSpeed *
                    delta;

                camera.position.x =
                    Math.sin(
                        elapsed *
                            0.14,
                    ) *
                    (
                        isMobile
                            ? 0.035
                            : 0.075
                    );

                const baseY =
                    isMobile
                        ? 3.8
                        : 3.3;

                camera.position.y =
                    baseY +
                    Math.sin(
                        elapsed *
                            0.32,
                    ) *
                        0.05;

                const rawIndex =
                    Math.round(
                        (
                            albumStartZ -
                            camera.position.z
                        ) /
                        albumSpacing,
                    );

                const nearest =
                    THREE.MathUtils.clamp(
                        rawIndex,
                        0,
                        works.length -
                            1,
                    );

                if (
                    nearest !==
                    currentIndex
                ) {

                    updateHud(
                        nearest,
                    );
                }

                cameraTarget.set(
                    camera.position.x *
                        0.02,

                    isMobile
                        ? 1.65
                        : 2.15,

                    camera.position.z -
                        (
                            isMobile
                                ? 40
                                : 48
                        ),
                );

                if (
                    camera.position.z <
                    timelineEndZ
                ) {

                    beginEndlessFloor();
                }
            }

            else {

                floorTexture.offset.y -=
                    delta *
                    (
                        isMobile
                            ? 0.42
                            : 0.52
                    );

                floorTexture.offset.x +=
                    Math.sin(
                        elapsed *
                            0.28,
                    ) *
                    delta *
                    0.012;

                camera.position.x =
                    Math.sin(
                        elapsed *
                            0.15,
                    ) *
                    0.05;

                camera.position.y =
                    (
                        isMobile
                            ? 3.8
                            : 3.3
                    ) +
                    Math.sin(
                        elapsed *
                            0.3,
                    ) *
                        0.045;

                cameraTarget.set(
                    camera.position.x *
                        0.03,

                    isMobile
                        ? 1.65
                        : 2.05,

                    -948,
                );
            }
        }

        camera.lookAt(
            cameraTarget,
        );

        renderer.render(
            scene,
            camera,
        );
    }

    animate();

    /* ========================================================
       RESIZE
    ======================================================== */

    const resizeObserver =
        new ResizeObserver(
            (
                _entries:
                    ResizeObserverEntry[],
            ) => {

                const width =
                    section.clientWidth;

                const height =
                    section.clientHeight;

                if (
                    width <=
                        0 ||
                    height <=
                        0
                ) {
                    return;
                }

                camera.aspect =
                    width /
                    height;

                camera.updateProjectionMatrix();

                renderer.setSize(
                    width,
                    height,
                    false,
                );

                renderer.setPixelRatio(
                    Math.min(
                        window.devicePixelRatio,

                        isMobile
                            ? 1.25
                            : 2,
                    ),
                );
            },
        );

    resizeObserver.observe(
        section,
    );

    /* ========================================================
       CLEANUP
    ======================================================== */

    window.addEventListener(
        "astro:before-swap",
        () => {

            cancelAnimationFrame(
                raf,
            );

            resizeObserver.disconnect();

            window.removeEventListener(
                "keydown",
                handleKeyDown,
            );

            destroyYoutubePlayer();

            disposeExperienceWorld();

            paletteTween?.kill();

            floor.geometry.dispose();

            floorMaterial.dispose();

            floorTexture.dispose();

            marbleMaterial.dispose();

            darkMaterial.dispose();

            renderer.dispose();
        },
        {
            once:
                true,
        },
    );
}

void initVaporwaveHero()
    .catch(
        (
            error:
                unknown,
        ) => {

            console.error(
                "[Vaporwave] Initialization failed:",
                error,
            );
        },
    );
</script>

