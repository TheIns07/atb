       * Cuando optimices dolphin.glb,
       * puedes quitar este return.
       */
      return;
    }

    if (
      placementFlags.has(
        "dolphin",
      )
    ) {
      return;
    }

    placementFlags.add(
      "dolphin",
    );

    const source =
      await loadModel(
        assets.dolphin,
        18,
        session,
      );

    if (
      !isCurrentSession(
        session,
      ) ||
      source ===
        null ||
      worldGroup ===
        null
    ) {
      return;
    }

    archiveDolphin =
      createModel(
        source,

        worldHeight(
          3.2,
