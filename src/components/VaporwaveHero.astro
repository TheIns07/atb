  function addBuilding(
    source:
      THREE.Group |
      null,

    x:
      number,

    z:
      number,

    height:
      number,

    rotation:
      number,

    bury:
      number =
      2,
  ): void {
    if (
      source ===
        null ||
      worldGroup ===
        null
    ) {
      return;
    }

    const building =
      createModel(
        source,

        worldHeight(
          height,
        ),
      );

    cleanBuilding(
      building,
    );

    building.position.set(
      worldX(
        x,
      ),

      -3 -
        bury,

      z,
    );

    building.rotation.y =
      rotation;

    worldGroup.add(
      building,
    );
  }

  function addColumn(
    source:
      THREE.Group |
      null,

    x:
      number,

    z:
      number,

    height:
