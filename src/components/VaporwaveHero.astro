        /* =====================================================
           LOOP
        ====================================================== */

        const clock =
            new THREE.Clock();

        let raf =
            0;

        function animate() {

            raf =
                requestAnimationFrame(
                    animate,
                );

            const delta =
                Math.min(
                    clock.getDelta(),
                    0.05,
                );

            const elapsed =
                clock.elapsedTime;

            if (
                archiveDolphin
            ) {

                archiveDolphin.position.y =
                    6 +
                    Math.sin(
                        elapsed *
                            0.45,
                    ) *
                        0.3;

                archiveDolphin.rotation.y =
                    -0.7 +
                    Math.sin(
                        elapsed *
                            0.25,
                    ) *
                        0.22;

            }

            if (
                experienceActive &&
                travelling &&
                !modalOpen &&
                !ending
            ) {

                camera.position.z -=
                    travelSpeed *
                    delta;

                /*
                 * Tiny natural drift.
                 */

                camera.position.x =
                    Math.sin(
                        elapsed *
                            0.14,
                    ) *
                    0.075;

                camera.position.y =
                    3.3 +
                    Math.sin(
                        elapsed *
                            0.32,
                    ) *
                        0.05;

                const rawIndex =
                    Math.round(
                        (
                            albumStartZ -
                            camera.position.z
                        ) /
                            albumSpacing,
                    );

                const nearest =
                    THREE.MathUtils.clamp(
                        rawIndex,
                        0,
                        works.length -
                            1,
                    );

                if (
                    nearest !==
                    currentIndex
                ) {

                    updateHud(
                        nearest,
                    );

                }

                cameraTarget.set(

                    camera.position.x *
                        0.02,

                    2.15,

                    camera.position.z -
                        48,

                );

                if (
                    camera.position.z <
                    -855
                ) {

                    runNoSignal();

                }

            }

            camera.lookAt(
                cameraTarget,
            );

            renderer.render(
                scene,
                camera,
            );

        }

        animate();

        /* =====================================================
           RESIZE
        ====================================================== */

        const resizeObserver =
            new ResizeObserver(
                () => {

                    const width =
                        section.clientWidth;

                    const height =
                        section.clientHeight;

                    if (
                        width <=
                            0 ||
                        height <=
                            0
                    ) {
                        return;
                    }

                    camera.aspect =
                        width /
                        height;

                    camera.updateProjectionMatrix();

                    renderer.setSize(
                        width,
                        height,
                        false,
                    );

                    renderer.setPixelRatio(
                        Math.min(
                            window.devicePixelRatio,
                            2,
                        ),
                    );

                },
            );

        resizeObserver.observe(
            section,
        );

        window.addEventListener(
            "astro:before-swap",
            () => {

                cancelAnimationFrame(
                    raf,
                );

                resizeObserver.disconnect();

                stopPlayer();

                renderer.dispose();

            },
            {
                once:
                    true,
            },
        );

    }

    initVaporwaveHero();
</script>

