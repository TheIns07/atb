    function easeOutCubic(value: number): number {
      const t = clamp01(value);

      return 1 - Math.pow(1 - t, 3);
    }

    function easeInOutCubic(value: number): number {
      const t = clamp01(value);

      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

