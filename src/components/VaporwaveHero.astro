---
const documentaryUrl = "https://www.youtube.com/";
---

<section id="vaporwave-hero" class="vaporwave-root">

    <!-- =====================================================
         THREE.JS
    ====================================================== -->

    <canvas
        id="vaporwave-webgl"
        class="vaporwave-canvas"
        aria-hidden="true"
    ></canvas>

    <div class="screen-vignette"></div>
    <div class="screen-lines"></div>
    <div class="screen-noise"></div>

    <!-- =====================================================
         LANDING
    ====================================================== -->

    <div
        id="vaporwave-content"
        class="vaporwave-landing"
    >
        <div class="landing-inner">

            <h1 class="landing-title">
                VAPORWAVE
            </h1>

            <p class="landing-subtitle">
                LA HISTORIA NO CONTADA
            </p>

            <div class="landing-actions">

                <button
                    id="vaporwave-enter"
                    type="button"
                    class="landing-button"
                >
                    ENTRAR A LA EXPERIENCIA
                </button>
            </div>
        </div>
    </div>

    <!-- =====================================================
         INTRO TRANSITION
    ====================================================== -->

    <div
        id="experience-loader"
        class="experience-loader hidden"
        aria-hidden="true"
    >
        <div class="loader-white"></div>

        <div
            id="experience-word"
            class="experience-word"
        >
            記憶
        </div>
    </div>

    <!-- =====================================================
         EXPERIENCE UI
    ====================================================== -->

    <div
        id="experience-ui"
        class="experience-ui"
        aria-hidden="true"
    >
        <button
            id="experience-exit"
            type="button"
            class="experience-exit"
        >
            SALIR
        </button>

        <div class="experience-date">
            <span id="experience-year">
                2009
            </span>

            <span class="date-divider">
                /
            </span>

            <span id="experience-index">
                01 / 15
            </span>
        </div>

        <!-- ===============================================
             YOUTUBE PLAYER
        ================================================ -->

        <aside
            id="youtube-player-dock"
            class="youtube-player-dock hidden"
            aria-hidden="true"
        >
            <div class="player-header">

                <div class="player-heading">

                    <h3
                        id="youtube-player-title"
                        class="player-title"
                    >
                        —
                    </h3>

                    <p
                        id="youtube-player-artist"
                        class="player-artist"
                    >
                        —
                    </p>

                </div>

                <div class="player-actions">

                    <button
                        id="youtube-player-stop"
                        type="button"
                        class="player-action"
                    >
                        STOP
                    </button>

                    <button
                        id="youtube-player-close"
                        type="button"
                        class="player-action player-close"
                        aria-label="Cerrar reproductor"
                    >
                        ×
                    </button>

                </div>

            </div>

            <div class="youtube-frame-container">
                <iframe
                    id="youtube-player-frame"
                    title="YouTube player"
                    src="about:blank"
                    allow="autoplay; encrypted-media; picture-in-picture"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                ></iframe>
            </div>

            <a
                id="youtube-player-link"
                class="player-youtube-link"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
            >
                ABRIR EN YOUTUBE
            </a>

        </aside>

    </div>

    <!-- =====================================================
         ALBUM MODAL
    ====================================================== -->

    <div
        id="album-modal"
        class="album-modal hidden"
        aria-hidden="true"
        role="dialog"
        aria-modal="true"
    >
        <div
            id="album-modal-backdrop"
            class="album-modal-backdrop"
        ></div>

        <article
            id="album-card"
            class="album-card"
        >
            <button
                id="album-modal-close"
                type="button"
                class="album-close"
                aria-label="Cerrar"
            >
                ×
            </button>

            <div class="album-cover-area">

                <img
                    id="album-modal-image"
                    class="album-cover-image"
                    src=""
                    alt=""
                />

                <div class="album-cover-lines"></div>

            </div>

            <div class="album-information">

                <span
                    id="album-modal-year"
                    class="album-year"
                ></span>

                <h2
                    id="album-modal-title"
                    class="album-title"
                ></h2>

                <p
                    id="album-modal-artist"
                    class="album-artist"
                ></p>

                <div class="album-rule"></div>

                <p
                    id="album-modal-summary"
                    class="album-summary"
                ></p>

                <div class="album-review">

                    <p
                        id="album-modal-press"
                        class="album-review-text"
                    ></p>

                    <p
                        id="album-modal-source"
                        class="album-review-source"
                    ></p>

                </div>

                <div class="album-actions">

                    <button
                        id="album-modal-play"
                        type="button"
                        class="album-action-primary"
                    >
                        ESCUCHAR
                    </button>

                    <a
                        id="album-modal-youtube"
                        href="#"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="album-action-secondary"
                    >
                        YOUTUBE
                    </a>

                </div>

            </div>

        </article>

    </div>

    <!-- =====================================================
         TV ENDING
    ====================================================== -->

    <div
        id="no-signal"
        class="no-signal hidden"
        aria-hidden="true"
    >
        <div class="tv-bars">

            <span class="bar-white"></span>
            <span class="bar-yellow"></span>
            <span class="bar-cyan"></span>
            <span class="bar-green"></span>
            <span class="bar-magenta"></span>
            <span class="bar-red"></span>
            <span class="bar-blue"></span>

        </div>

        <div class="tv-middle">

            <span class="small-blue"></span>
            <span class="small-black"></span>
            <span class="small-magenta"></span>
            <span class="small-black"></span>
            <span class="small-cyan"></span>
            <span class="small-black"></span>
            <span class="small-gray"></span>

        </div>

        <div class="tv-bottom">

            <span class="bottom-cyan"></span>
            <span class="bottom-white"></span>
            <span class="bottom-blue"></span>
            <span class="bottom-black"></span>

        </div>

        <div class="tv-static"></div>
        <div class="tv-scanlines"></div>

    </div>

</section>

