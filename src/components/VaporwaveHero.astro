    function modelBasePath(url: string): string {
      const index = url.lastIndexOf("/");

      if (index < 0) {
        return "";
      }

      return url.slice(0, index + 1);
    }

    async function fetchModel(
      request: ModelRequest,
    ): Promise<THREE.Group | null> {
      if (request.generation !== worldGeneration) {
        return null;
      }

      const controller = new AbortController();

      activeFetchControllers.add(controller);

      try {
        const response = await fetch(request.url, {
          signal: controller.signal,

          cache: "force-cache",
        });

        if (!response.ok) {
          throw new Error(`HTTP ${response.status} loading ${request.url}`);
        }

        const buffer = await response.arrayBuffer();

        /*
         * Si salimos antes de terminar,
         * no malgastamos CPU parseando.
         */
        if (request.generation !== worldGeneration) {
          return null;
        }

        await waitFrame();

        const gltf = await loader.parseAsync(
          buffer,
          modelBasePath(request.url),
        );

        if (request.generation !== worldGeneration) {
          disposeObjectResources(gltf.scene);

          return null;
        }

        sourceResources.add(gltf.scene);

        modelSources.set(request.key, gltf.scene);

        return gltf.scene;
      } catch (error: unknown) {
        if (error instanceof DOMException && error.name === "AbortError") {
          return null;
        }

        console.warn(`[Vaporwave] Error cargando ${request.url}`, error);

        return null;
      } finally {
        activeFetchControllers.delete(controller);
      }
    }

    /* ============================================================
       MODEL QUEUE

       Desktop:
       2 GLB simultáneos

       Mobile:
       1 GLB simultáneo
    ============================================================ */

    function pumpModelQueue(): void {
      modelQueue.sort((first, second) => second.priority - first.priority);

      while (activeModelLoads < MODEL_CONCURRENCY && modelQueue.length > 0) {
        const request = modelQueue.shift();

        if (request === undefined) {
          break;
        }

        if (request.generation !== worldGeneration) {
          request.resolve(null);

          continue;
        }

        activeModelLoads += 1;

        void fetchModel(request)
          .then((source) => {
            request.resolve(source);
          })
          .finally(() => {
            activeModelLoads = Math.max(0, activeModelLoads - 1);

            pumpModelQueue();
          });
      }
    }

    function requestModel(
      key: SceneAssetKey,

      priority: number,
    ): Promise<THREE.Group | null> {
      const cached = modelSources.get(key);

      if (cached !== undefined) {
        return Promise.resolve(cached);
      }

      const generation = worldGeneration;

      const promiseKey = `${generation}:${key}`;

      const existing = modelPromises.get(promiseKey);

      if (existing !== undefined) {
        return existing;
      }

      const url = sceneAssets[key];

      const promise = new Promise<THREE.Group | null>((resolve) => {
        modelQueue.push({
          key,
          url,
          priority,
          generation,
          resolve,
        });

        pumpModelQueue();
      });

      modelPromises.set(promiseKey, promise);

      return promise;
    }

    function cancelModelStreaming(): void {
      /*
       * Resolver las peticiones que todavía
       * no habían empezado.
       */
      const pending = modelQueue.splice(0, modelQueue.length);

      pending.forEach((request) => {
        request.resolve(null);
      });

      activeFetchControllers.forEach((controller) => {
        controller.abort();
      });

      activeFetchControllers.clear();

      modelPromises.clear();
    }

    /* ============================================================
       MODEL CLONING
    ============================================================ */

    function createModel(
      source: THREE.Group,

      desiredHeight: number,
    ): THREE.Group {
      const wrapper = new THREE.Group();

      /*
       * Las geometrías/texturas se comparten.
       * No clonamos 30 veces el mismo CRT.
       */
      const model = source.clone(true);

      model.traverse((child: THREE.Object3D) => {
        if (child instanceof THREE.Mesh) {
          child.castShadow = false;

          child.receiveShadow = false;
        }
      });

      const bounds = new THREE.Box3().setFromObject(model);

      const size = new THREE.Vector3();

      bounds.getSize(size);

      if (size.y > 0.0001) {
        model.scale.setScalar(desiredHeight / size.y);
      }

      const normalizedBounds = new THREE.Box3().setFromObject(model);

      const center = new THREE.Vector3();

      normalizedBounds.getCenter(center);

      model.position.x -= center.x;

      model.position.z -= center.z;

      model.position.y -= normalizedBounds.min.y;

      wrapper.add(model);

      return wrapper;
    }

    /* ============================================================
       BUILDING MATERIAL

       Los edificios usan materiales ligeros y neutros.
       También quedan preparados para fade-in.
    ============================================================ */

    function prepareBuilding(root: THREE.Object3D): void {
      let index = 0;

      root.traverse((child: THREE.Object3D) => {
        if (!(child instanceof THREE.Mesh)) {
          return;
        }

        /*
         * No recalculamos geometría si no hace falta.
         * Sólo actualizamos normales si faltan.
         */
        if (child.geometry.attributes.normal === undefined) {
          child.geometry.computeVertexNormals();
        }

        const tone =
          index % 3 === 0 ? 0xe2e4e4 : index % 3 === 1 ? 0xeff0ee : 0xd7dadb;

        const material = new THREE.MeshStandardMaterial({
          color: tone,

          roughness: 0.82,

          metalness: 0.01,

          transparent: true,

          opacity: 0,

          depthTest: true,

          depthWrite: true,

          dithering: true,

          polygonOffset: true,

          polygonOffsetFactor: 1 + index * 0.012,

          polygonOffsetUnits: 1 + index * 0.025,
        });

        child.material = material;

        index += 1;
      });
    }

    function setBuildingOpacity(opacity: number): void {
      const normalizedOpacity = clamp01(opacity);

      skylineGroup.traverse((child: THREE.Object3D) => {
        if (!(child instanceof THREE.Mesh)) {
          return;
        }

        const materials: THREE.Material[] = Array.isArray(child.material)
          ? child.material
          : [child.material];

        materials.forEach((material: THREE.Material) => {
          if (material instanceof THREE.MeshStandardMaterial) {
            material.transparent = normalizedOpacity < 0.999;

            material.opacity = normalizedOpacity;

            material.needsUpdate = true;
          }
        });
      });
    }

    /* ============================================================
       GENERIC ASSET MATERIAL IMPROVEMENT
    ============================================================ */

    function improveAssetMaterials(root: THREE.Object3D): void {
      root.traverse((child: THREE.Object3D) => {
        if (!(child instanceof THREE.Mesh)) {
          return;
        }

        const materials: THREE.Material[] = Array.isArray(child.material)
          ? child.material
          : [child.material];

        materials.forEach((material: THREE.Material) => {
          material.depthTest = true;

          material.depthWrite = true;

          if (material instanceof THREE.MeshStandardMaterial) {
            material.dithering = true;

            if (material.map !== null) {
              material.map.colorSpace = THREE.SRGBColorSpace;

              material.map.anisotropy = Math.min(
                renderer.capabilities.getMaxAnisotropy(),

                isMobile ? 2 : 8,
              );

              material.map.minFilter = THREE.LinearMipmapLinearFilter;

              material.map.magFilter = THREE.LinearFilter;

              material.map.needsUpdate = true;
            }
          }
        });
      });
    }

    function applyMarble(root: THREE.Object3D): void {
      root.traverse((child: THREE.Object3D) => {
        if (child instanceof THREE.Mesh) {
          child.material = marbleMaterial.clone();
        }
      });
    }

