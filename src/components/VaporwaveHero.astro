  function resetSkyLights():
    void {
    skyLightLayer.classList.remove(
      "is-active",
      "is-paused",
      "is-endless",
    );

    section.style.removeProperty(
      "--vw-color-a",
    );

    section.style.removeProperty(
      "--vw-color-b",
    );

    section.style.removeProperty(
      "--vw-color-c",
    );
  }

  function pauseSkyLights():
    void {
    skyLightLayer.classList.add(
      "is-paused",
    );
  }

  function resumeSkyLights():
    void {
    if (
      playingAlbumIndex ===
      null
    ) {
      return;
    }

    skyLightLayer.classList.remove(
      "is-paused",
    );

    skyLightLayer.classList.add(
      "is-active",
    );
  }

  function promoteSkyLightsToEndless():
    void {
    skyLightLayer.classList.add(
      "is-endless",
    );
  }

  function resetPalette():
    void {
    paletteRequest +=
      1;

    paletteTween?.kill();

    paletteTween =
      null;

    currentFloorA.copy(
      defaultFloorA,
    );

    currentFloorB.copy(
      defaultFloorB,
    );

    paintCheckerboard(
      currentFloorA,
      currentFloorB,
    );

    floorTexture.needsUpdate =
      true;

    floorMaterial.emissive.set(
      0x000000,
    );

    floorMaterial.emissiveIntensity =
      0;

    scene.background =
      defaultSky.clone();

    if (
      scene.fog instanceof
      THREE.FogExp2
