                            0.42 *
                                direction,

                        y:
                            y +
                            0.2,

                        z:
                            z +
                            0.06,

                        duration:
                            0.82,

                        ease:
                            "sine.inOut",

                    },
                )

                .to(
                    group.position,
                    {

                        x,

                        y,

                        z,

                        duration:
                            1.06,

                        ease:
                            "sine.inOut",

                    },
                );

            const rotation =
