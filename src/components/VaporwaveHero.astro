    /* ============================================================
       MODEL RESOURCE DISPOSAL
    ============================================================ */

    function disposeTexture(texture: THREE.Texture): void {
      texture.dispose();

      const image: unknown = texture.image;

      if (typeof ImageBitmap !== "undefined" && image instanceof ImageBitmap) {
        image.close();
      }
    }

    function disposeObjectResources(root: THREE.Object3D): void {
      const geometries = new Set<THREE.BufferGeometry>();

      const materials = new Set<THREE.Material>();

      const textures = new Set<THREE.Texture>();

      root.traverse((child: THREE.Object3D) => {
        if (!(child instanceof THREE.Mesh)) {
          return;
        }

        const geometry = child.geometry;

        if (!geometries.has(geometry)) {
          geometry.dispose();

          geometries.add(geometry);
        }

        const childMaterials: THREE.Material[] = Array.isArray(child.material)
          ? child.material
          : [child.material];

        childMaterials.forEach((material: THREE.Material) => {
          if (materials.has(material)) {
            return;
          }

          Object.values(material).forEach((value: unknown) => {
            if (value instanceof THREE.Texture && !textures.has(value)) {
              disposeTexture(value);

              textures.add(value);
            }
          });

          material.dispose();

          materials.add(material);
        });
      });
    }

    /* ============================================================
