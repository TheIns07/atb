  }

  /* ========================================================
     ENTER
  ======================================================== */

  async function enterExperience():
    Promise<void> {
    if (
      experienceActive ||
      transitioning ||
      ending
    ) {
      return;
    }

    transitioning =
      true;

    travelling =
      false;

    modalOpen =
      false;

    endlessFloorMode =
      false;

    reachedEnd =
      false;

    /*
     * Nueva generación.
     * Todo lo cargado anteriormente queda inválido.
     */
    worldSession +=
      1;

    const session =
      worldSession;

    cancelPendingModelLoads();

    resetSkyLights();
    resetHud();
    resetPalette();

    canvas.style.pointerEvents =
      "none";

    content.style.pointerEvents =
      "none";

    loaderScreen.classList.remove(
      "hidden",
    );

    loaderScreen.setAttribute(
      "aria-hidden",
      "false",
    );

    loaderScreen.style.opacity =
      "0";

    experienceWord.textContent =
      "読み込み中";

    experienceWord.style.opacity =
      "0";

    loadProgress.style.opacity =
      "0";

    loadProgress.textContent =
      "000";

    gsap.to(
      content,
      {
        opacity:
          0,

        duration:
          0.55,

        ease:
          "power2.inOut",
      },
    );

    await new Promise<void>(
      (
        resolve,
      ) => {
        gsap.to(
          loaderScreen,
          {
            opacity:
              1,

            duration:
              0.9,

            ease:
              "power2.inOut",

            onComplete:
              resolve,
          },
        );
      },
    );

    gsap.to(
      experienceWord,
      {
        opacity:
          1,

        duration:
          0.25,
      },
    );

    gsap.to(
      loadProgress,
      {
        opacity:
          1,

        duration:
          0.25,
      },
    );

    /*
     * Sólo AVIF + cards.
     * No esperamos edificios, bustos, mall,
     * delfín ni Commodore.
     */
    await buildExperienceShell(
      session,
    );

    if (
      session !==
      worldSession
    ) {
      return;
    }

    loadProgress.style.opacity =
      "0";

    experienceWord.textContent =
      "ようこそ";

    gsap.fromTo(
      experienceWord,

      {
        opacity:
          0,

        y:
          8,
      },

      {
        opacity:
          1,

        y:
          0,

        duration:
          0.4,

        ease:
          "power3.out",
      },
    );

    await sleep(
      450,
    );

    camera.position.copy(
      experienceStart,
    );

    cameraTarget.set(
      0,

      isMobile
        ? 1.65
        : 2.1,

      -45,
    );

    canvas.style.opacity =
      "1";

    canvas.style.pointerEvents =
      "auto";

    experienceActive =
      true;

    travelling =
      true;

    experienceUI.setAttribute(
      "aria-hidden",
      "false",
    );

    /*
     * A partir de aquí empiezan los GLB.
     *
     * El usuario YA está dentro.
     */
    startInitialModelStreaming(
      session,
    );

    gsap.to(
      experienceUI,
      {
        opacity:
          1,

        duration:
          0.35,
      },
    );

    gsap.to(
      loaderScreen,
      {
        opacity:
          0,

        duration:
          0.65,

        ease:
          "power2.inOut",

        onComplete:
          () => {
            loaderScreen.classList.add(
              "hidden",
            );

            loaderScreen.setAttribute(
              "aria-hidden",
              "true",
            );

            transitioning =
              false;
          },
      },
    );
  }

