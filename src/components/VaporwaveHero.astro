      "#youtube-player-artist",
    );

  const playerToggle =
    must<HTMLButtonElement>(
      "#youtube-player-toggle",
    );

  const playerClose =
    must<HTMLButtonElement>(
      "#youtube-player-close",
    );

  const playerHost =
    must<HTMLElement>(
      "#youtube-api-host",
    );

  const noSignal =
    must<HTMLElement>(
      "#no-signal",
    );

  /* ========================================================
     THREE
  ======================================================== */

  const scene =
    new THREE.Scene();

  const defaultSky =
    new THREE.Color(
      0x7f91a5,
    );

  const defaultFog =
    new THREE.Color(
      0x8998a8,
    );

  scene.background =
    defaultSky.clone();

  scene.fog =
    new THREE.FogExp2(
      defaultFog.clone(),

      isMobile
        ? 0.00285
        : 0.00245,
    );

  const camera =
