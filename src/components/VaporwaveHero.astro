    function require2DContext(
      target: HTMLCanvasElement,
    ): CanvasRenderingContext2D {
      const context = target.getContext("2d");

      if (context === null) {
        throw new Error(
          "[Vaporwave] No se pudo crear CanvasRenderingContext2D.",
        );
      }

      return context;
    }

