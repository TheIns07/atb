    function rebuildYouTubeMount():
        void {

        playerHost.innerHTML =
            '<div id="youtube-player-mount"></div>';
    }

    function loadYouTubeAPI():
        Promise<
            YouTubeNamespace
        > {

        if (
            window.YT !==
                undefined &&
            window.YT.Player !==
                undefined
        ) {

            return Promise.resolve(
                window.YT,
            );
        }

        if (
            youtubeApiPromise !==
            null
        ) {

            return youtubeApiPromise;
        }

        youtubeApiPromise =
            new Promise<
                YouTubeNamespace
            >(
                (
                    resolve,
                ) => {

                    const previous =
                        window
                            .onYouTubeIframeAPIReady;

                    window.onYouTubeIframeAPIReady =
                        () => {

                            previous?.();

                            if (
                                window.YT ===
                                undefined
                            ) {
                                return;
                            }

                            resolve(
                                window.YT,
                            );
                        };

                    const existing =
                        document.querySelector(
                            'script[data-vaporwave-youtube-api="true"]',
                        );

                    if (
                        existing !==
                        null
                    ) {
                        return;
                    }

                    const script =
                        document.createElement(
                            "script",
                        );

                    script.src =
                        "https://www.youtube.com/iframe_api";

                    script.async =
                        true;

                    script.dataset.vaporwaveYoutubeApi =
                        "true";

                    document.head.appendChild(
                        script,
                    );
                },
            );

        return youtubeApiPromise;
    }

    function playbackIsActive():
        boolean {

        return (
            youtubeState ===
                1 ||
            youtubeState ===
                3
        );
    }

    function updatePlayerButton(
        playing:
            boolean,
    ): void {

        playerToggle.classList.toggle(
            "is-playing",
            playing,
        );

        playerToggle.setAttribute(
            "aria-label",

            playing
                ? "Pausar"
                : "Reproducir",
        );
    }

    function handleYouTubeState(
        state:
            number,
    ): void {

        youtubeState =
            state;

        const playing =
            state ===
                1 ||
            state ===
                3;

        updatePlayerButton(
            playing,
        );

        if (
            state ===
            1
        ) {

            resumeSkyLights();
        }

        if (
            state ===
                2 &&
            !reachedEnd
        ) {

            pauseSkyLights();
        }

        if (
            reachedEnd &&
            !ending &&
            (
                state ===
                    2 ||
                state ===
                    0
            )
        ) {

            runNoSignal();
        }
    }

    async function playAlbum(
        index:
            number,
    ): Promise<void> {

        const work =
            works[
                index
            ];

        if (
            work ===
            undefined
        ) {
            return;
        }

        selectedAlbumIndex =
            index;

        playingAlbumIndex =
            index;

        playerCover.src =
            work.image;

        playerCover.alt =
            work.title;

        playerTitle.textContent =
            work.title;

        playerArtist.textContent =
            `${work.artist} · ${work.year}`;

        playerDock.classList.remove(
            "hidden",
        );

        playerDock.setAttribute(
            "aria-hidden",
            "false",
        );

        void applyAlbumPalette(
            work,
        );

        if (
            reachedEnd
        ) {

            promoteSkyLightsToEndless();
        }

        const YT =
            await loadYouTubeAPI();

        if (
            youtubePlayer !==
            null
        ) {

            youtubePlayer.loadVideoById(
                work.youtubeId,
            );

            youtubePlayer.playVideo();

            return;
        }

        rebuildYouTubeMount();

        youtubePlayer =
            new YT.Player(
                "youtube-player-mount",
                {
                    videoId:
                        work.youtubeId,

                    width:
                        "320",

                    height:
                        "180",

                    playerVars: {
                        autoplay:
                            1,

                        controls:
                            0,

                        rel:
                            0,

                        playsinline:
                            1,

                        modestbranding:
                            1,
                    },

                    events: {
                        onReady:
                            (
                                event:
                                    YouTubeReadyEvent,
                            ) => {

                                event.target.playVideo();
                            },

                        onStateChange:
                            (
                                event:
                                    YouTubeStateEvent,
                            ) => {

                                handleYouTubeState(
                                    event.data,
                                );
                            },
                    },
                },
            );
    }

