  if (!vaporwaveRoot) {
    throw new Error("No se encontró #vaporwave-hero.");
  }

  if (
    vaporwaveRoot instanceof HTMLElement &&
    vaporwaveRoot.dataset.vaporwaveInitialized === "true"
