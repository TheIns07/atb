    function colorToCSS(color: THREE.Color): string {
      return `rgb(${Math.round(color.r * 255)}, ${Math.round(
        color.g * 255,
      )}, ${Math.round(color.b * 255)})`;
    }

    function paintCheckerboard(
      colorA: THREE.Color,

      colorB: THREE.Color,
    ): void {
      const half = 128;

      floorCtx.clearRect(0, 0, 256, 256);

      floorCtx.fillStyle = colorToCSS(colorA);

      floorCtx.fillRect(0, 0, half, half);

      floorCtx.fillRect(half, half, half, half);

      floorCtx.fillStyle = colorToCSS(colorB);

      floorCtx.fillRect(half, 0, half, half);

      floorCtx.fillRect(0, half, half, half);
    }

    paintCheckerboard(currentFloorA, currentFloorB);

    floorTexture = new THREE.CanvasTexture(floorCanvas);

