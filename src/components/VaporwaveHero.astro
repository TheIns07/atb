    /* =========================================================
       HELPERS
    ========================================================== */

    function must<T extends Element>(
        selector:
            string,
    ): T {

        const element =
            document.querySelector<T>(
                selector,
            );

        if (!element) {

            throw new Error(
                `[Vaporwave] Missing ${selector}`,
            );

        }

        return element;

    }

    function sleep(
        milliseconds:
            number,
    ) {

        return new Promise<void>(
            (
                resolve,
            ) => {

                window.setTimeout(
                    resolve,
                    milliseconds,
                );

            },
        );

    }

    /* =========================================================
       INIT
    ========================================================== */

    async function initVaporwaveHero() {

        const section =
            must<HTMLElement>(
                "#vaporwave-hero",
            );

        if (
            section.dataset
                .vaporwaveInitialized ===
            "true"
        ) {
            return;
        }

        section.dataset
            .vaporwaveInitialized =
            "true";

        const canvas =
            must<HTMLCanvasElement>(
                "#vaporwave-webgl",
            );

        const content =
            must<HTMLElement>(
                "#vaporwave-content",
            );

        const enterButton =
            must<HTMLButtonElement>(
                "#vaporwave-enter",
            );

        const loaderScreen =
            must<HTMLElement>(
                "#experience-loader",
            );

        const experienceWord =
            must<HTMLElement>(
                "#experience-word",
            );

        const experienceUI =
            must<HTMLElement>(
                "#experience-ui",
            );

        const exitButton =
            must<HTMLButtonElement>(
                "#experience-exit",
            );

        const yearLabel =
            must<HTMLElement>(
                "#experience-year",
            );

        const indexLabel =
            must<HTMLElement>(
                "#experience-index",
            );

        /* =====================================================
           MODAL ELEMENTS
        ====================================================== */

        const modal =
            must<HTMLElement>(
                "#album-modal",
            );

        const modalBackdrop =
            must<HTMLElement>(
                "#album-modal-backdrop",
            );

        const albumCard =
            must<HTMLElement>(
                "#album-card",
            );

        const modalClose =
            must<HTMLButtonElement>(
                "#album-modal-close",
            );

        const modalImage =
            must<HTMLImageElement>(
                "#album-modal-image",
            );

        const modalYear =
            must<HTMLElement>(
                "#album-modal-year",
            );

        const modalTitle =
            must<HTMLElement>(
                "#album-modal-title",
            );

        const modalArtist =
            must<HTMLElement>(
                "#album-modal-artist",
            );

        const modalSummary =
            must<HTMLElement>(
                "#album-modal-summary",
            );

        const modalPress =
            must<HTMLElement>(
                "#album-modal-press",
            );

        const modalSource =
            must<HTMLElement>(
                "#album-modal-source",
            );

        const modalPlay =
            must<HTMLButtonElement>(
                "#album-modal-play",
            );

        const modalYoutube =
            must<HTMLAnchorElement>(
                "#album-modal-youtube",
            );

        /* =====================================================
           PLAYER ELEMENTS
        ====================================================== */

        const playerDock =
            must<HTMLElement>(
                "#youtube-player-dock",
            );

        const playerFrame =
            must<HTMLIFrameElement>(
                "#youtube-player-frame",
            );

        const playerTitle =
            must<HTMLElement>(
                "#youtube-player-title",
            );

        const playerArtist =
            must<HTMLElement>(
                "#youtube-player-artist",
            );

        const playerStop =
            must<HTMLButtonElement>(
                "#youtube-player-stop",
            );

        const playerClose =
            must<HTMLButtonElement>(
                "#youtube-player-close",
            );

        const playerLink =
            must<HTMLAnchorElement>(
                "#youtube-player-link",
            );

        const noSignal =
            must<HTMLElement>(
                "#no-signal",
            );

        /* =====================================================
           SCENE
        ====================================================== */

        const scene =
            new THREE.Scene();

        scene.background =
            new THREE.Color(
                0x7f91a5,
            );

        scene.fog =
            new THREE.FogExp2(
                0x8998a8,
                0.00245,
            );

        /* =====================================================
           CAMERA
        ====================================================== */

        const camera =
            new THREE.PerspectiveCamera(

                55,

                section.clientWidth /
                    section.clientHeight,

                /*
                 * A larger near plane greatly improves
                 * depth precision and helps with z-fighting
                 * on imported buildings.
                 */
                0.8,

                1800,

            );

        const experienceStart =
            new THREE.Vector3(
                0,
                3.3,
                8,
            );

        camera.position.copy(
            experienceStart,
        );

        const cameraTarget =
            new THREE.Vector3(
                0,
                2.1,
                -45,
            );

        /* =====================================================
           RENDERER
        ====================================================== */

        const renderer =
            new THREE.WebGLRenderer({

                canvas,

                antialias:
                    true,

                powerPreference:
                    "high-performance",

                /*
                 * Important for the large depth range
                 * of this scene.
                 */
                logarithmicDepthBuffer:
                    true,

            });

        renderer.setSize(
            section.clientWidth,
            section.clientHeight,
            false,
        );

        renderer.setPixelRatio(
            Math.min(
                window.devicePixelRatio,
                2,
