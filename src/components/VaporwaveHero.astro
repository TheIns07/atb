    /* ============================================================
       DOLPHIN ANIMATION
    ============================================================ */

    function updateDolphin(elapsed: number): void {
      if (archiveDolphin === null) {
        return;
      }

      const baseY =
        typeof archiveDolphin.userData.baseY === "number"
          ? archiveDolphin.userData.baseY
          : 6;

      archiveDolphin.position.y = baseY + Math.sin(elapsed * 0.45) * 0.3;

      archiveDolphin.rotation.y = -0.7 + Math.sin(elapsed * 0.25) * 0.22;

      archiveDolphin.rotation.z = 0.07 + Math.sin(elapsed * 0.32) * 0.04;
    }

    /* ============================================================
       REFERENCES NEEDED BY PLAYER / FEEDBACK LOOP
    ============================================================ */

    const skyLightLayer = document.getElementById("sky-light-layer");

    const playerHost = document.getElementById("youtube-api-host");

    if (!skyLightLayer || !playerHost) {
      throw new Error("[Vaporwave] Faltan elementos del reproductor.");
    }

    /*
     * Se declara aquí porque las funciones anteriores
     * únicamente lo referencian cuando ya terminó de
     * inicializarse todo el script.
     */
    let archiveDolphin: THREE.Group | null = null;

    let youtubeState = -1;

    let paletteAnimationFrame = 0;

    let feedbackEndToken = 0;

    /* ============================================================
       YOUTUBE TYPES
    ============================================================ */

    interface YouTubePlayer {
      playVideo(): void;

      pauseVideo(): void;

      destroy(): void;

      loadVideoById(videoId: string): void;

      getPlayerState(): number;

      getCurrentTime(): number;

      getDuration(): number;

      seekTo(seconds: number, allowSeekAhead: boolean): void;
    }

    interface YouTubeReadyEvent {
      target: YouTubePlayer;
    }

    interface YouTubeStateEvent {
      data: number;
    }

    interface YouTubePlayerOptions {
      videoId: string;

      width: string;

      height: string;

      playerVars: {
        autoplay: number;

        controls: number;

        rel: number;

        playsinline: number;

        modestbranding: number;
      };

      events: {
        onReady: (event: YouTubeReadyEvent) => void;

        onStateChange: (event: YouTubeStateEvent) => void;
      };
    }

    interface YouTubeNamespace {
      Player: new (
        element: string,

        options: YouTubePlayerOptions,
      ) => YouTubePlayer;
    }

    type ExtendedWindow = Window &
      typeof globalThis & {
        YT?: YouTubeNamespace;

        onYouTubeIframeAPIReady?: () => void;
      };

    const youtubeWindow = window as ExtendedWindow;

    /* ============================================================
       PLAYER UTILITIES
    ============================================================ */

    function formatPlayerTime(seconds: number): string {
      if (!Number.isFinite(seconds) || seconds < 0) {
        return "0:00";
      }

      const total = Math.floor(seconds);

      const minutes = Math.floor(total / 60);

      const remainder = total % 60;

      return `${minutes}:${String(remainder).padStart(2, "0")}`;
    }

    function playbackIsActive(): boolean {
      return youtubeState === 1 || youtubeState === 3;
    }

    function trackIsLoaded(): boolean {
      return currentPlayerAlbum !== null && youtubePlayer !== null;
    }

    function clearFeedbackEndTimer(): void {
      feedbackEndToken += 1;

      if (finalChoiceTimeout !== null) {
        window.clearTimeout(finalChoiceTimeout);

        finalChoiceTimeout = null;
      }
    }

    /* ============================================================
       PLAYER ICON
    ============================================================ */

    function updatePlayerToggle(): void {
      const isPlaying = youtubeState === 1 || youtubeState === 3;

      playerToggle.classList.toggle("is-playing", isPlaying);

      playerToggle.setAttribute(
        "aria-label",

        isPlaying ? "Pausar" : "Reproducir",
      );
    }

    /* ============================================================
       SEEK BAR
    ============================================================ */

    function updateSeekVisual(ratio: number): void {
      const normalized = clamp01(ratio);

      playerSeek.style.setProperty("--seek-progress", `${normalized * 100}%`);
    }

    function updatePlayerProgress(): void {
      cancelAnimationFrame(progressRaf);

      const tick = (): void => {
        if (youtubePlayer !== null && playerReady) {
          const current = youtubePlayer.getCurrentTime();

          const duration = youtubePlayer.getDuration();

          if (!isSeeking) {
            const ratio = duration > 0 ? clamp01(current / duration) : 0;

            playerSeek.value = String(Math.round(ratio * 1000));

            updateSeekVisual(ratio);
          }

          playerCurrent.textContent = formatPlayerTime(current);

          playerDuration.textContent = formatPlayerTime(duration);
        }

        progressRaf = requestAnimationFrame(tick);
      };

      progressRaf = requestAnimationFrame(tick);
    }

    function stopPlayerProgress(): void {
      cancelAnimationFrame(progressRaf);

      progressRaf = 0;
    }

    playerSeek.addEventListener("pointerdown", () => {
      isSeeking = true;
    });

    playerSeek.addEventListener("input", () => {
      const ratio = Number(playerSeek.value) / 1000;

      updateSeekVisual(ratio);

      if (youtubePlayer === null) {
        return;
      }

      const duration = youtubePlayer.getDuration();

      if (duration <= 0) {
        return;
      }

      playerCurrent.textContent = formatPlayerTime(duration * ratio);
    });

    function commitSeek(): void {
      if (youtubePlayer === null) {
        isSeeking = false;

        return;
      }

      const duration = youtubePlayer.getDuration();

      if (duration > 0) {
        const ratio = Number(playerSeek.value) / 1000;

        youtubePlayer.seekTo(duration * ratio, true);
      }

      isSeeking = false;
    }

    playerSeek.addEventListener("change", commitSeek);

    playerSeek.addEventListener("pointerup", commitSeek);

    /* ============================================================
       YOUTUBE API
    ============================================================ */

    function ensureYouTubeMount(): HTMLElement {
      let mount = document.getElementById("youtube-player-mount");

      if (mount === null) {
        mount = document.createElement("div");

        mount.id = "youtube-player-mount";

        playerHost.appendChild(mount);
      }

      return mount;
    }

    function loadYouTubeAPI(): Promise<YouTubeNamespace> {
      if (
        youtubeWindow.YT !== undefined &&
        youtubeWindow.YT.Player !== undefined
      ) {
        return Promise.resolve(youtubeWindow.YT);
      }

      if (youtubeApiPromise !== null) {
        return youtubeApiPromise;
      }

      youtubeApiPromise = new Promise<YouTubeNamespace>((resolve) => {
        const previous = youtubeWindow.onYouTubeIframeAPIReady;

        youtubeWindow.onYouTubeIframeAPIReady = () => {
          previous?.();

          const YT = youtubeWindow.YT;

          if (YT === undefined) {
            return;
          }

          resolve(YT);
        };

        const existing = document.querySelector(
          'script[data-vaporwave-youtube="true"]',
        );

        if (existing !== null) {
          return;
        }

        const script = document.createElement("script");

        script.src = "https://www.youtube.com/iframe_api";

        script.async = true;

        script.dataset.vaporwaveYoutube = "true";

        document.head.appendChild(script);
      });

      return youtubeApiPromise;
    }

    /* ============================================================
       PLAYER DOCK PRESENTATION
    ============================================================ */

    function showPlayerDock(): void {
