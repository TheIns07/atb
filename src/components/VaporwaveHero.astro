  /* ========================================================
     CAMERA-BASED STREAMING

     Assets pesados no se descargan antes de necesitarlos.
  ======================================================== */

  function updateModelStreaming():
    void {
    const session =
      worldSession;

    const z =
      camera.position.z;

    /*
     * Primer busto está alrededor de -145.
     * Empezamos relativamente temprano.
     */
    if (
      z <
      -25
    ) {
      void streamBusts(
        session,
      );
    }

    /*
     * Mall y teatro aparecen alrededor -270.
     */
    if (
      z <
      -70
    ) {
      void streamTheatres(
        session,
      );

      void streamMalls(
        session,
      );
    }

    /*
     * Dolphin es ENORME.
     * Se manda muy atrás en prioridad.
     */
    if (
      z <
      -100
    ) {
      void streamDolphin(
        session,
      );
    }

    /*
     * Commodore aparece cerca de -735.
     * No tiene sentido descargar 40MB desde 2009.
     */
    if (
      z <
      -390
    ) {
      void streamCommodore(
        session,
      );
    }
  }

