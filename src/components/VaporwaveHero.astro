async function initVaporwaveHero():
    Promise<void> {

    const section =
        must<HTMLElement>(
            "#vaporwave-hero",
        );

    if (
        section.dataset
            .vaporwaveInitialized ===
        "true"
    ) {
        return;
    }

    section.dataset
        .vaporwaveInitialized =
        "true";

    const isMobile =
        window.matchMedia(
            "(max-width: 800px)",
        ).matches;

    function worldX(
        x: number,
    ): number {
        return isMobile
            ? x * 0.54
            : x;
    }

    function worldHeight(
        height: number,
    ): number {
        return isMobile
