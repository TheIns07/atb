    }

    blueLight.color.set(
      0x7997b2,
    );

    creamLight.color.set(
      0xc5baa2,
    );

    resetSkyLights();
  }

  function extractAlbumPalette(
    imageUrl:
      string,
  ): Promise<
    [
      THREE.Color,
      THREE.Color
    ]
  > {
    return new Promise<
      [
        THREE.Color,
        THREE.Color
      ]
    >(
      (
        resolve,
      ) => {
        const image =
          new Image();

        image.decoding =
          "async";

        image.onload =
          () => {
            const sample =
              document.createElement(
                "canvas",
              );

            sample.width =
              40;

            sample.height =
              40;

            const context =
              require2DContext(
                sample,
              );

            context.drawImage(
              image,
              0,
              0,
              40,
              40,
            );

            const pixels =
              context.getImageData(
                0,
                0,
                40,
                40,
              ).data;

            const buckets =
              new Map<
                string,
                PaletteBucket
              >();

            for (
              let index =
                0;
              index <
              pixels.length;
              index +=
                20
            ) {
              const alpha =
                pixels[
                  index +
                  3
                ];

              if (
                alpha <
                180
              ) {
                continue;
              }

              const r =
                pixels[
                  index
                ];

              const g =
                pixels[
                  index +
                  1
                ];

              const b =
                pixels[
                  index +
                  2
                ];

              const max =
                Math.max(
                  r,
                  g,
                  b,
                );

              const min =
                Math.min(
                  r,
                  g,
                  b,
                );

              const saturation =
                max ===
                0
                  ? 0
                  : (
                      max -
                      min
                    ) /
                    max;

              const brightness =
                (
                  r +
                  g +
                  b
                ) /
                3;

              if (
                brightness <
                  22 ||
                brightness >
                  238
              ) {
                continue;
              }

              const qr =
                Math.min(
                  Math.round(
                    r /
                      32,
                  ) *
                    32,
                  255,
                );

              const qg =
                Math.min(
                  Math.round(
                    g /
                      32,
                  ) *
                    32,
                  255,
                );

              const qb =
                Math.min(
                  Math.round(
                    b /
                      32,
                  ) *
                    32,
                  255,
                );

              const key =
                `${qr}-${qg}-${qb}`;

              const existing =
                buckets.get(
                  key,
                );

              if (
                existing
              ) {
                existing.count +=
                  1;
              } else {
                buckets.set(
                  key,
                  {
                    count:
                      1,

                    r:
                      qr,

                    g:
                      qg,

                    b:
                      qb,

                    saturation,
                  },
                );
              }
            }

            const entries =
              Array.from(
                buckets.values(),
              ).sort(
                (
                  a,
                  b,
                ) => {
                  const scoreA =
                    a.count *
                    (
                      0.55 +
                      a.saturation *
                        1.8
                    );

                  const scoreB =
                    b.count *
                    (
                      0.55 +
                      b.saturation *
                        1.8
                    );

                  return (
                    scoreB -
                    scoreA
                  );
                },
              );

            if (
              entries.length ===
              0
            ) {
              resolve([
                new THREE.Color(
                  "#d94b9a",
                ),

                new THREE.Color(
                  "#40329a",
                ),
              ]);

              return;
            }

            const first =
              entries[
                0
              ];

            let second =
              entries[
                Math.min(
                  1,
                  entries.length -
                    1,
                )
              ];

            for (
              const candidate
              of entries
            ) {
              const distance =
                Math.sqrt(
                  Math.pow(
                    first.r -
                      candidate.r,
                    2,
                  ) +

                  Math.pow(
                    first.g -
                      candidate.g,
                    2,
                  ) +

                  Math.pow(
                    first.b -
                      candidate.b,
                    2,
                  ),
                );

              if (
                distance >
                90
              ) {
                second =
                  candidate;

                break;
              }
            }

            const colorA =
              new THREE.Color(
                first.r /
                  255,

                first.g /
                  255,

                first.b /
                  255,
              );

            const colorB =
              new THREE.Color(
                second.r /
                  255,

                second.g /
                  255,

                second.b /
                  255,
              );

            colorA.offsetHSL(
              0,
              0.11,
              -0.04,
            );

            colorB.offsetHSL(
              0,
              0.15,
              -0.08,
            );

            resolve([
              colorA,
              colorB,
            ]);
          };

        image.onerror =
          () => {
            resolve([
              new THREE.Color(
                "#d94b9a",
              ),

              new THREE.Color(
                "#40329a",
              ),
            ]);
          };

        image.src =
          imageUrl;
      },
    );
  }

  async function applyAlbumPalette(
    work:
      Work,
  ): Promise<void> {
    const request =
      ++paletteRequest;

    const [
      colorA,
      colorB,
    ] =
      await extractAlbumPalette(
        work.image,
      );

    if (
      request !==
      paletteRequest
    ) {
      return;
    }

    paletteTween?.kill();

    const highlight =
      colorA
        .clone()
        .lerp(
          new THREE.Color(
            "#f4d9ff",
          ),

          0.32,
        );

    section.style.setProperty(
      "--vw-color-a",
      `#${colorA.getHexString()}`,
    );

    section.style.setProperty(
      "--vw-color-b",
      `#${colorB.getHexString()}`,
    );

    section.style.setProperty(
      "--vw-color-c",
      `#${highlight.getHexString()}`,
    );

    skyLightLayer.classList.add(
      "is-active",
    );

    skyLightLayer.classList.remove(
      "is-paused",
    );

    const targetSky =
      colorA
        .clone()
        .lerp(
          defaultSky,
          0.72,
        );

    const targetFog =
      colorB
        .clone()
        .lerp(
          defaultFog,
          0.76,
        );

    const darkFloor =
      colorB
        .clone()
        .multiplyScalar(
          0.45,
        );

    const sky =
      scene.background instanceof
      THREE.Color
        ? scene.background
        : defaultSky.clone();

    const fog =
      scene.fog instanceof
      THREE.FogExp2
        ? scene.fog.color
        : defaultFog.clone();

    const state:
      PaletteTweenState = {
      ar:
        currentFloorA.r,

      ag:
        currentFloorA.g,

      ab:
        currentFloorA.b,

      br:
        currentFloorB.r,

      bg:
        currentFloorB.g,

      bb:
        currentFloorB.b,

      sr:
        sky.r,

      sg:
        sky.g,

      sb:
        sky.b,

      fr:
        fog.r,

      fg:
        fog.g,

      fb:
        fog.b,
    };

    paletteTween =
      gsap.to(
        state,
        {
          ar:
            colorA.r,

          ag:
            colorA.g,

          ab:
            colorA.b,

          br:
            darkFloor.r,

          bg:
            darkFloor.g,

          bb:
            darkFloor.b,

          sr:
            targetSky.r,

          sg:
            targetSky.g,

          sb:
            targetSky.b,

          fr:
            targetFog.r,

          fg:
            targetFog.g,

          fb:
            targetFog.b,

          duration:
            2.4,

          ease:
            "power2.inOut",

          onUpdate:
            () => {
              currentFloorA.setRGB(
                state.ar,
                state.ag,
                state.ab,
              );

              currentFloorB.setRGB(
                state.br,
                state.bg,
                state.bb,
              );

              paintCheckerboard(
                currentFloorA,
                currentFloorB,
              );

              floorTexture.needsUpdate =
                true;

              floorMaterial.emissive.copy(
                colorB,
              );

              floorMaterial.emissiveIntensity =
                0.055;

              if (
                scene.background instanceof
                THREE.Color
              ) {
                scene.background.setRGB(
                  state.sr,
                  state.sg,
                  state.sb,
                );
              }

              if (
                scene.fog instanceof
                THREE.FogExp2
              ) {
                scene.fog.color.setRGB(
                  state.fr,
                  state.fg,
                  state.fb,
                );
              }

              blueLight.color.lerp(
                colorA,
                0.035,
              );

              creamLight.color.lerp(
                highlight,
                0.03,
              );
            },
        },
      );
  }

