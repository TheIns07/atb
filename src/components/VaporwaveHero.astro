        /* =====================================================
           INTRO
        ====================================================== */

        async function enterExperience() {

            if (
                experienceActive ||
                transitioning ||
                ending
            ) {
                return;
            }

            transitioning =
                true;

            travelling =
                false;

            modalOpen =
                false;

            updateHud(
                0,
            );

            canvas.style.pointerEvents =
                "none";

            content.style.pointerEvents =
                "none";

            loaderScreen.classList.remove(
                "hidden",
            );

            loaderScreen.setAttribute(
                "aria-hidden",
                "false",
            );

            loaderScreen.style.opacity =
                "0";

            experienceWord.style.opacity =
                "0";

            gsap.to(
                content,
                {

                    opacity:
                        0,

                    duration:
                        0.7,

                    ease:
                        "power2.inOut",

                },
            );

            /*
             * Progressive white transition.
             */

            gsap.to(
                loaderScreen,
                {

                    opacity:
                        1,

                    duration:
                        2,

                    ease:
                        "power2.inOut",

                },
            );

            await sleep(
                2000,
            );

            /*
             * 記憶 = memory
             */

            gsap.fromTo(

                experienceWord,

                {

                    opacity:
                        0,

                    y:
                        10,

                    scale:
                        0.985,

                },

                {

                    opacity:
                        1,

                    y:
                        0,

                    scale:
                        1,

                    duration:
                        0.65,

                    ease:
                        "power3.out",

                },

            );

            await Promise.all([

                worldReady,

                sleep(
                    1000,
                ),

            ]);

            camera.position.copy(
                experienceStart,
            );

            cameraTarget.set(
                0,
                2.1,
                -45,
            );

            renderer.render(
                scene,
                camera,
            );

            canvas.style.opacity =
                "1";

            canvas.style.pointerEvents =
                "auto";

            experienceActive =
                true;

            travelling =
                true;

            experienceUI.setAttribute(
                "aria-hidden",
                "false",
            );

            gsap.to(
                experienceUI,
                {

                    opacity:
                        1,

                    duration:
                        0.45,

                },
            );

            gsap.to(
                loaderScreen,
                {

                    opacity:
                        0,

                    duration:
                        0.8,

                    ease:
                        "power2.inOut",

                    onComplete:
                        () => {

                            loaderScreen.classList.add(
