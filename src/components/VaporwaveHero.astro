    /* ============================================================
       COLOR PALETTE

       Utilizamos los colores guardados en cada AlbumDescriptor.
       No hace falta analizar de nuevo el AVIF.
    ============================================================ */

    const defaultSkyColor = new THREE.Color("#7f91a5");

    const defaultFogColor = new THREE.Color("#cfd7e3");

    if (scene.background === null) {
      scene.background = defaultSkyColor.clone();
    }

    function hexColor(value: string): THREE.Color {
      return new THREE.Color(value);
    }

    function setSkyPaletteVariables(album: AlbumDescriptor): void {
      vaporwaveRoot.style.setProperty("--vw-color-a", album.palette.glowA);

      vaporwaveRoot.style.setProperty("--vw-color-b", album.palette.glowB);

      vaporwaveRoot.style.setProperty("--vw-color-c", album.palette.glowC);

      skyLightLayer.classList.add("is-active");
    }

    function pauseSkyPalette(): void {
      skyLightLayer.classList.add("is-paused");
    }

    function resumeSkyPalette(): void {
      if (currentPlayerAlbum === null) {
        return;
      }

      skyLightLayer.classList.remove("is-paused");

      skyLightLayer.classList.add("is-active");
    }

    function setEndlessPaletteMode(active: boolean): void {
      skyLightLayer.classList.toggle("is-endless", active);
    }

    /* ============================================================
       PALETTE TRANSITION
    ============================================================ */

    function transitionAlbumPalette(
      album: AlbumDescriptor,

      duration = 1600,
    ): void {
      cancelAnimationFrame(paletteAnimationFrame);

      setSkyPaletteVariables(album);

      const targetFloorA = hexColor(album.palette.surfaceA);

      const targetFloorB = hexColor(album.palette.surfaceB);

      const targetSky = hexColor(album.palette.horizon).lerp(
        defaultSkyColor,
        0.58,
      );

      const targetFog = hexColor(album.palette.surfaceA).lerp(
        defaultFogColor,
        0.68,
      );

      const startFloorA = currentFloorA.clone();

      const startFloorB = currentFloorB.clone();

      const currentBackground =
        scene.background instanceof THREE.Color
          ? scene.background.clone()
          : defaultSkyColor.clone();

      const currentFog =
        scene.fog instanceof THREE.Fog
          ? scene.fog.color.clone()
          : defaultFogColor.clone();

      const started = performance.now();

      const animatePalette = (now: number): void => {
        const progress = clamp01((now - started) / duration);

        const eased = easeInOutCubic(progress);

        currentFloorA.copy(startFloorA).lerp(targetFloorA, eased);

        currentFloorB.copy(startFloorB).lerp(targetFloorB, eased);

        paintCheckerboard(currentFloorA, currentFloorB);

        if (floorTexture instanceof THREE.CanvasTexture) {
          floorTexture.needsUpdate = true;
        }

        if (scene.background instanceof THREE.Color) {
          scene.background.copy(currentBackground).lerp(targetSky, eased);
        }

        if (scene.fog instanceof THREE.Fog) {
          scene.fog.color.copy(currentFog).lerp(targetFog, eased);
        }

        if (floorMaterial instanceof THREE.MeshStandardMaterial) {
          const emissive = hexColor(album.palette.glowB);

          floorMaterial.emissive.copy(emissive);

          floorMaterial.emissiveIntensity = 0.025 + eased * 0.035;
        }

        if (progress < 1) {
          paletteAnimationFrame = requestAnimationFrame(animatePalette);
        }
      };

      paletteAnimationFrame = requestAnimationFrame(animatePalette);
    }

    /* ============================================================
       RESET COLOR PALETTE
    ============================================================ */

    function resetAlbumPalette(immediate = false): void {
      cancelAnimationFrame(paletteAnimationFrame);

      skyLightLayer.classList.remove("is-active", "is-paused", "is-endless");

      vaporwaveRoot.style.removeProperty("--vw-color-a");

      vaporwaveRoot.style.removeProperty("--vw-color-b");

      vaporwaveRoot.style.removeProperty("--vw-color-c");

      const applyDefault = (): void => {
        currentFloorA.copy(defaultFloorA);

        currentFloorB.copy(defaultFloorB);

        paintCheckerboard(currentFloorA, currentFloorB);

        if (floorTexture instanceof THREE.CanvasTexture) {
          floorTexture.needsUpdate = true;
        }

        scene.background = defaultSkyColor.clone();

        if (scene.fog instanceof THREE.Fog) {
          scene.fog.color.copy(defaultFogColor);
        }

        if (floorMaterial instanceof THREE.MeshStandardMaterial) {
          floorMaterial.emissive.set(0x000000);

          floorMaterial.emissiveIntensity = 0;
        }
      };

      if (immediate) {
        applyDefault();

        return;
      }

      const startA = currentFloorA.clone();

      const startB = currentFloorB.clone();

      const startSky =
        scene.background instanceof THREE.Color
          ? scene.background.clone()
          : defaultSkyColor.clone();

      const startFog =
        scene.fog instanceof THREE.Fog
          ? scene.fog.color.clone()
          : defaultFogColor.clone();

      const started = performance.now();

      const duration = 900;

      const animateDefault = (now: number): void => {
        const progress = clamp01((now - started) / duration);

        const eased = easeInOutCubic(progress);

        currentFloorA.copy(startA).lerp(defaultFloorA, eased);

        currentFloorB.copy(startB).lerp(defaultFloorB, eased);

        paintCheckerboard(currentFloorA, currentFloorB);

        if (floorTexture instanceof THREE.CanvasTexture) {
          floorTexture.needsUpdate = true;
        }

        if (scene.background instanceof THREE.Color) {
          scene.background.copy(startSky).lerp(defaultSkyColor, eased);
        }

        if (scene.fog instanceof THREE.Fog) {
          scene.fog.color.copy(startFog).lerp(defaultFogColor, eased);
        }

        if (progress < 1) {
          paletteAnimationFrame = requestAnimationFrame(animateDefault);

          return;
        }

        applyDefault();
      };

      paletteAnimationFrame = requestAnimationFrame(animateDefault);
    }

    /* ============================================================
       PLAYER STATE CHANGE
    ============================================================ */

    function scheduleFeedbackLoopEnd(): void {
      /*
       * Un END natural significa que ya no hay
       * reproducción activa.
       *
       * Dejamos un margen para escoger otra
       * canción desde ARCHIVE LOOP.
       */
      clearFeedbackEndTimer();

      const token = feedbackEndToken;

      playlistDock.classList.add("awaiting-selection");

      finalChoiceTimeout = window.setTimeout(() => {
        if (token !== feedbackEndToken) {
          return;
        }

        playlistDock.classList.remove("awaiting-selection");

        /*
         * Si empezó otra canción:
         * seguimos.
         */
        if (playbackIsActive()) {
          return;
        }

        /*
         * Pause NO entra aquí.
         * Sólo se llama en estado ENDED.
         */
        if (feedbackLoopMode) {
          runNoSignal();
        }
      }, 1800);
    }

    function handleYouTubeState(state: number): void {
      youtubeState = state;

      updatePlayerToggle();

      /*
       * PLAYING
       */
      if (state === 1) {
        clearFeedbackEndTimer();

        playlistDock.classList.remove("awaiting-selection");

        resumeSkyPalette();
      }

      /*
       * PAUSED

       * Importante:
       * NO terminamos el feedback loop.
       */
      if (state === 2) {
        pauseSkyPalette();

        return;
      }

      /*
       * BUFFERING
       */
      if (state === 3) {
        clearFeedbackEndTimer();

        resumeSkyPalette();

        return;
      }

      /*
       * ENDED
       */
      if (state === 0 && feedbackLoopMode) {
        scheduleFeedbackLoopEnd();
      }
    }

    /* ============================================================
       CREATE YOUTUBE PLAYER
    ============================================================ */

    async function createYouTubePlayer(album: AlbumDescriptor): Promise<void> {
      const YT = await loadYouTubeAPI();

      ensureYouTubeMount();

      youtubePlayer = new YT.Player("youtube-player-mount", {
        videoId: album.youtubeId,

        width: "320",

        height: "180",

        playerVars: {
          autoplay: 1,

          controls: 0,

          rel: 0,

          playsinline: 1,

          modestbranding: 1,
        },

        events: {
          onReady: (event: YouTubeReadyEvent) => {
            playerReady = true;

            event.target.playVideo();

            updatePlayerProgress();
          },

          onStateChange: (event: YouTubeStateEvent) => {
            handleYouTubeState(event.data);
          },
        },
      });
    }

    /* ============================================================
       PLAY ALBUM

       fromModal:
       true  -> seleccionado desde tarjeta
       false -> seleccionado desde playlist final
    ============================================================ */

    async function playAlbum(
      index: number,

      _fromModal: boolean,
    ): Promise<void> {
      const album = albums[index];

      if (album === undefined) {
        return;
      }

      clearFeedbackEndTimer();

      playlistDock.classList.remove("awaiting-selection");

      currentPlayerAlbum = index;

      activeAlbum = album;

      playerCover.setAttribute("src", album.image);

      playerCover.setAttribute("alt", album.title);

      playerTitle.textContent = album.title;

      playerArtist.textContent = `${album.artist} · ${album.year}`;

      playerSeek.value = "0";

      playerCurrent.textContent = "0:00";

      playerDuration.textContent = "0:00";

      updateSeekVisual(0);

      updatePlaylistActiveTrack(index);

      transitionAlbumPalette(album);

      showPlayerDock();

      if (feedbackLoopMode) {
        promotePlayerToFeedback();

        setEndlessPaletteMode(true);
      }

      const existingPlayer = youtubePlayer as YouTubePlayer | null;

      if (existingPlayer !== null && playerReady) {
        existingPlayer.loadVideoById(album.youtubeId);

        existingPlayer.playVideo();

        return;
      }

      if (existingPlayer !== null) {
        try {
          existingPlayer.destroy();
        } catch (error: unknown) {
          console.warn(error);
        }

        youtubePlayer = null;

        playerReady = false;

        playerHost.innerHTML = '<div id="youtube-player-mount"></div>';
      }

      await createYouTubePlayer(album);
    }

    /* ============================================================
       PLAY / PAUSE BUTTON
    ============================================================ */

    playerToggle.addEventListener("click", () => {
      const player = youtubePlayer as YouTubePlayer | null;

      if (player === null) {
        return;
      }

      const state = player.getPlayerState();

      if (state === 1 || state === 3) {
        /*
         * Pause no termina el feedback loop.
         */
        player.pauseVideo();

        return;
      }

      clearFeedbackEndTimer();

      player.playVideo();
    });

    /* ============================================================
       DESTROY PLAYER
    ============================================================ */

    function destroyYouTubePlayer(): void {
      clearFeedbackEndTimer();

      stopPlayerProgress();

      const player = youtubePlayer as YouTubePlayer | null;

      if (player !== null) {
        try {
          player.destroy();
        } catch (error: unknown) {
          console.warn(error);
        }
      }

      youtubePlayer = null;

      playerReady = false;

      youtubeState = -1;

      currentPlayerAlbum = null;

      playerHost.innerHTML = '<div id="youtube-player-mount"></div>';

      playerSeek.value = "0";

      playerCurrent.textContent = "0:00";

      playerDuration.textContent = "0:00";

      updateSeekVisual(0);

      updatePlayerToggle();

      hidePlayerDock(true);
    }

    /* ============================================================
       PLAYER X

       Normal:
       sólo cierra reproductor.

       Feedback loop:
       X termina la experiencia.
    ============================================================ */

    playerClose.addEventListener("click", (event: MouseEvent) => {
      event.stopPropagation();

      /*
       * FINAL LOOP:
       * la X es el final voluntario.
       */
      if (feedbackLoopMode) {
        destroyYouTubePlayer();

        runNoSignal();

        return;
      }

      const player = youtubePlayer as YouTubePlayer | null;

      if (player !== null) {
        player.pauseVideo();
      }

      destroyYouTubePlayer();

      resetAlbumPalette();
    });

    /* ============================================================
       FEEDBACK LOOP PLAYLIST INTERACTION

       Mientras el mouse está sobre la playlist
       no afecta al canvas.
    ============================================================ */

    playlistDock.addEventListener("pointerenter", () => {
      canvas.style.cursor = "default";
    });

    /* ============================================================
       ENTER FEEDBACK LOOP

       Aquí:
       - desaparece la ciudad
       - permanece checkerboard
       - año = ∞
       - player crece
       - aparece ARCHIVE LOOP
       - pausa NO termina nada
    ============================================================ */

    function enterFeedbackLoop(): void {
      if (feedbackLoopMode) {
        return;
      }

      feedbackLoopMode = true;

      hasReachedEnd = true;

      /*
       * Ya no necesitamos seguir descargando
       * escenas futuras.
       */
      cancelModelStreaming();

      /*
       * Oculta mundo generado.
       */
      skylineGroup.visible = false;

      architectureGroup.visible = false;

      propGroup.visible = false;

      cardGroup.visible = false;

      /*
       * Cámara estable.
       */
      camera.position.set(
        0,

        isMobile ? 3.8 : 3.3,

        endlessCameraZ,
      );

      cameraTarget.set(
        0,

        isMobile ? 1.65 : 2.05,

        -948,
      );

      changeDisplayedYear("∞");

      showArchivePlaylist();

      setEndlessPaletteMode(true);

      /*
       * Si existe canción cargada,
       * agrandamos reproductor.
       *
       * Incluso PAUSADA se considera
       * sesión válida.
       */
      if (trackIsLoaded()) {
        promotePlayerToFeedback();

        return;
      }

      /*
       * No existe ninguna canción.
       *
       * Según la lógica narrativa,
       * no hay motivo para sostener el loop.
       */
      window.setTimeout(() => {
        if (!feedbackLoopMode) {
          return;
        }

        if (trackIsLoaded()) {
          return;
        }

        runNoSignal();
      }, 500);
    }

    /* ============================================================
       LEAVE FEEDBACK VISUAL STATE

       Se usa durante cleanup.
    ============================================================ */

    function resetFeedbackLoop(): void {
      feedbackLoopMode = false;

      hasReachedEnd = false;

      clearFeedbackEndTimer();

      restorePlayerFromFeedback();

      hideArchivePlaylist(true);

      setEndlessPaletteMode(false);

      skylineGroup.visible = buildingsReady;

      architectureGroup.visible = true;

      propGroup.visible = true;

      cardGroup.visible = true;

      if (floorTexture instanceof THREE.CanvasTexture) {
        floorTexture.offset.set(0, 0);
      }
    }

    /* ============================================================
       ENDLESS FLOOR MOVEMENT

       En lugar de mandar la cámara a -100000,
       desplazamos sólo la textura.
    ============================================================ */

    function updateFeedbackFloor(
      elapsed: number,

      delta: number,
    ): void {
      if (!feedbackLoopMode) {
        return;
      }

      if (!(floorTexture instanceof THREE.CanvasTexture)) {
        return;
      }

      floorTexture.offset.y -= delta * (isMobile ? 0.42 : 0.52);

      floorTexture.offset.x += Math.sin(elapsed * 0.28) * delta * 0.012;

      camera.position.x = Math.sin(elapsed * 0.15) * 0.05;

      camera.position.y =
        (isMobile ? 3.8 : 3.3) + Math.sin(elapsed * 0.3) * 0.045;

      cameraTarget.set(
        camera.position.x * 0.03,

        isMobile ? 1.65 : 2.05,

        -948,
      );

      /*
       * Respiración muy sutil de la luz.
       * No añade geometría ni efectos pesados.
       */
      backgroundPulse = (Math.sin(elapsed * 0.42) + 1) / 2;

      skyLightLayer.style.setProperty(
        "--feedback-pulse",
        String(backgroundPulse),
      );
    }

    /* ============================================================
       PLAYER / PLAYLIST FEEDBACK MODE SYNC
    ============================================================ */

    function updateFeedbackInterface(): void {
      if (!feedbackLoopMode) {
        return;
      }

      if (currentPlayerAlbum !== null) {
        updatePlaylistActiveTrack(currentPlayerAlbum);
      }

      if (trackIsLoaded()) {
        promotePlayerToFeedback();
      }
    }

    /* ============================================================
       RESET PLAYER STATE FOR REENTRY
    ============================================================ */

    function resetPlayerExperienceState(): void {
      clearFeedbackEndTimer();

      stopPlayerProgress();

      isSeeking = false;

      youtubeState = -1;

      currentPlayerAlbum = null;

      activeAlbum = null;

      playerSeek.value = "0";

      playerCurrent.textContent = "0:00";

      playerDuration.textContent = "0:00";

      updateSeekVisual(0);

      updatePlayerToggle();

      hidePlayerDock(true);

      hideArchivePlaylist(true);

      playerDock.classList.remove("is-feedback", "is-visible");

      playlistDock.classList.remove("is-visible", "awaiting-selection");
    }

    /* ============================================================
       EXPERIENCE DOM REFERENCES
    ============================================================ */

    const enterButton = document.getElementById("vaporwave-enter");

    const experienceWord = document.getElementById("experience-word");

    if (
      !(enterButton instanceof HTMLButtonElement) ||
      !(experienceWord instanceof HTMLElement)
    ) {
      throw new Error(
        "[Vaporwave] No se encontraron los controles de entrada.",
      );
    }

    /* ============================================================
       EXPERIENCE CAMERA RESET
    ============================================================ */

    function resetCamera(): void {
      camera.position.copy(experienceCameraStart);

      cameraTarget.copy(normalCameraTarget);

      camera.lookAt(cameraTarget);
    }

    resetCamera();

    /* ============================================================
       UI RESET
    ============================================================ */

    function resetExperienceUI(): void {
      resetArchiveInteraction();

      resetFeedbackLoop();

      resetPlayerExperienceState();

      resetCamera();

      experienceActive = false;

      isLoadingExperience = false;

      hasReachedEnd = false;

      feedbackLoopMode = false;

      noSignalVisible = false;

      endLoopPlaylistVisible = false;

      pendingStartAfterLoad = false;

      ui.setAttribute("aria-hidden", "true");

      ui.classList.remove("is-visible");

      canvas.style.opacity = "0";

      canvas.style.pointerEvents = "none";

      noSignal.classList.add("hidden");

      noSignal.classList.remove("is-visible");

      noSignal.setAttribute("aria-hidden", "true");

      loaderOverlay.classList.add("hidden");

      loaderOverlay.classList.remove("is-visible");

      loaderOverlay.setAttribute("aria-hidden", "true");

      landing.style.opacity = "1";

      landing.style.pointerEvents = "auto";
    }

    /* ============================================================
       LOADER VISUAL PROGRESS

       El porcentaje real llega desde las portadas.
       Este pequeño interpolador evita saltos bruscos.
    ============================================================ */

    function animateLoadingProgress(): void {
      cancelAnimationFrame(loadingVisualTick);

      let visualValue = 0;

      const tick = (): void => {
        if (!isLoadingExperience) {
          return;
        }

        visualValue += (loadingProgressValue - visualValue) * 0.12;

        if (Math.abs(loadingProgressValue - visualValue) < 0.25) {
          visualValue = loadingProgressValue;
        }

        loaderProgress.textContent = String(Math.round(visualValue)).padStart(
          3,
          "0",
        );

        loadingVisualTick = requestAnimationFrame(tick);
      };

      loadingVisualTick = requestAnimationFrame(tick);
    }

    function stopLoadingProgress(): void {
      cancelAnimationFrame(loadingVisualTick);

      loadingVisualTick = 0;
    }

    /* ============================================================
       SHOW EXPERIENCE LOADER
    ============================================================ */

    async function showExperienceLoader(): Promise<void> {
      loaderOverlay.classList.remove("hidden");

      loaderOverlay.setAttribute("aria-hidden", "false");

      loaderOverlay.classList.remove("is-visible");

      experienceWord.textContent = "読み込み中";

      experienceWord.classList.remove("is-welcome");

      loadingProgressValue = 0;

      loaderProgress.textContent = "000";

      requestAnimationFrame(() => {
        loaderOverlay.classList.add("is-visible");
      });

      animateLoadingProgress();

      await wait(420);
    }

    /* ============================================================
       HIDE EXPERIENCE LOADER
    ============================================================ */

    async function hideExperienceLoader(): Promise<void> {
      loadingProgressValue = 100;

      loaderProgress.textContent = "100";

      await wait(140);

      experienceWord.textContent = "ようこそ";

      experienceWord.classList.add("is-welcome");

      await wait(420);

      loaderOverlay.classList.remove("is-visible");

      await wait(520);

      loaderOverlay.classList.add("hidden");

      loaderOverlay.setAttribute("aria-hidden", "true");

      stopLoadingProgress();
    }

    /* ============================================================
       SHOW EXPERIENCE
    ============================================================ */

    function revealExperienceCanvas(): void {
      canvas.style.pointerEvents = "auto";

      canvas.style.opacity = "1";

      ui.setAttribute("aria-hidden", "false");

      requestAnimationFrame(() => {
        ui.classList.add("is-visible");
      });
    }

    /* ============================================================
       ENTER EXPERIENCE

       Bloquea únicamente:
       - AVIF de portadas
       - creación de tarjetas
       - primer shader compile

       NO bloquea:
       - edificios
       - bustos
       - malls
       - teatro
       - dolphin
       - commodore
    ============================================================ */

    async function enterExperience(): Promise<void> {
      if (experienceActive || isLoadingExperience || noSignalVisible) {
        return;
      }

      isLoadingExperience = true;

      pendingStartAfterLoad = true;

      /*
       * Nueva generación de recursos.
       */
      worldGeneration += 1;

      cancelModelStreaming();

      modelSources.clear();

      modelPromises.clear();

      sourceResources.clear();

      resetArchiveInteraction();

      resetFeedbackLoop();

      resetPlayerExperienceState();

      resetAlbumPalette(true);

      resetCamera();

      skylineGroup.clear();

      architectureGroup.clear();

      propGroup.clear();

      cardGroup.clear();

      skylineGroup.visible = false;

      architectureGroup.visible = true;

      propGroup.visible = true;

      cardGroup.visible = true;

      landing.style.pointerEvents = "none";

      /*
       * LANDING FADE
       */
      landing.classList.add("is-leaving");

      await showExperienceLoader();

      try {
        await prepareExperienceWorld();

        /*
         * Si la experiencia fue cancelada
         * mientras cargaba, no continuamos.
         */
        if (!pendingStartAfterLoad) {
          return;
        }

        await hideExperienceLoader();

        landing.style.opacity = "0";

        landing.classList.remove("is-leaving");

        experienceActive = true;

        isLoadingExperience = false;

        pendingStartAfterLoad = false;

        revealExperienceCanvas();

        /*
         * EL USUARIO YA VE LA EXPERIENCIA.

         * A partir de este momento comienza
         * el streaming 3D de fondo.
         */
        beginBackgroundWorldLoading();
      } catch (error: unknown) {
        console.error("[Vaporwave] Error preparando experiencia:", error);

        isLoadingExperience = false;

        pendingStartAfterLoad = false;

        stopLoadingProgress();

        loaderOverlay.classList.add("hidden");

        loaderOverlay.setAttribute("aria-hidden", "true");

        landing.style.opacity = "1";

        landing.style.pointerEvents = "auto";

        landing.classList.remove("is-leaving");
      }
    }

    enterButton.addEventListener("click", () => {
      void enterExperience();
    });

    /* ============================================================
       WORLD CLEANUP

       Se ejecuta al salir.

       IMPORTANTE:
       - aborta GLB en red
       - destruye objetos Three
       - libera geometrías
       - libera materiales
       - libera texturas de álbumes
       - limpia cache
    ============================================================ */

    function disposeCurrentWorld(): void {
      cancelModelStreaming();

      /*
       * Los clones del mundo comparten parte
       * de los recursos de las fuentes GLB.
       *
       * Una pasada sobre world es suficiente
       * para liberar lo que terminó en escena.
       */
      disposeObjectResources(world);

      skylineGroup.clear();

      architectureGroup.clear();

      propGroup.clear();

      cardGroup.clear();

      /*
       * Las fuentes originales ya no se necesitan.
       */
      sourceResources.clear();

      modelSources.clear();

      modelPromises.clear();

      albumCards.length = 0;

      albumHitboxes.length = 0;

      /*
       * Las texturas de portada fueron incluidas
       * en los materiales de las tarjetas, así que
       * ya están disposed.
       *
       * Eliminamos las referencias JS.
       */
      albumTextures.forEach((_texture, index) => {
        albumTextures[index] = null;
      });

      archiveDolphin = null;

      buildingsReady = false;

      revealStarted = false;

      buildingWarmupDone = false;

      lightPropsRequested = false;

      bustsRequested = false;

      mallsRequested = false;

      theatresRequested = false;

      dolphinRequested = false;

      commodoreRequested = false;

      renderer.renderLists.dispose();

      THREE.Cache.clear();
    }

    /* ============================================================
       LEAVE EXPERIENCE

       Esta es la salida manual del botón × superior.
    ============================================================ */

    async function leaveExperience(): Promise<void> {
      if (isLoadingExperience) {
        pendingStartAfterLoad = false;

        worldGeneration += 1;

        cancelModelStreaming();

        stopLoadingProgress();

        isLoadingExperience = false;

        loaderOverlay.classList.remove("is-visible");

        await wait(220);

        loaderOverlay.classList.add("hidden");

        loaderOverlay.setAttribute("aria-hidden", "true");

        landing.style.opacity = "1";

        landing.style.pointerEvents = "auto";

        landing.classList.remove("is-leaving");

        return;
      }

      if (!experienceActive && !feedbackLoopMode) {
        return;
      }

      experienceActive = false;

      hasReachedEnd = false;

      worldGeneration += 1;

      cancelModelStreaming();

      ui.classList.remove("is-visible");

      ui.setAttribute("aria-hidden", "true");

      canvas.style.pointerEvents = "none";

      hideArchivePlaylist(true);

      /*
       * Fade de la escena.
       */
      canvas.classList.add("is-leaving");

      await wait(420);

      destroyYouTubePlayer();

      resetFeedbackLoop();

      resetAlbumPalette(true);

      disposeCurrentWorld();

      resetCamera();

      canvas.style.opacity = "0";

      canvas.classList.remove("is-leaving");

      landing.style.opacity = "1";

      landing.style.pointerEvents = "auto";

      landing.classList.remove("is-leaving");

      resetArchiveInteraction();
    }

    exitButton.addEventListener("click", () => {
      void leaveExperience();
    });

    /* ============================================================
       NO SIGNAL

       Se usa cuando:
       - X del reproductor durante ∞
       - canción finaliza y no seleccionamos otra
       - se llega a ∞ sin reproducción alguna
    ============================================================ */

    function runNoSignal(): void {
      if (noSignalVisible) {
        return;
      }

      noSignalVisible = true;

      experienceActive = false;

      hasReachedEnd = true;

      clearFeedbackEndTimer();

      cancelModelStreaming();

      modalOpen = false;

      modal.classList.remove("is-visible");

      modal.classList.add("hidden");

      hideArchivePlaylist(true);

      ui.classList.remove("is-visible");

      ui.setAttribute("aria-hidden", "true");

      canvas.style.pointerEvents = "none";

      /*
       * No destruimos el canvas todavía:
       * la transición al TV queda más limpia.
       */
      noSignal.classList.remove("hidden");

      noSignal.setAttribute("aria-hidden", "false");

      requestAnimationFrame(() => {
        noSignal.classList.add("is-visible");
      });

      /*
       * La señal permanece brevemente.
       */
      window.setTimeout(() => {
        void transitionNoSignalToLanding();
      }, 1450);
    }

    /* ============================================================
       NO SIGNAL -> LANDING
    ============================================================ */

    async function transitionNoSignalToLanding(): Promise<void> {
      destroyYouTubePlayer();

      resetFeedbackLoop();

      disposeCurrentWorld();

      resetAlbumPalette(true);

      resetCamera();

      canvas.style.opacity = "0";

      landing.style.opacity = "1";

      landing.style.pointerEvents = "auto";

      landing.classList.remove("is-leaving");

      /*
       * Primero dejamos aparecer landing detrás.
       */
      await wait(180);

      noSignal.classList.remove("is-visible");

      await wait(720);

      noSignal.classList.add("hidden");

      noSignal.setAttribute("aria-hidden", "true");

      noSignalVisible = false;

      hasReachedEnd = false;

      feedbackLoopMode = false;

      experienceActive = false;

      resetArchiveInteraction();
    }

    /* ============================================================
       CAMERA TRAVEL
    ============================================================ */

    function updateNormalTravel(
      elapsed: number,

      delta: number,
    ): void {
      if (
        !experienceActive ||
        feedbackLoopMode ||
        modalOpen ||
        noSignalVisible
      ) {
        return;
      }

      /*
       * Streaming basado en la posición actual.
       */
      updateHeavyAssetStreaming();

      camera.position.z -= travelSpeed * delta;

      /*
       * Movimiento mínimo:
       * evita aspecto totalmente robótico.
       */
      camera.position.x = Math.sin(elapsed * 0.14) * (isMobile ? 0.035 : 0.075);

      const baseY = isMobile ? 3.8 : 3.3;

      camera.position.y = baseY + Math.sin(elapsed * 0.32) * 0.05;

      cameraTarget.set(
        camera.position.x * 0.02,

        isMobile ? 1.65 : 2.15,

        camera.position.z - (isMobile ? 40 : 48),
      );

      updateYearFromCamera();

      /*
       * Fin cronológico.
       */
      if (camera.position.z <= timelineEndZ) {
        enterFeedbackLoop();
      }
    }

    /* ============================================================
       END LOOP SAFETY

       Si estamos en ∞ y no existe absolutamente
       ninguna sesión de audio, terminamos.

       PAUSA cuenta como sesión válida porque
       currentPlayerAlbum/youtubePlayer siguen existiendo.
    ============================================================ */

    function validateFeedbackLoopSession(): void {
      if (!feedbackLoopMode || noSignalVisible) {
        return;
      }

      /*
       * Existe player, incluso pausado:
       * no hacemos nada.
       */
      if (currentPlayerAlbum !== null && youtubePlayer !== null) {
        return;
      }

      /*
       * No hay absolutamente nada cargado.
       */
      runNoSignal();
    }

    /* ============================================================
       MASTER CLOCK
    ============================================================ */

    const clock = new THREE.Clock();

    /* ============================================================
       MASTER RENDER LOOP
    ============================================================ */

    function render(): void {
      if (sceneDisposed) {
        return;
      }

      animationFrame = requestAnimationFrame(render);

      const delta = Math.min(clock.getDelta(), 0.05);

      const elapsed = clock.elapsedTime;

      /*
       * Tarjetas sólo se animan cuando
       * forman parte visible del mundo.
       */
      if (cardGroup.visible) {
        updateAlbumCards(elapsed);

        updateCardHover();
      }

      updateDolphin(elapsed);

      if (experienceActive) {
        if (feedbackLoopMode) {
          updateFeedbackFloor(elapsed, delta);

          updateFeedbackInterface();

          /*
           * No ejecutamos cada frame una destrucción.
           * Sólo valida la condición simple.
           */
          validateFeedbackLoopSession();
        } else {
          updateNormalTravel(elapsed, delta);
        }
      }

      camera.lookAt(cameraTarget);

      renderer.render(scene, camera);
    }

    render();

    /* ============================================================
       VISIBILITY OPTIMIZATION

       Si la pestaña no está visible, detenemos
       temporalmente el clock para evitar un salto
       enorme al volver.
    ============================================================ */

    function handleVisibilityChange(): void {
      if (document.hidden) {
        clock.stop();

        return;
      }

      clock.start();
    }

    document.addEventListener("visibilitychange", handleVisibilityChange);

    /* ============================================================
       ASTRO PAGE CLEANUP
    ============================================================ */

    function destroyVaporwaveHero(): void {
      if (sceneDisposed) {
        return;
      }

      sceneDisposed = true;

      pendingStartAfterLoad = false;

      worldGeneration += 1;

      cancelModelStreaming();

      stopLoadingProgress();

      cancelAnimationFrame(animationFrame);

      cancelAnimationFrame(paletteAnimationFrame);

      cancelAnimationFrame(progressRaf);

      clearFeedbackEndTimer();

      resizeObserver.disconnect();

      document.removeEventListener("visibilitychange", handleVisibilityChange);

      window.removeEventListener("keydown", handleEscape);

      destroyYouTubePlayer();

      disposeCurrentWorld();

      floorMesh.geometry.dispose();

      if (floorMaterial instanceof THREE.MeshStandardMaterial) {
        floorMaterial.dispose();
      }

      if (floorTexture instanceof THREE.CanvasTexture) {
        floorTexture.dispose();
      }

      marbleMaterial.dispose();

      darkMaterial.dispose();

      renderer.dispose();

      /*
       * Three puede mantener referencias internas
       * al contexto WebGL. forceContextLoss ayuda
       * especialmente si Astro cambia de página.
       */
      renderer.forceContextLoss();

      vaporwaveRoot.removeAttribute("data-vaporwave-initialized");
    }

    document.addEventListener("astro:before-swap", destroyVaporwaveHero, {
      once: true,
    });

    /* ============================================================
       INITIAL STATE
    ============================================================ */

    resetExperienceUI();

    renderer.render(scene, camera);
  }
</script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Gideon+Roman&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500&family=Noto+Sans+JP:wght@400;500&display=swap");

  * {
    box-sizing: border-box;
  }

  .hidden {
    display: none !important;
  }

  /* ============================================================
       ROOT
    ============================================================ */

  .vaporwave-root {
    position: relative;

    width: 100%;
    height: 100dvh;
    min-height: 100dvh;

    overflow: clip;

    isolation: isolate;

    background: #000;

    color: #eee9df;

    overscroll-behavior: auto;

    touch-action: pan-y pinch-zoom;

    --vw-color-a: #af85e8;
    --vw-color-b: #497fa8;
    --vw-color-c: #e1b4ef;

    --feedback-pulse: 0.5;
  }

  .vaporwave-canvas {
    position: absolute;

    z-index: 0;

    inset: 0;

    display: block;

    width: 100%;
    height: 100%;

    opacity: 0;

    pointer-events: none;

    touch-action: pan-y pinch-zoom;

    transition: opacity 0.6s ease;
  }

  .vaporwave-canvas.is-leaving {
    opacity: 0 !important;
  }

  /* ============================================================
       BUILDING HEAT WAVE
    ============================================================ */

  .building-heatwave {
    position: absolute;

    z-index: 3;

    top: 26%;
    left: -8%;
    right: -8%;

    height: 52%;

    overflow: hidden;

    opacity: 0;

    pointer-events: none;

    transform: translateZ(0);
  }

  .building-heatwave.is-active {
    animation: buildingHeatEnvelope 1.7s cubic-bezier(0.2, 0.72, 0.25, 1) both;
  }

  .heatwave-band {
    position: absolute;

    left: -4%;

    width: 108%;
    height: 15%;

    border-radius: 50%;

    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 246, 225, 0.035) 20%,
      rgba(255, 255, 255, 0.16) 50%,
      rgba(255, 238, 206, 0.045) 78%,
      transparent 100%
    );

    backdrop-filter: blur(4px) saturate(1.12);

    -webkit-backdrop-filter: blur(4px) saturate(1.12);

    will-change: transform, opacity;
  }

  .heatwave-band-a {
    top: 10%;
  }

  .heatwave-band-b {
    top: 42%;

    opacity: 0.72;
  }

  .heatwave-band-c {
    top: 72%;

    opacity: 0.5;
  }

  .building-heatwave.is-active .heatwave-band-a {
    animation: buildingHeatA 0.31s ease-in-out infinite alternate;
  }

  .building-heatwave.is-active .heatwave-band-b {
    animation: buildingHeatB 0.27s ease-in-out infinite alternate;
  }

  .building-heatwave.is-active .heatwave-band-c {
    animation: buildingHeatC 0.35s ease-in-out infinite alternate;
  }

  @keyframes buildingHeatEnvelope {
    0% {
      opacity: 0;
    }

    15% {
      opacity: 0.78;
    }

    55% {
      opacity: 0.46;
    }

    100% {
      opacity: 0;
    }
  }

  @keyframes buildingHeatA {
    from {
      transform: translate3d(-1.2%, -3px, 0) skewX(-2deg) scaleX(1.01);
    }

    to {
      transform: translate3d(1.5%, 5px, 0) skewX(2.5deg) scaleX(1.025);
    }
  }

  @keyframes buildingHeatB {
    from {
      transform: translate3d(1%, 5px, 0) skewX(2deg) scaleX(1.02);
    }

    to {
      transform: translate3d(-1.7%, -4px, 0) skewX(-3deg) scaleX(0.995);
    }
  }

  @keyframes buildingHeatC {
    from {
      transform: translate3d(-0.8%, 3px, 0) skewX(-1deg);
    }

    to {
      transform: translate3d(1.1%, -5px, 0) skewX(2deg);
    }
  }

  /* ============================================================
       SKY LIGHTS
    ============================================================ */

  .sky-light-layer {
    position: absolute;

    z-index: 2;

    top: 0;
    left: 0;
    right: 0;

    height: 59%;

    overflow: hidden;

    opacity: 0;

    pointer-events: none;

    mix-blend-mode: screen;

    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      rgba(0, 0, 0, 0.95) 55%,
      rgba(0, 0, 0, 0.38) 82%,
      transparent 100%
    );

    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      rgba(0, 0, 0, 0.95) 55%,
      rgba(0, 0, 0, 0.38) 82%,
      transparent 100%
    );

    transition: opacity 1.7s ease;
  }

  .sky-light-layer.is-active {
    opacity: 0.52;
  }

  .sky-light-layer.is-active.is-paused {
    /*
       * Pausamos el audio, pero NO apagamos
       * completamente el ambiente.
       */
    opacity: 0.24;
  }

  .sky-light-layer.is-active.is-endless {
    opacity: calc(0.58 + var(--feedback-pulse) * 0.12);
  }

  .sky-glow {
    position: absolute;

    border-radius: 50%;

    filter: blur(78px);

    will-change: transform;

    opacity: 0.58;
  }

  .sky-glow-a {
    width: 54vw;
    height: 38vh;

    left: -10vw;
    top: -7vh;

    background: radial-gradient(
      ellipse,
      color-mix(in srgb, var(--vw-color-a) 82%, transparent) 0%,
      color-mix(in srgb, var(--vw-color-a) 36%, transparent) 40%,
      transparent 73%
    );

    animation: skyGlowA 15s ease-in-out infinite alternate;
  }

  .sky-glow-b {
    width: 50vw;
    height: 35vh;

    right: -8vw;
    top: 1vh;

    background: radial-gradient(
      ellipse,
      color-mix(in srgb, var(--vw-color-b) 84%, transparent) 0%,
      color-mix(in srgb, var(--vw-color-b) 35%, transparent) 40%,
      transparent 74%
    );

    animation: skyGlowB 18s ease-in-out infinite alternate;
  }

  .sky-glow-c {
    width: 40vw;
    height: 24vh;

    left: 31vw;
    top: 4vh;

    opacity: 0.34;

    background: radial-gradient(
      ellipse,
      color-mix(in srgb, var(--vw-color-c) 68%, transparent) 0%,
      transparent 70%
    );

    animation: skyGlowC 21s ease-in-out infinite alternate;
  }

  @keyframes skyGlowA {
    from {
      transform: translate3d(-2%, -2%, 0) scale(1);
    }

    to {
      transform: translate3d(13%, 7%, 0) scale(1.14);
    }
  }

  @keyframes skyGlowB {
    from {
      transform: translate3d(4%, 0, 0) scale(1.03);
    }

    to {
      transform: translate3d(-12%, 8%, 0) scale(1.17);
    }
  }

  @keyframes skyGlowC {
    from {
      transform: translate3d(-4%, 3%, 0) scale(0.95);
    }

    to {
      transform: translate3d(7%, -3%, 0) scale(1.18);
    }
  }

  /* ============================================================
       SCREEN OVERLAYS
    ============================================================ */

  .screen-vignette,
  .screen-lines,
  .screen-noise {
    position: absolute;

    z-index: 4;

    inset: 0;

    pointer-events: none;
  }

  .screen-vignette {
    background: radial-gradient(
      circle at center,
      transparent 42%,
      rgba(4, 5, 6, 0.42) 100%
    );
  }

  .screen-lines {
    opacity: 0.09;

    mix-blend-mode: multiply;

    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 2px,
      rgba(0, 0, 0, 0.12) 3px,
      transparent 4px
    );
  }

  .screen-noise {
    opacity: 0.03;

    mix-blend-mode: screen;

    background: repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.025),
      rgba(255, 255, 255, 0.025) 1px,
      transparent 1px,
      transparent 6px
    );

    animation: screenNoise 0.15s steps(2) infinite;
  }

  @keyframes screenNoise {
    50% {
      transform: translate(1px, -1px);
    }
  }

  /* ============================================================
       LANDING
    ============================================================ */

  .vaporwave-landing {
    position: absolute;

    z-index: 20;

    inset: 0;

    display: grid;

    place-items: center;

    background: #000;

    opacity: 1;

    touch-action: pan-y pinch-zoom;

    transition: opacity 0.6s ease;
  }

  .vaporwave-landing.is-leaving {
    opacity: 0;
  }

  .landing-inner {
    width: min(1120px, calc(100% - 3rem));

    text-align: center;
  }

  .landing-title {
    margin: 0;

    color: #f0ece3;

    font-family: "Gideon Roman", serif;

    font-size: clamp(5rem, 12vw, 11rem);

    font-weight: 400;

    line-height: 0.82;

    letter-spacing: -0.035em;
  }

  .landing-subtitle {
    margin: 1.6rem 0 0;

    color: rgba(240, 236, 227, 0.88);

    font-family: "Gideon Roman", serif;

    font-size: clamp(1.55rem, 3vw, 2.7rem);

    font-weight: 400;

    letter-spacing: 0.055em;
  }

  .landing-actions {
    display: flex;

    justify-content: center;
    align-items: center;

    gap: 1.5rem;

    margin-top: 3.2rem;
  }

  .landing-button {
    position: relative;

    padding: 0.65rem 0;

    border: 0;

    background: transparent;

    color: rgba(240, 236, 227, 0.55);

    font-family: "IBM Plex Mono", monospace;

    font-size: 0.68rem;

    letter-spacing: 0.16em;

    text-decoration: none;

    cursor: pointer;

    transition: color 0.2s ease;
  }

  .landing-button:hover {
    color: #fff;
  }

  .landing-button::after {
    content: "";

    position: absolute;

    left: 50%;
    bottom: 0;

    width: 0;
    height: 1px;

    background: #fff;

    transform: translateX(-50%);

    transition: width 0.25s ease;
  }

  .landing-button:hover::after {
    width: 100%;
  }

  /* ============================================================
       EXPERIENCE LOADER
    ============================================================ */

  .experience-loader {
    position: absolute;

    z-index: 60;

    inset: 0;

    display: grid;

    place-items: center;

    overflow: hidden;

    background: #fff;

    opacity: 0;

    transition: opacity 0.52s ease;
  }

  .experience-loader.is-visible {
    opacity: 1;
  }

  .loader-white {
    position: absolute;

    inset: 0;

    background: #fff;
  }

  .loader-copy {
    position: relative;

    z-index: 2;

    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 1rem;

    opacity: 0;

    transform: translateY(7px);

    transition:
      opacity 0.35s ease,
      transform 0.45s ease;
  }

  .experience-loader.is-visible .loader-copy {
    opacity: 1;

    transform: translateY(0);
  }

  .experience-word {
    color: #080808;

    font-family: "Noto Sans JP", sans-serif;

    font-size: clamp(1.75rem, 4vw, 3rem);

    font-weight: 400;

    letter-spacing: 0.18em;

    transition:
      letter-spacing 0.35s ease,
      opacity 0.35s ease,
      transform 0.35s ease;
  }

  .experience-word.is-welcome {
    letter-spacing: 0.27em;

    transform: translateY(-3px);
  }

  .experience-load-progress {
    color: rgba(0, 0, 0, 0.35);

    font-family: "IBM Plex Mono", monospace;

    font-size: 0.58rem;

    font-variant-numeric: tabular-nums;

    letter-spacing: 0.22em;
  }

  /* ============================================================
       HUD
    ============================================================ */

  .experience-ui {
    position: absolute;

    z-index: 15;

    inset: 0;

    opacity: 0;

    pointer-events: none;

    transition: opacity 0.5s ease;
  }

  .experience-ui.is-visible {
    opacity: 1;
  }

  .experience-exit {
    position: absolute;

    top: 1.35rem;
    right: 1.45rem;

    z-index: 5;

    display: grid;

    place-items: center;

    width: 42px;
    height: 42px;

    padding: 0;

    pointer-events: auto;

    border: 1px solid rgba(255, 255, 255, 0.14);

    background: rgba(16, 17, 19, 0.28);

    backdrop-filter: blur(6px);

    -webkit-backdrop-filter: blur(6px);

    color: rgba(255, 255, 255, 0.78);

    font-family: "Inter", sans-serif;

    font-size: 1.25rem;

    cursor: pointer;

    transition:
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .experience-exit:hover {
    color: #111;

    background: #eee9df;

    border-color: #eee9df;
  }

  .experience-year {
    position: absolute;

    right: 1.65rem;

    bottom: max(1.25rem, env(safe-area-inset-bottom));

    color: #f0ece3;

    font-family: "Gideon Roman", serif;

    font-size: clamp(1.6rem, 2.6vw, 2.3rem);

    pointer-events: none;

    will-change: opacity, transform, filter;
  }

  .experience-year.year-leave {
    opacity: 0;

    transform: translateY(7px);

    filter: blur(3px);

    transition:
      opacity 0.13s ease,
      transform 0.13s ease,
      filter 0.13s ease;
  }

  .experience-year.year-enter {
    animation: yearEnter 0.32s cubic-bezier(0.2, 0.75, 0.2, 1) both;
  }

  @keyframes yearEnter {
    from {
      opacity: 0;

      transform: translateY(-7px);

      filter: blur(4px);
    }

    to {
      opacity: 1;

      transform: translateY(0);

      filter: blur(0);
    }
  }

  /* ============================================================
       PLAYER
    ============================================================ */

  .youtube-player-dock {
    position: absolute;

    z-index: 18;

    left: 1.4rem;

    bottom: max(1.35rem, env(safe-area-inset-bottom));

    display: grid;

    grid-template-columns:
      52px
      minmax(0, 1fr)
      34px
      30px;

    align-items: center;

    gap: 0.68rem;

    width: min(360px, calc(100vw - 2.8rem));

    min-height: 70px;

    padding: 0.48rem 0.58rem 0.48rem 0.48rem;

    pointer-events: auto;

    overflow: hidden;

    border: 1px solid rgba(238, 233, 223, 0.14);

    background: rgba(12, 13, 15, 0.9);

    backdrop-filter: blur(14px);

    -webkit-backdrop-filter: blur(14px);

    box-shadow: 0 18px 65px rgba(0, 0, 0, 0.32);

    opacity: 0;

    transform: translate3d(-16px, 10px, 0) scale(0.985);

    transition:
      opacity 0.38s ease,
      transform 0.55s cubic-bezier(0.2, 0.75, 0.2, 1),
      width 0.65s cubic-bezier(0.2, 0.75, 0.2, 1),
      min-height 0.65s cubic-bezier(0.2, 0.75, 0.2, 1),
      padding 0.65s cubic-bezier(0.2, 0.75, 0.2, 1),
      background 0.65s ease,
      border-color 0.65s ease,
      box-shadow 0.65s ease;
  }

  .youtube-player-dock.is-visible {
    opacity: 1;

    transform: translate3d(0, 0, 0) scale(1);
  }

  /* ============================================================
       PLAYER FEEDBACK LOOP
    
       Se vuelve más prominente cuando estamos en ∞.
    ============================================================ */

  .youtube-player-dock.is-feedback {
    width: min(500px, calc(100vw - 3rem));

    min-height: 118px;

    grid-template-columns:
      82px
      minmax(0, 1fr)
      42px
      34px;

    gap: 0.88rem;

    padding: 0.7rem 0.78rem 0.7rem 0.7rem;

    border-color: rgba(238, 233, 223, 0.24);

    background: rgba(9, 10, 12, 0.87);

    box-shadow:
      0 25px 95px rgba(0, 0, 0, 0.48),
      0 0 46px color-mix(in srgb, var(--vw-color-a) 12%, transparent);
  }

  .player-cover {
    display: block;

    width: 52px;
    height: 52px;

    object-fit: cover;

    transition:
      width 0.65s cubic-bezier(0.2, 0.75, 0.2, 1),
      height 0.65s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .youtube-player-dock.is-feedback .player-cover {
    width: 82px;
    height: 82px;
  }

  .player-information {
    min-width: 0;
  }

  .player-title {
    overflow: hidden;

    margin: 0;

    color: #efeadd;

    font-family: "Gideon Roman", serif;

    font-size: 1rem;

    line-height: 1.12;

    white-space: nowrap;

    text-overflow: ellipsis;

    transition: font-size 0.55s ease;
  }

  .youtube-player-dock.is-feedback .player-title {
    font-size: 1.28rem;
  }

  .player-artist {
    overflow: hidden;

    margin: 0.25rem 0 0;

    color: rgba(238, 233, 223, 0.45);

    font-family: "Inter", sans-serif;

    font-size: 0.56rem;

    white-space: nowrap;

    text-overflow: ellipsis;

    transition: font-size 0.55s ease;
  }

  .youtube-player-dock.is-feedback .player-artist {
    font-size: 0.63rem;
  }

  /* ============================================================
       PLAYER PROGRESS
    ============================================================ */

  .player-progress-shell {
    display: grid;

    grid-template-columns:
      34px
      minmax(0, 1fr)
      34px;

    align-items: center;

    gap: 0.45rem;

    width: 100%;

    margin-top: 0.55rem;
  }

  .player-time {
    color: rgba(238, 233, 223, 0.42);

    font-family: "IBM Plex Mono", monospace;

    font-size: 0.47rem;

    font-variant-numeric: tabular-nums;

    white-space: nowrap;
  }

  .player-time:last-child {
    text-align: right;
  }

  .player-seek {
    --seek-progress: 0%;

    width: 100%;
    height: 14px;

    margin: 0;

    padding: 0;

    appearance: none;
    -webkit-appearance: none;

    background: transparent;

    cursor: pointer;
  }

  .player-seek::-webkit-slider-runnable-track {
    width: 100%;
    height: 2px;

    border-radius: 99px;

    background: linear-gradient(
      90deg,
      rgba(238, 233, 223, 0.92) 0%,
      rgba(238, 233, 223, 0.92) var(--seek-progress),
      rgba(238, 233, 223, 0.15) var(--seek-progress),
      rgba(238, 233, 223, 0.15) 100%
    );
  }

  .player-seek::-webkit-slider-thumb {
    width: 8px;
    height: 8px;

    margin-top: -3px;

    appearance: none;
    -webkit-appearance: none;

    border: 0;

    border-radius: 50%;

    background: #eee9df;

    box-shadow: 0 0 0 3px rgba(238, 233, 223, 0.08);

    transition: transform 0.16s ease;
  }

  .player-seek:hover::-webkit-slider-thumb {
    transform: scale(1.35);
  }

  .player-seek::-moz-range-track {
    height: 2px;

    border: 0;

    border-radius: 99px;

    background: rgba(238, 233, 223, 0.15);
  }

  .player-seek::-moz-range-progress {
    height: 2px;

    border-radius: 99px;

    background: rgba(238, 233, 223, 0.92);
  }

  .player-seek::-moz-range-thumb {
    width: 8px;
    height: 8px;

    border: 0;

    border-radius: 50%;

    background: #eee9df;
  }

  /* ============================================================
       PLAYER CONTROLS
    ============================================================ */

  .player-toggle,
  .player-close {
    display: grid;

    place-items: center;

    padding: 0;

    border: 1px solid rgba(255, 255, 255, 0.11);

    background: transparent;

    color: rgba(255, 255, 255, 0.72);

    cursor: pointer;

    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      width 0.55s ease,
      height 0.55s ease;
  }

  .player-toggle:hover,
  .player-close:hover {
    background: rgba(255, 255, 255, 0.08);

    border-color: rgba(255, 255, 255, 0.24);

    color: #fff;
  }

  .player-toggle {
    width: 34px;
    height: 34px;

    border-radius: 50%;
  }

  .player-close {
    width: 30px;
    height: 30px;

    font-size: 0.9rem;
  }

  .youtube-player-dock.is-feedback .player-toggle {
    width: 42px;
    height: 42px;
  }

  .youtube-player-dock.is-feedback .player-close {
    width: 34px;
    height: 34px;
  }

  .player-icon-play {
    width: 0;
    height: 0;

    margin-left: 2px;

    border-top: 5px solid transparent;

    border-bottom: 5px solid transparent;

    border-left: 8px solid #eee9df;
  }

  .player-icon-pause {
    display: none;

    gap: 3px;
  }

  .player-icon-pause i {
    display: block;

    width: 2px;
    height: 10px;

    background: #eee9df;
  }

  .player-toggle.is-playing .player-icon-play {
    display: none;
  }

  .player-toggle.is-playing .player-icon-pause {
    display: flex;
  }

  .youtube-api-host {
    position: absolute;

    left: -9999px;
    bottom: -9999px;

    width: 320px;
    height: 180px;

    overflow: hidden;

    opacity: 0.001;

    pointer-events: none;
  }

  /* ============================================================
       ARCHIVE LOOP PLAYLIST
    ============================================================ */

  .archive-playlist {
    position: absolute;

    z-index: 17;

    top: 5rem;
    right: 1.45rem;

    width: min(300px, calc(100vw - 3rem));

    max-height: 58dvh;

    padding: 0.7rem;

    overflow: hidden;

    pointer-events: none;

    border: 1px solid rgba(238, 233, 223, 0.09);

    background: rgba(10, 11, 13, 0.62);

    backdrop-filter: blur(14px);

    -webkit-backdrop-filter: blur(14px);

    opacity: 0;

    filter: blur(5px);

    transform: translate3d(22px, -7px, 0);

    transition:
      opacity 0.62s ease,
      transform 0.72s cubic-bezier(0.18, 0.78, 0.2, 1),
      filter 0.58s ease,
      border-color 0.35s ease;
  }

  .archive-playlist.is-visible {
    opacity: 0.88;

    filter: blur(0);

    transform: translate3d(0, 0, 0);

    pointer-events: auto;
  }

  .archive-playlist.awaiting-selection {
    border-color: color-mix(
      in srgb,
      var(--vw-color-a) 34%,
      rgba(238, 233, 223, 0.1)
    );

    animation: archiveWaiting 1.2s ease-in-out infinite alternate;
  }

  @keyframes archiveWaiting {
    from {
      box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    }

    to {
      box-shadow: 0 0 35px
        color-mix(in srgb, var(--vw-color-a) 12%, transparent);
    }
  }

  .archive-playlist-header {
    display: flex;

    align-items: center;
    justify-content: space-between;

    padding: 0.15rem 0.22rem 0.65rem;

    border-bottom: 1px solid rgba(238, 233, 223, 0.065);
  }

  .archive-playlist-label {
    color: rgba(238, 233, 223, 0.47);

    font-family: "IBM Plex Mono", monospace;

    font-size: 0.5rem;

    letter-spacing: 0.15em;
  }

  .archive-playlist-list {
    max-height: calc(58dvh - 3rem);

    overflow-y: auto;

    overscroll-behavior: contain;

    scrollbar-width: thin;

    scrollbar-color: rgba(238, 233, 223, 0.18) transparent;
  }

  .archive-playlist-list::-webkit-scrollbar {
    width: 4px;
  }

  .archive-playlist-list::-webkit-scrollbar-thumb {
    background: rgba(238, 233, 223, 0.14);

    border-radius: 10px;
  }

  /* ============================================================
       ARCHIVE TRACK
    ============================================================ */

  .archive-track {
    display: grid;

    grid-template-columns:
      38px
      minmax(0, 1fr);

    align-items: center;

    gap: 0.62rem;

    width: 100%;

    padding: 0.45rem 0.38rem;

    border: 0;

    border-bottom: 1px solid rgba(238, 233, 223, 0.052);

    background: transparent;

    color: inherit;

    text-align: left;

    cursor: pointer;

    opacity: 0.74;

    transition:
      background 0.2s ease,
      opacity 0.2s ease,
      transform 0.22s ease;
  }

  .archive-track:last-child {
    border-bottom: 0;
  }

  .archive-track:hover {
    opacity: 1;

    background: rgba(238, 233, 223, 0.05);

    transform: translateX(-2px);
  }

  .archive-track.is-active {
    opacity: 1;

    background: color-mix(
      in srgb,
      var(--vw-color-a) 11%,
      rgba(238, 233, 223, 0.025)
    );
  }

  .archive-track-cover {
    display: block;

    width: 38px;
    height: 38px;

    object-fit: cover;

    opacity: 0.72;

    transition:
      opacity 0.2s ease,
      transform 0.25s ease;
  }

  .archive-track:hover .archive-track-cover,
  .archive-track.is-active .archive-track-cover {
    opacity: 1;
  }

  .archive-track.is-active .archive-track-cover {
    transform: scale(1.035);
  }

  .archive-track-copy {
    display: flex;

    min-width: 0;

    flex-direction: column;

    gap: 0.16rem;
  }

  .archive-track-title {
    overflow: hidden;

    color: rgba(238, 233, 223, 0.84);

    font-family: "Gideon Roman", serif;

    font-size: 0.81rem;

    white-space: nowrap;

    text-overflow: ellipsis;
  }

  .archive-track-meta {
    overflow: hidden;

    color: rgba(238, 233, 223, 0.32);

    font-family: "Inter", sans-serif;

    font-size: 0.46rem;

    white-space: nowrap;

    text-overflow: ellipsis;
  }

  /* ============================================================
       MODAL
    ============================================================ */

  .album-modal {
    position: absolute;

    z-index: 40;

    inset: 0;

    display: grid;

    place-items: center;

    padding: 2rem;

    opacity: 0;

    transition: opacity 0.26s ease;
  }

  .album-modal.is-visible {
    opacity: 1;
  }

  .album-modal-backdrop {
    position: absolute;

    inset: 0;

    background: rgba(4, 5, 6, 0.82);

    backdrop-filter: blur(11px);

    -webkit-backdrop-filter: blur(11px);
  }

  .album-card {
    position: relative;

    z-index: 2;

    display: grid;

    grid-template-columns:
      minmax(300px, 420px)
      minmax(0, 1fr);

    width: min(1160px, 100%);

    min-height: 580px;

    max-height: 88dvh;

    overflow: hidden;

    border: 1px solid rgba(238, 233, 223, 0.12);

    background: #111214;

    box-shadow: 0 45px 130px rgba(0, 0, 0, 0.7);

    transform: translateY(22px) scale(0.978);

    opacity: 0;

    transition:
      opacity 0.32s ease,
      transform 0.42s cubic-bezier(0.18, 0.78, 0.2, 1);
  }

  .album-modal.is-visible .album-card {
    opacity: 1;

    transform: translateY(0) scale(1);
  }

  .album-close {
    position: absolute;

    z-index: 10;

    top: 1.1rem;
    right: 1.1rem;

    width: 42px;
    height: 42px;

    padding: 0;

    border: 1px solid rgba(238, 233, 223, 0.15);

    background: rgba(17, 18, 20, 0.5);

    color: rgba(238, 233, 223, 0.75);

    font-size: 1.4rem;

    cursor: pointer;
  }

  .album-cover-area {
    position: relative;

    overflow: hidden;

    background: #090a0b;
  }

  .album-cover-image {
    display: block;

    width: 100%;
    height: 100%;

    min-height: 580px;

    object-fit: cover;
  }

  .album-cover-lines {
    position: absolute;

    inset: 0;

    pointer-events: none;

    opacity: 0.16;

    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      rgba(255, 255, 255, 0.035) 4px
    );
