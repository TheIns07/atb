        function playAlbum(
            index:
                number,
        ) {

            const work =
                works[index];

            if (!work) {
                return;
            }

            selectedAlbumIndex =
                index;

            playerTitle.textContent =
                work.title;

            playerArtist.textContent =
                `${work.artist} · ${work.year}`;

            playerLink.href =
                work.youtubeUrl;

            /*
             * User clicked ESCUCHAR, therefore this usually
             * satisfies browser autoplay requirements.
             */

            playerFrame.src =
                `https://www.youtube.com/embed/${work.youtubeId}?autoplay=1&controls=1&rel=0&playsinline=1`;

            playerDock.classList.remove(
                "hidden",
            );

            playerDock.setAttribute(
                "aria-hidden",
                "false",
            );

        }

