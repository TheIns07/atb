    /* ============================================================
       ALBUM TEXTURES
    ============================================================ */

    const textureLoader = new THREE.TextureLoader();

    const albumTextures: (THREE.Texture | null)[] = new Array(
      albums.length,
    ).fill(null);

    function configureAlbumTexture(texture: THREE.Texture): void {
      texture.colorSpace = THREE.SRGBColorSpace;

      texture.anisotropy = Math.min(
        renderer.capabilities.getMaxAnisotropy(),

        isMobile ? 2 : 8,
      );

      texture.minFilter = THREE.LinearMipmapLinearFilter;

      texture.magFilter = THREE.LinearFilter;
    }

    function loadAlbumTexture(index: number): Promise<THREE.Texture | null> {
      const album = albums[index];

      if (album === undefined) {
        return Promise.resolve(null);
      }

      return new Promise<THREE.Texture | null>((resolve) => {
        textureLoader.load(
          album.image,

          (texture: THREE.Texture) => {
            configureAlbumTexture(texture);

            albumTextures[index] = texture;

            resolve(texture);
          },

          undefined,

          (error: unknown) => {
            console.warn(`[Vaporwave] No se pudo cargar ${album.image}`, error);

            resolve(null);
          },
        );
      });
    }

    async function loadAllAlbumTextures(): Promise<void> {
      let completed = 0;

      const total = albums.length;

      const jobs = albums.map((_album, index) =>
        loadAlbumTexture(index).then((result) => {
          completed += 1;

          const progress = 8 + (completed / total) * 72;

          loadingProgressValue = progress;

          loaderProgress.textContent = String(Math.round(progress)).padStart(
            3,
            "0",
          );

          return result;
        }),
      );

      await Promise.all(jobs);
    }

    /* ============================================================
       ALBUM CARD TYPES / STATE
    ============================================================ */

    type AlbumCardRecord = {
      group: THREE.Group;

      hitbox: THREE.Mesh;

      albumIndex: number;

      baseX: number;

      baseY: number;

      baseZ: number;

      baseRotation: number;

      phase: number;
    };

    const albumCards: AlbumCardRecord[] = [];

    const albumHitboxes: THREE.Mesh[] = [];

    /* ============================================================
       CREATE ALBUM CARD

       Cada portada sigue siendo un plano muy ligero.
    ============================================================ */

    function createAlbumCard(
      albumIndex: number,

      x: number,

      y: number,

      z: number,
    ): void {
      const album = albums[albumIndex];

      if (album === undefined) {
        return;
      }

      const texture = albumTextures[albumIndex] ?? null;

      const group = new THREE.Group();

      const px = worldX(x);

      const py = isMobile ? y + 0.35 : y;

      const baseRotation = px < 0 ? 0.07 : -0.07;

      group.position.set(px, py, z);

      group.rotation.y = baseRotation;

      if (isMobile) {
        group.scale.setScalar(0.78);
      }

      /*
       * DARK BACKING
       */

      const backing = new THREE.Mesh(
        new THREE.BoxGeometry(6.45, 6.45, 0.14),

        new THREE.MeshStandardMaterial({
          color: 0x101113,

          roughness: 0.58,

          metalness: 0,
        }),
      );

      backing.position.z = -0.02;

      group.add(backing);

      /*
       * COVER
       */

      const coverMaterial = new THREE.MeshBasicMaterial({
        color: 0xffffff,

        map: texture,

        toneMapped: false,
      });

      const cover = new THREE.Mesh(
        new THREE.PlaneGeometry(6.12, 6.12),

        coverMaterial,
      );

      cover.position.z = 0.08;

      group.add(cover);

      /*
       * INVISIBLE HITBOX
       */

      const hitbox = new THREE.Mesh(
        new THREE.PlaneGeometry(8.5, 8.5),

        new THREE.MeshBasicMaterial({
          transparent: true,

          opacity: 0,

          depthWrite: false,

          depthTest: false,
        }),
      );

      hitbox.position.z = 0.55;

      hitbox.userData.albumIndex = albumIndex;

      hitbox.userData.isAlbumCard = true;

      group.add(hitbox);

      cardGroup.add(group);

      albumHitboxes.push(hitbox);

      albumCards.push({
        group,
        hitbox,
        albumIndex,
        baseX: px,
        baseY: py,
        baseZ: z,
        baseRotation,
        phase: albumIndex * 0.73,
      });
    }

    /* ============================================================
       CREATE ALL ALBUM CARDS
    ============================================================ */

    function createAlbumArchive(): void {
      albumCards.length = 0;

      albumHitboxes.length = 0;

      cardGroup.clear();

      /*
       * Si añadimos/quitas álbumes,
       * la distribución sigue funcionando.
       */

      albums.forEach((_album, index) => {
        const direction = index % 2 === 0 ? -1 : 1;

        const x = direction * 5.8;

        const y = index % 3 === 0 ? 2.8 : index % 3 === 1 ? 3 : 2.88;

        const z = firstAlbumZ - albumSpacing * index;

        createAlbumCard(index, x, y, z);
      });
    }

    /* ============================================================
       CARD MOTION

       No usamos un GSAP timeline por tarjeta.
       Todo se mueve desde el único render loop.
       Esto reduce overhead.
    ============================================================ */

    function updateAlbumCards(elapsed: number): void {
      albumCards.forEach((record: AlbumCardRecord) => {
        const { group, albumIndex, baseX, baseY, baseZ, baseRotation, phase } =
          record;

        const direction = albumIndex % 2 === 0 ? 1 : -1;

        const lateralScale = isMobile ? 0.42 : 0.72;

        group.position.x =
          baseX + Math.sin(elapsed * 0.82 + phase) * lateralScale * direction;

        group.position.y =
          baseY + Math.sin(elapsed * 1.05 + phase * 1.23) * 0.34;

        group.position.z = baseZ + Math.sin(elapsed * 0.55 + phase) * 0.18;

        group.rotation.x = Math.sin(elapsed * 0.72 + phase) * 0.035;

        group.rotation.y =
          baseRotation + Math.sin(elapsed * 0.64 + phase) * 0.065 * direction;

        group.rotation.z = Math.cos(elapsed * 0.76 + phase) * 0.026 * direction;
      });
    }

    /* ============================================================
       RAYCAST / POINTER
    ============================================================ */

    const raycaster = new THREE.Raycaster();

    const pointer = new THREE.Vector2();

    let pointerDownX = 0;

    let pointerDownY = 0;

    function setPointerFromEvent(event: PointerEvent): void {
      const rect = canvas.getBoundingClientRect();

      pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;

      pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
    }

    function findAlbumUnderPointer(): number | null {
      raycaster.setFromCamera(pointer, camera);

      const intersections = raycaster.intersectObjects(albumHitboxes, false);

      const first = intersections[0];

      if (first === undefined) {
        return null;
      }

      const albumIndex: unknown = first.object.userData.albumIndex;

      if (typeof albumIndex !== "number") {
        return null;
      }

      return albumIndex;
    }

    function resetCardHover(): void {
      albumCards.forEach((record: AlbumCardRecord) => {
        const targetScale = isMobile ? 0.78 : 1;

        record.group.scale.lerp(
          new THREE.Vector3(targetScale, targetScale, targetScale),

          0.18,
        );
      });
    }

    canvas.addEventListener("pointermove", (event: PointerEvent) => {
      if (
        !experienceActive ||
        feedbackLoopMode ||
        modal.classList.contains("is-visible")
      ) {
        canvas.style.cursor = "default";

        return;
      }

      setPointerFromEvent(event);

      const index = findAlbumUnderPointer();

      canvas.style.cursor = index !== null ? "pointer" : "default";

      hoverCard = index;
    });

    canvas.addEventListener("pointerdown", (event: PointerEvent) => {
      pointerDownX = event.clientX;

      pointerDownY = event.clientY;
    });

    canvas.addEventListener("pointerup", (event: PointerEvent) => {
      if (!experienceActive || feedbackLoopMode) {
        return;
      }

      const distance = Math.hypot(
        event.clientX - pointerDownX,

        event.clientY - pointerDownY,
      );

      /*
       * Evita abrir tarjeta si el usuario
       * estaba arrastrando/tocando.
       */
      if (distance > 12) {
        return;
      }

      setPointerFromEvent(event);

      const index = findAlbumUnderPointer();

      if (index === null) {
        return;
      }

      openAlbumModal(index);
    });

    /* ============================================================
       CARD HOVER SCALE

       Se llama en render loop.
    ============================================================ */

    function updateCardHover(): void {
      albumCards.forEach((record: AlbumCardRecord) => {
        const isHovered = hoverCard === record.albumIndex;

        let targetScale = isMobile ? 0.78 : 1;

        if (isHovered && !isMobile) {
          targetScale = 1.085;
        }

        const scaleVector = new THREE.Vector3(
          targetScale,
          targetScale,
          targetScale,
        );

        record.group.scale.lerp(scaleVector, 0.13);
      });
    }

    /* ============================================================
       MODAL
    ============================================================ */

    let modalOpen = false;

    let selectedAlbumIndex = 0;

    function openAlbumModal(index: number): void {
      const album = albums[index];

      if (album === undefined) {
        return;
      }

      selectedAlbumIndex = index;

      activeAlbum = album;

      modalImage.setAttribute("src", album.image);

      modalImage.setAttribute("alt", `${album.title} — ${album.artist}`);

      modalYear.textContent = String(album.year);

      modalTitle.textContent = album.title;

      modalArtist.textContent = album.artist;

      modalSummary.textContent = album.summary;

      modalPress.textContent = album.press;

      modalSource.textContent = album.source;

      modal.classList.remove("hidden");

      modal.setAttribute("aria-hidden", "false");

      modalOpen = true;

      requestAnimationFrame(() => {
        modal.classList.add("is-visible");
      });
    }

    function closeAlbumModal(): void {
      if (!modalOpen) {
        return;
      }

      modal.classList.remove("is-visible");

      window.setTimeout(() => {
        modal.classList.add("hidden");

        modal.setAttribute("aria-hidden", "true");

        modalOpen = false;
      }, 260);
    }

    modalClose.addEventListener("click", (event: MouseEvent) => {
      event.stopPropagation();

      closeAlbumModal();
    });

    modalBackdrop.addEventListener("click", () => {
      closeAlbumModal();
    });

    /* ============================================================
       PLAY BUTTON FROM MODAL

       playAlbum() se define en la PARTE 4.
    ============================================================ */

    modalPlay.addEventListener("click", (event: MouseEvent) => {
      event.preventDefault();

      event.stopPropagation();

      closeAlbumModal();

      void playAlbum(selectedAlbumIndex, true);
    });

    /* ============================================================
       ESCAPE
    ============================================================ */

    function handleEscape(event: KeyboardEvent): void {
      if (event.key !== "Escape") {
        return;
      }

      if (modalOpen) {
        closeAlbumModal();

        return;
      }

      /*
       * leaveExperience() se define
       * en una parte posterior.
       */
      if (experienceActive) {
        void leaveExperience();
      }
    }

    window.addEventListener("keydown", handleEscape);

    /* ============================================================
       CREATE PLAYLIST DOM

       Todavía queda escondida.
       Se muestra únicamente en ∞.
    ============================================================ */

    function buildArchivePlaylist(): void {
      playlistList.innerHTML = "";

      albums.forEach(
        (
          album: AlbumDescriptor,

          index: number,
        ) => {
          const button = document.createElement("button");

          button.type = "button";

          button.className = "archive-track";

          button.dataset.albumIndex = String(index);

          button.setAttribute("aria-label", `Reproducir ${album.title}`);

          const image = document.createElement("img");

          image.className = "archive-track-cover";

          image.src = album.image;

          image.alt = "";

          image.loading = "lazy";

          image.decoding = "async";

          const copy = document.createElement("span");

          copy.className = "archive-track-copy";

          const title = document.createElement("span");

          title.className = "archive-track-title";

          title.textContent = album.title;

          const meta = document.createElement("span");

          meta.className = "archive-track-meta";

          meta.textContent = `${album.artist} · ${album.year}`;

          copy.append(title, meta);

          button.append(image, copy);

          button.addEventListener("click", () => {
            /*
             * playAlbum se añade
             * en PARTE 4.
             *
             * false = no cerrar feedback loop.
             */
            void playAlbum(index, false);
          });

          playlistList.appendChild(button);
        },
      );
    }

    buildArchivePlaylist();

    /* ============================================================
       ACTIVE PLAYLIST TRACK

       Se invoca cuando cambia el álbum.
    ============================================================ */

    function updatePlaylistActiveTrack(albumIndex: number): void {
      const tracks =
        playlistList.querySelectorAll<HTMLButtonElement>(".archive-track");

      tracks.forEach((track: HTMLButtonElement) => {
        const index = Number(track.dataset.albumIndex ?? "-1");

        track.classList.toggle("is-active", index === albumIndex);
      });
    }

    /* ============================================================
       SHOW / HIDE END PLAYLIST
    ============================================================ */

    function showArchivePlaylist(): void {
      if (endLoopPlaylistVisible) {
        return;
      }

      endLoopPlaylistVisible = true;

      playlistDock.classList.remove("hidden");

      playlistDock.setAttribute("aria-hidden", "false");

