/* ============================================================
   HELPERS
============================================================ */

function must<T extends Element>(
  selector: string,
): T {
  const element =
    document.querySelector<T>(
      selector,
    );

  if (
    element ===
    null
  ) {
    throw new Error(
      `[Vaporwave] Missing ${selector}`,
    );
  }

  return element;
}

function require2DContext(
  canvas:
    HTMLCanvasElement,
): CanvasRenderingContext2D {
  const context =
    canvas.getContext(
      "2d",
    );

  if (
    context ===
    null
  ) {
    throw new Error(
      "[Vaporwave] Could not create 2D canvas context",
    );
  }

  return context;
}

function sleep(
  milliseconds:
    number,
): Promise<void> {
  return new Promise<void>(
    (
      resolve,
    ) => {
      window.setTimeout(
        resolve,
        milliseconds,
      );
    },
  );
}

function nextFrame():
  Promise<void> {
  return new Promise<void>(
    (
      resolve,
    ) => {
      requestAnimationFrame(
        () => {
          resolve();
        },
      );
    },
  );
}

/* ============================================================
   INIT
============================================================ */

async function initVaporwaveHero():
  Promise<void> {

  const section =
    must<HTMLElement>(
      "#vaporwave-hero",
    );

  if (
    section.dataset
      .vaporwaveInitialized ===
    "true"
  ) {
    return;
  }

  section.dataset
    .vaporwaveInitialized =
    "true";

  const isMobile =
    window.matchMedia(
      "(max-width: 800px)",
    ).matches;

  function worldX(
    x: number,
  ): number {
    return isMobile
      ? x * 0.54
      : x;
  }

  function worldHeight(
    height: number,
  ): number {
    return isMobile
      ? height * 0.84
      : height;
  }

  /* ========================================================
     DOM
  ======================================================== */

  const canvas =
    must<HTMLCanvasElement>(
      "#vaporwave-webgl",
    );

  const content =
    must<HTMLElement>(
      "#vaporwave-content",
    );

  const skyLightLayer =
    must<HTMLElement>(
      "#sky-light-layer",
    );

  const enterButton =
    must<HTMLButtonElement>(
      "#vaporwave-enter",
    );

  const loaderScreen =
    must<HTMLElement>(
      "#experience-loader",
    );

  const experienceWord =
    must<HTMLElement>(
      "#experience-word",
    );

  const loadProgress =
    must<HTMLElement>(
      "#experience-load-progress",
    );

  const experienceUI =
    must<HTMLElement>(
      "#experience-ui",
    );

  const exitButton =
    must<HTMLButtonElement>(
      "#experience-exit",
    );

  const yearLabel =
    must<HTMLElement>(
      "#experience-year",
    );

  const modal =
    must<HTMLElement>(
      "#album-modal",
    );

  const modalBackdrop =
    must<HTMLElement>(
      "#album-modal-backdrop",
    );

  const albumCard =
