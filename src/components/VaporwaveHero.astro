      if (!experienceActive || feedbackLoopMode) {
        return;
      }

      const z = camera.position.z;

      /*
       * Bustos:
       * primer bust está cerca de -145.
       */
      if (z < -20) {
        void loadBustDistricts();
      }

      /*
       * Malls / theatres:
       * empiezan alrededor de -270.
       */
      if (z < -65) {
        void loadMalls();

        void loadTheatres();
      }

      /*
       * Dolphin:
       * aparece alrededor -345.
       * Es enorme, así que empezamos antes,
