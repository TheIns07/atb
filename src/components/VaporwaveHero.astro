    function colorToCSS(
        color:
            THREE.Color,
    ): string {
        return `rgb(${Math.round(
            color.r * 255,
        )}, ${Math.round(
            color.g * 255,
        )}, ${Math.round(
            color.b * 255,
        )})`;
    }

    function paintCheckerboard(
        colorA:
            THREE.Color,

        colorB:
            THREE.Color,
    ): void {
        const size =
            128;

        floorContext.clearRect(
            0,
            0,
            256,
            256,
        );

        floorContext.fillStyle =
            colorToCSS(
                colorA,
            );

        floorContext.fillRect(
            0,
            0,
            size,
            size,
        );

        floorContext.fillRect(
            size,
            size,
            size,
            size,
        );

        floorContext.fillStyle =
            colorToCSS(
                colorB,
            );

        floorContext.fillRect(
            size,
            0,
            size,
            size,
        );

        floorContext.fillRect(
            0,
            size,
            size,
            size,
        );
    }

    paintCheckerboard(
