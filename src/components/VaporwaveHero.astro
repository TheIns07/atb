    /* ========================================================
       DISPOSE WORLD
    ======================================================== */

    function disposeExperienceWorld():
        void {

        worldAnimations.forEach(
            (
                animation:
                    gsap.core.Timeline,
            ) => {

                animation.kill();
            },
        );

        worldAnimations.length =
            0;

        albumHitboxes.length =
            0;

        archiveDolphin =
            null;

        if (
            worldGroup ===
            null
        ) {
            return;
        }

        const textures =
            new Set<
                THREE.Texture
            >();

        const materials =
            new Set<
                THREE.Material
            >();

        const geometries =
            new Set<
                THREE.BufferGeometry
            >();

        worldGroup.traverse(
            (
                object:
                    THREE.Object3D,
            ) => {

                if (
                    !(
                        object instanceof
                        THREE.Mesh
                    )
                ) {
                    return;
                }

                const geometry =
                    object.geometry;

                if (
                    !geometries.has(
                        geometry,
                    )
                ) {

                    geometry.dispose();

                    geometries.add(
                        geometry,
                    );
                }

                const objectMaterials:
                    THREE.Material[] =
                    Array.isArray(
                        object.material,
                    )
                        ? object.material
                        : [
                              object.material,
                          ];

                objectMaterials.forEach(
                    (
                        material:
                            THREE.Material,
                    ) => {

                        if (
                            materials.has(
                                material,
                            )
                        ) {
                            return;
                        }

                        Object.values(
                            material,
                        ).forEach(
                            (
                                value:
                                    unknown,
                            ) => {

                                if (
                                    value instanceof
                                        THREE.Texture &&
                                    !textures.has(
                                        value,
                                    )
                                ) {

                                    value.dispose();

                                    textures.add(
                                        value,
                                    );
                                }
                            },
                        );

                        material.dispose();

                        materials.add(
                            material,
                        );
                    },
                );
            },
        );

        scene.remove(
            worldGroup,
        );

        worldGroup.clear();

        worldGroup =
            null;

        renderer.renderLists.dispose();

        THREE.Cache.clear();
    }

