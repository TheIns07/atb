    function createExhibit(
        index:
            number,

        texture:
            THREE.Texture |
            null,

        x:
            number,

        y:
            number,

        z:
            number,
    ): void {

        if (
            worldGroup ===
            null
        ) {
            return;
        }

        const work =
            works[
                index
            ];

        if (
            work ===
            undefined
        ) {
            return;
        }

        const xPosition =
            worldX(
                x,
            );

        const yPosition =
            isMobile
                ? y + 0.35
                : y;

        const group =
            new THREE.Group();

        const direction =
            index %
                2 ===
            0
                ? 1
                : -1;

        const baseRotation =
            xPosition <
            0
                ? 0.07
                : -0.07;

        group.position.set(
            xPosition,
            yPosition,
            z,
        );

        group.rotation.y =
            baseRotation;

        if (
            isMobile
        ) {

            group.scale.setScalar(
                0.78,
            );
        }

        const backing =
            new THREE.Mesh(
                new THREE.BoxGeometry(
                    6.45,
                    6.45,
                    0.14,
                ),

                new THREE.MeshStandardMaterial({
                    color:
                        0x101113,

                    roughness:
                        0.58,
                }),
            );

        group.add(
            backing,
        );

        const coverMaterial =
            new THREE.MeshBasicMaterial({
                color:
                    0xffffff,

                map:
                    texture,
            });

        const cover =
            new THREE.Mesh(
                new THREE.PlaneGeometry(
                    6.12,
                    6.12,
                ),

                coverMaterial,
            );

        cover.position.z =
            0.08;

        group.add(
            cover,
        );

        const hitbox =
            new THREE.Mesh(
                new THREE.PlaneGeometry(
                    8.5,
                    8.5,
                ),

                new THREE.MeshBasicMaterial({
                    transparent:
                        true,

                    opacity:
                        0,

                    depthWrite:
                        false,
                }),
            );

        hitbox.position.z =
            0.55;

        hitbox.userData.workIndex =
            index;

        group.add(
            hitbox,
        );

        albumHitboxes.push(
            hitbox,
        );

        worldGroup.add(
            group,
        );

        const movementScale =
            isMobile
                ? 0.55
                : 1;

        const movement =
            gsap.timeline({
                repeat:
                    -1,

                delay:
                    index *
                    0.085,
            });

        movement
            .to(
                group.position,
                {
                    x:
                        xPosition +
                        0.82 *
                            direction *
                            movementScale,

                    y:
                        yPosition +
                        0.56,

                    z:
                        z +
                        0.26,

                    duration:
                        0.92,

                    ease:
                        "sine.inOut",
                },
            )

            .to(
                group.position,
                {
                    x:
                        xPosition -
                        0.4 *
                            direction *
                            movementScale,

                    y:
                        yPosition -
                        0.24,

                    z:
                        z -
                        0.2,

                    duration:
                        0.64,

                    ease:
                        "sine.inOut",
                },
            )

            .to(
                group.position,
                {
                    x:
                        xPosition,

                    y:
                        yPosition,

                    z,

                    duration:
                        0.96,

                    ease:
                        "sine.inOut",
                },
            );

        const rotation =
            gsap.timeline({
                repeat:
                    -1,

                delay:
                    index *
                    0.06,
            });

        rotation
            .to(
                group.rotation,
                {
                    x:
                        0.06,

                    y:
                        baseRotation +
                        0.09 *
                            direction,

                    z:
                        0.045 *
                        direction,

                    duration:
                        0.9,

                    ease:
                        "sine.inOut",
                },
            )

            .to(
                group.rotation,
                {
                    x:
                        -0.035,

                    y:
                        baseRotation -
                        0.054 *
                            direction,

                    z:
                        -0.03 *
                        direction,

                    duration:
                        0.66,

                    ease:
                        "sine.inOut",
                },
            )

            .to(
                group.rotation,
                {
                    x:
                        0,

                    y:
                        baseRotation,

                    z:
                        0,

                    duration:
                        0.96,

                    ease:
                        "sine.inOut",
                },
            );

        worldAnimations.push(
            movement,
            rotation,
        );
    }

