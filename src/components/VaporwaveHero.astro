  function loadTexture(
    url:
      string,
  ): Promise<
    THREE.Texture |
    null
  > {
    return new Promise<
      THREE.Texture |
      null
    >(
      (
        resolve,
      ) => {
        textureLoader.load(
          url,

          (
            texture:
              THREE.Texture,
          ) => {
            texture.colorSpace =
              THREE.SRGBColorSpace;

            texture.anisotropy =
              Math.min(
                renderer
                  .capabilities
                  .getMaxAnisotropy(),

                isMobile
                  ? 2
                  : 8,
              );

            texture.minFilter =
              THREE.LinearMipmapLinearFilter;

            texture.magFilter =
              THREE.LinearFilter;

            resolve(
              texture,
            );
          },

          undefined,

          (
            error:
              unknown,
          ) => {
            console.warn(
              `[Vaporwave] Could not load texture ${url}`,
              error,
            );

            resolve(
              null,
            );
          },
        );
      },
    );
  }

  async function loadAlbumTextures():
    Promise<
      (
        THREE.Texture |
        null
      )[]
    > {
    let completed =
      0;

    const total =
      works.length;

    const promises =
      works.map(
        async (
          work:
            Work,
        ) => {
          const texture =
            await loadTexture(
              work.image,
            );

          completed +=
            1;

          const percentage =
            8 +
            (
              completed /
              total
            ) *
              77;

          updateLoading(
            percentage,
          );

          return texture;
        },
      );

    return Promise.all(
      promises,
    );
  }

