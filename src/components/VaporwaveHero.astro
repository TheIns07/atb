  function getBasePath(
    url:
      string,
  ): string {
    const slash =
      url.lastIndexOf(
        "/",
      );

    if (
      slash < 0
    ) {
      return "";
    }

    return url.slice(
      0,
      slash + 1,
    );
  }

  async function fetchAndParseModel(
    url:
      string,

    session:
      number,
  ): Promise<
    THREE.Group |
    null
  > {
    const controller =
      new AbortController();

    activeModelControllers.add(
      controller,
    );

    try {
      const response =
        await fetch(
          url,
          {
            signal:
              controller.signal,

            cache:
              "force-cache",
          },
        );

      if (
        !response.ok
      ) {
        throw new Error(
          `${response.status} ${response.statusText}`,
        );
      }

      const buffer =
        await response.arrayBuffer();

      /*
       * Si el usuario ya salió,
       * ni siquiera parseamos el GLB.
       *
       * Esto evita mucho trabajo de CPU.
       */
      if (
        session !==
        worldSession
      ) {
        return null;
      }

      await nextFrame();

      const gltf =
        await gltfLoader.parseAsync(
          buffer,
          getBasePath(
            url,
          ),
        );

      if (
        session !==
        worldSession
      ) {
        disposeObjectResources(
          gltf.scene,
        );

        return null;
      }

      resolvedModelSources.add(
        gltf.scene,
      );

      return gltf.scene;
    } catch (
      error:
        unknown
    ) {
      if (
        error instanceof
          DOMException &&
        error.name ===
          "AbortError"
      ) {
        return null;
      }

      console.warn(
        `[Vaporwave] Could not load ${url}`,
        error,
      );

      return null;
    } finally {
      activeModelControllers.delete(
        controller,
      );
    }
  }

  function pumpModelQueue():
    void {
    if (
      modelQueue.length ===
      0
    ) {
      return;
    }

    modelQueue.sort(
      (
        a,
        b,
      ) =>
        b.priority -
        a.priority,
    );

    while (
      activeModelLoads <
        modelConcurrency &&
      modelQueue.length >
        0
    ) {
      const job =
        modelQueue.shift();

      if (
        job ===
        undefined
      ) {
        break;
      }

      if (
        job.session !==
        worldSession
      ) {
        job.resolve(
          null,
        );

        continue;
      }

      activeModelLoads +=
        1;

      void fetchAndParseModel(
        job.url,
        job.session,
      )
        .then(
          (
            result,
          ) => {
            job.resolve(
              result,
            );
          },
        )
        .finally(
          () => {
            activeModelLoads =
              Math.max(
                0,
                activeModelLoads -
                  1,
              );

            pumpModelQueue();
          },
        );
    }
  }

  function loadModel(
    url:
      string,

    priority:
      number,

    session:
      number,
  ): Promise<
    THREE.Group |
    null
  > {
    const key =
      `${session}:${url}`;

    const cached =
      modelPromiseCache.get(
        key,
      );

    if (
      cached !==
      undefined
    ) {
      return cached;
    }

    const promise =
      new Promise<
        THREE.Group |
        null
      >(
        (
          resolve,
        ) => {
          modelQueue.push({
            url,
            priority,
            session,
            resolve,
          });

          pumpModelQueue();
        },
      );

    modelPromiseCache.set(
      key,
      promise,
    );

    return promise;
  }

  function cancelPendingModelLoads():
    void {
    modelQueue.splice(
      0,
      modelQueue.length,
    );

    activeModelControllers.forEach(
      (
        controller,
      ) => {
        controller.abort();
      },
    );

    activeModelControllers.clear();

    modelPromiseCache.clear();
  }

