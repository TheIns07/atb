
---
// ======================================================
// CONFIGURACIÓN
// ======================================================

const experienceUrl = "/vaporwave/experiencia";

const documentaryUrl =
  "https://www.youtube.com/watch?v=yDJKkZq_OTM";
---

<section id="vaporwave-hero" class="vaporwave-root">

  <!-- =====================================================
       TEXTURA VISUAL
  ====================================================== -->

  <div class="screen-vignette" aria-hidden="true"></div>
  <div class="screen-lines" aria-hidden="true"></div>
  <div class="screen-noise" aria-hidden="true"></div>

  <!-- =====================================================
       LANDING
  ====================================================== -->

  <div class="vaporwave-landing">
    <div class="landing-inner">

      <h1 class="landing-title">
        VAPORWAVE
      </h1>

      <p class="landing-subtitle">
        LA HISTORIA NO CONTADA
      </p>

      <!-- BOTONES -->

      <div class="landing-actions">

        <a
          href={experienceUrl}
          data-astro-prefetch="false"
          class="landing-button landing-button--primary"
        >
          <span>Entrar a la experiencia</span>
          <span class="button-arrow" aria-hidden="true">↗</span>
        </a>

        <a
          href={documentaryUrl}
          class="landing-button landing-button--secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>Ver documental</span>
          <span class="button-arrow" aria-hidden="true">↗</span>
        </a>

      </div>

    </div>
  </div>

</section>

<style>
  @import url(
    "https://fonts.googleapis.com/css2?family=Gideon+Roman&family=IBM+Plex+Mono:wght@400;500&display=swap"
  );

  * {
    box-sizing: border-box;
  }

  /* ============================================================
     ROOT
  ============================================================ */

  .vaporwave-root {
    position: relative;

    width: 100%;
    height: 100dvh;
    min-height: 100dvh;

    overflow: clip;
    isolation: isolate;

    background: #000;
    color: #eee9df;
  }

  /* ============================================================
     SCREEN EFFECTS
  ============================================================ */

  .screen-vignette,
  .screen-lines,
  .screen-noise {
    position: absolute;
    z-index: 4;
    inset: 0;
    pointer-events: none;
  }

  .screen-vignette {
    background:
      radial-gradient(
        circle at center,
        transparent 42%,
        rgba(4, 5, 6, 0.42) 100%
      );
  }

  .screen-lines {
    opacity: 0.09;
    mix-blend-mode: multiply;

    background:
      repeating-linear-gradient(
        0deg,
        transparent 0,
        transparent 3px,
        rgba(0, 0, 0, 0.12) 3px,
        rgba(0, 0, 0, 0.12) 4px
      );
  }

  .screen-noise {
    opacity: 0.026;
    mix-blend-mode: screen;

    background-image:
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.08) 0,
        rgba(255, 255, 255, 0.08) 1px,
        transparent 1px,
        transparent 4px
      );

    animation:
      noiseShift 350ms steps(2) infinite;
  }

  @keyframes noiseShift {
    0% {
      transform: translate(0, 0);
    }

    25% {
      transform: translate(-1px, 1px);
    }

    50% {
      transform: translate(1px, -1px);
    }

    75% {
      transform: translate(1px, 1px);
    }

    100% {
      transform: translate(0, 0);
    }
  }

  /* ============================================================
     LANDING
  ============================================================ */

  .vaporwave-landing {
    position: absolute;

    z-index: 20;
    inset: 0;

    display: grid;
    place-items: center;

    pointer-events: none;
  }

  .landing-inner {
    width: min(
      1120px,
      calc(100% - 3rem)
    );

    text-align: center;
    pointer-events: auto;
  }

  /* ============================================================
     TITLE
  ============================================================ */

  .landing-title {
    margin: 0;

    color: #f0ece3;

    font-family:
      "Gideon Roman",
      serif;

    font-size:
      clamp(
        5rem,
        12vw,
        11rem
      );

    font-weight: 400;
    line-height: 0.82;
    letter-spacing: -0.035em;

    text-shadow:
      0 2px 30px rgba(0, 0, 0, 0.14);

    transition:
      color 700ms ease,
      text-shadow 700ms ease;
  }

  /* ============================================================
     SUBTITLE
  ============================================================ */

  .landing-subtitle {
    margin: 1.6rem 0 0;

    color:
      rgba(240, 236, 227, 0.88);

    font-family:
      "Gideon Roman",
      serif;

    font-size:
      clamp(
        1.55rem,
        3vw,
        2.7rem
      );

    font-weight: 400;
    letter-spacing: 0.055em;

    text-shadow:
      0 2px 20px rgba(0, 0, 0, 0.35);
  }

  /* ============================================================
     ACTIONS
  ============================================================ */

  .landing-actions {
    display: flex;

    justify-content: center;
    align-items: center;

    flex-direction: row;
    flex-wrap: wrap;

    gap: 0.85rem;

    margin-top: 3.5rem;
  }

  /* ============================================================
     BUTTON BASE
  ============================================================ */

  .landing-button {
    position: relative;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 1.1rem;

    min-height: 52px;

    padding:
      0.95rem
      1.65rem;

    border:
      1px solid transparent;

    border-radius: 0;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size: 0.72rem;
    font-weight: 500;

    line-height: 1.4;
    letter-spacing: 0.085em;

    text-decoration: none;
    white-space: nowrap;

    cursor: pointer;

    transition:
      background-color 250ms ease,
      border-color 250ms ease,
      color 250ms ease,
      transform 250ms ease,
      box-shadow 250ms ease;
  }

  /* ============================================================
     PRIMARY BUTTON
  ============================================================ */

  .landing-button--primary {
    background: #eee9df;

    color: #111111;

    border-color: #eee9df;
  }

  .landing-button--primary:hover {
    background: #ffffff;

    border-color: #ffffff;
    color: #000000;

    transform: translateY(-2px);

    box-shadow:
      0 6px 28px
      rgba(238, 233, 223, 0.12);
  }

  /* ============================================================
     SECONDARY BUTTON
  ============================================================ */

  .landing-button--secondary {
    background: transparent;

    color:
      rgba(238, 233, 223, 0.82);

    border-color:
      rgba(238, 233, 223, 0.38);
  }

  .landing-button--secondary:hover {
    background:
      rgba(238, 233, 223, 0.07);

    color: #ffffff;

    border-color:
      rgba(238, 233, 223, 0.85);

    transform: translateY(-2px);
  }

  /* ============================================================
     BUTTON ARROWS
  ============================================================ */

  .button-arrow {
    display: inline-block;

    font-size: 0.95rem;
    line-height: 1;

    transition:
      transform 250ms ease;
  }

  .landing-button:hover .button-arrow {
    transform:
      translate(2px, -2px);
  }

  /* ============================================================
     FOCUS
  ============================================================ */

  .landing-button:focus-visible {
    outline:
      2px solid #ffffff;

    outline-offset: 4px;
  }

  /* ============================================================
     MOBILE
  ============================================================ */

  @media (max-width: 800px) {

    .landing-inner {
      width:
        calc(100% - 1.5rem);

      padding:
        0 0.35rem;
    }

    .landing-title {
      font-size:
        clamp(
          3.15rem,
          13.3vw,
          5rem
        );

      line-height: 0.93;
      letter-spacing: -0.045em;

      white-space: nowrap;
    }

    .landing-subtitle {
      margin-top: 1.3rem;

      font-size:
        clamp(
          1.15rem,
          5.3vw,
          1.55rem
        );

      letter-spacing: 0.035em;
    }

    .landing-actions {
      margin-top: 2.8rem;

      flex-direction: column;
      flex-wrap: nowrap;

      gap: 0.8rem;
    }

    .landing-button {
      width: min(100%, 290px);

      min-height: 50px;

      padding:
        0.9rem
        1.25rem;

      font-size: 0.7rem;
    }

  }

  /* ============================================================
     VERY SMALL MOBILE
  ============================================================ */

  @media (max-width: 430px) {

    .landing-title {
      font-size:
        min(
          13.3vw,
          4rem
        );
    }

  }

  /* ============================================================
     REDUCED MOTION
  ============================================================ */

  @media (prefers-reduced-motion: reduce) {

    .landing-button,
    .landing-title,
    .button-arrow {
      transition-duration:
        0.01ms !important;
    }

    .landing-button:hover {
      transform: none;
    }

    .screen-noise {
      animation: none;
    }

  }

</style>