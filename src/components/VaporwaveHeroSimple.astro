
---
// ======================================================
// CONFIGURACIÓN
// ======================================================

const experienceUrl = "/vaporwave/experiencia";

const documentaryUrl =
  "https://www.youtube.com/watch?v=yDJKkZq_OTM";
---

<section id="vaporwave-hero" class="vaporwave-root">

  <!-- =====================================================
       TEXTURA VISUAL
  ====================================================== -->

  <div class="screen-vignette" aria-hidden="true"></div>
  <div class="screen-lines" aria-hidden="true"></div>
  <div class="screen-noise" aria-hidden="true"></div>

  <!-- =====================================================
       LANDING
  ====================================================== -->

  <div class="vaporwave-landing">
    <div class="landing-inner">

      <h1 class="landing-title">
        VAPORWAVE
      </h1>

      <p class="landing-subtitle">
        LA HISTORIA NO CONTADA
      </p>

      <!-- NAVEGACIÓN EDITORIAL -->

      <nav class="landing-actions" aria-label="Explorar Vaporwave">

        <a
          href={experienceUrl}
          data-astro-prefetch="false"
          class="landing-button landing-button--primary"
        > 
          <span class="action-label">Entrar a la experiencia</span>
        </a>

        <span class="action-divider" aria-hidden="true"></span>

        <a
          href={documentaryUrl}
          class="landing-button landing-button--secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="action-label">Ver documental</span>
        </a>

      </nav>

    </div>
  </div>

</section>

<style>
  @import url(
    "https://fonts.googleapis.com/css2?family=Gideon+Roman&family=IBM+Plex+Mono:wght@400;500&display=swap"
  );

  * {
    box-sizing: border-box;
  }

  /* ============================================================
     ROOT
  ============================================================ */

  .vaporwave-root {
    position: relative;

    width: 100%;
    height: 100dvh;
    min-height: 100dvh;

    overflow: clip;
    isolation: isolate;

    background: #000;
    color: #eee9df;
  }

  /* ============================================================
     SCREEN EFFECTS
  ============================================================ */

  .screen-vignette,
  .screen-lines,
  .screen-noise {
    position: absolute;
    z-index: 4;
    inset: 0;
    pointer-events: none;
  }

  .screen-vignette {
    background:
      radial-gradient(
        circle at center,
        transparent 42%,
        rgba(4, 5, 6, 0.42) 100%
      );
  }

  .screen-lines {
    opacity: 0.09;
    mix-blend-mode: multiply;

    background:
      repeating-linear-gradient(
        0deg,
        transparent 0,
        transparent 3px,
        rgba(0, 0, 0, 0.12) 3px,
        rgba(0, 0, 0, 0.12) 4px
      );
  }

  .screen-noise {
    opacity: 0.026;
    mix-blend-mode: screen;

    background-image:
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.08) 0,
        rgba(255, 255, 255, 0.08) 1px,
        transparent 1px,
        transparent 4px
      );

    animation:
      noiseShift 350ms steps(2) infinite;
  }

  @keyframes noiseShift {
    0% {
      transform: translate(0, 0);
    }

    25% {
      transform: translate(-1px, 1px);
    }

    50% {
      transform: translate(1px, -1px);
    }

    75% {
      transform: translate(1px, 1px);
    }

    100% {
      transform: translate(0, 0);
    }
  }

  /* ============================================================
     LANDING
  ============================================================ */

  .vaporwave-landing {
    position: absolute;
    z-index: 20;
    inset: 0;

    display: grid;
    place-items: center;

    pointer-events: none;
  }

  .landing-inner {
    width: min(
      1120px,
      calc(100% - 3rem)
    );

    text-align: center;
    pointer-events: auto;
  }

  /* ============================================================
     TITLE
  ============================================================ */

  .landing-title {
    margin: 0;

    color: #f0ece3;

    font-family:
      "Gideon Roman",
      serif;

    font-size:
      clamp(
        5rem,
        12vw,
        11rem
      );

    font-weight: 400;
    line-height: 0.82;
    letter-spacing: -0.035em;

    text-shadow:
      0 2px 30px rgba(0, 0, 0, 0.14);

    transition:
      color 700ms ease,
      text-shadow 700ms ease;
  }

  /* ============================================================
     SUBTITLE
  ============================================================ */

  .landing-subtitle {
    margin: 1.6rem 0 0;

    color:
      rgba(240, 236, 227, 0.88);

    font-family:
      "Gideon Roman",
      serif;

    font-size:
      clamp(
        1.55rem,
        3vw,
        2.7rem
      );

    font-weight: 400;
    letter-spacing: 0.055em;

    text-shadow:
      0 2px 20px rgba(0, 0, 0, 0.35);
  }

  /* ============================================================
     EDITORIAL NAVIGATION
  ============================================================ */

  .landing-actions {
    display: flex;

    justify-content: center;
    align-items: center;

    gap: 1.8rem;

    margin-top: 3.5rem;
  }

  /* ============================================================
     NAVIGATION LINKS
  ============================================================ */

  .landing-button {
    position: relative;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 0.8rem;

    min-height: 44px;
    padding: 0.65rem 0;

    border: none;
    background: transparent;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size: 0.72rem;
    font-weight: 400;

    line-height: 1.5;
    letter-spacing: 0.085em;

    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;

    cursor: pointer;

    transition:
      color 300ms ease;
  }

  /* ============================================================
     PRIMARY LINK
  ============================================================ */

  .landing-button--primary {
    color: rgba(240, 236, 227, 0.9);
  }

  /* ============================================================
     SECONDARY LINK
  ============================================================ */

  .landing-button--secondary {
    color: rgba(240, 236, 227, 0.55);
  }

  /* ============================================================
     INDEX NUMBERS
  ============================================================ */

  .action-index {
    font-size: 0.63rem;
    font-weight: 400;

    letter-spacing: 0.04em;

    opacity: 0.45;

    transition:
      opacity 300ms ease;
  }

  /* ============================================================
     LABELS
  ============================================================ */

  .action-label {
    display: inline-block;
    position: relative;
  }

  .action-label::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: -5px;

    width: 100%;
    height: 1px;

    background: currentColor;

    opacity: 0.8;

    transform: scaleX(0);
    transform-origin: left center;

    transition:
      transform 350ms ease;
  }

  /* ============================================================
     ARROWS
  ============================================================ */

  .action-arrow {
    display: inline-block;

    font-size: 0.9rem;
    line-height: 1;

    opacity: 0.65;

    transition:
      transform 300ms ease,
      opacity 300ms ease;
  }

  /* ============================================================
     DIVIDER
  ============================================================ */

  .action-divider {
    display: block;

    width: 1px;
    height: 18px;

    flex-shrink: 0;

    background:
      rgba(240, 236, 227, 0.22);
  }

  /* ============================================================
     HOVER
  ============================================================ */

  .landing-button:hover {
    color: #ffffff;
  }

  .landing-button:hover .action-index {
    opacity: 0.75;
  }

  .landing-button:hover .action-label::after {
    transform: scaleX(1);
  }

  .landing-button:hover .action-arrow {
    opacity: 1;

    transform: translateX(3px);
  }

  .landing-button--secondary:hover .action-arrow {
    transform: translate(2px, -2px);
  }

  /* ============================================================
     KEYBOARD FOCUS
  ============================================================ */

  .landing-button:focus-visible {
    color: #ffffff;

    outline: 1px solid rgba(240, 236, 227, 0.7);
    outline-offset: 6px;
  }

  .landing-button:focus-visible .action-label::after {
    transform: scaleX(1);
  }

  /* ============================================================
     MOBILE
  ============================================================ */

  @media (max-width: 800px) {

    .landing-inner {
      width:
        calc(100% - 1.5rem);

      padding:
        0 0.35rem;
    }

    .landing-title {
      font-size:
        clamp(
          3.15rem,
          13.3vw,
          5rem
        );

      line-height: 0.93;
      letter-spacing: -0.045em;

      white-space: nowrap;
    }

    .landing-subtitle {
      margin-top: 1.3rem;

      font-size:
        clamp(
          1.15rem,
          5.3vw,
          1.55rem
        );

      letter-spacing: 0.035em;
    }

    .landing-actions {
      margin-top: 3rem;

      flex-direction: column;

      gap: 0.3rem;
    }

    .landing-button {
      min-height: 48px;

      font-size: 0.68rem;

      gap: 0.75rem;
    }

    .action-divider {
      display: none;
    }

  }

  /* ============================================================
     VERY SMALL MOBILE
  ============================================================ */

  @media (max-width: 430px) {

    .landing-title {
      font-size:
        min(
          13.3vw,
          4rem
        );
    }

    .landing-actions {
      margin-top: 2.6rem;
    }

  }

  /* ============================================================
     REDUCED MOTION
  ============================================================ */

  @media (prefers-reduced-motion: reduce) {

    .landing-button,
    .landing-title,
    .action-index,
    .action-label::after,
    .action-arrow {
      transition: none !important;
    }

    .screen-noise {
      animation: none;
    }

  }

</style>